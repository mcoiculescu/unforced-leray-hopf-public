import UnforcedLeray.Cons.L2.CanonicalBranch.CanonicalNormalizedClock
import UnforcedLeray.Lib.SpecialFunctions.ComplexPowers

/-!
# Scalar gauge as the bounded turnover coefficient

On any finite block away from `R`, the scalar gauge ratio is the exponential integrating factor
for the actual bounded coefficient `-λ-βκ`, with `β(u)=(R-u)⁻¹`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set
open scoped InnerProductSpace

namespace UnforcedLeray.Cons.G3b

open UnforcedLeray.B0010 UnforcedLeray.Special

/-- The exact gauge ratio is the scalar exponential generated by `-λ-βκ` on a finite turnover
interval. -/
theorem gaugeRatio_eq_scalarExp_turnover {lam κ : ℂ} {R b₀ s t : ℝ}
    (hb₀ : 0 < b₀) (hs : 0 ≤ s) (hst : s ≤ t) (htt : t ≤ R - b₀) :
    gauge lam κ (R - t) * gaugeInv lam κ (R - s) =
      Complex.exp (-lam * (t - s) - κ * (∫ u in s..t, (R - u)⁻¹)) := by
  have hRt : 0 < R - t := by linarith [htt, hb₀]
  have hRs : 0 < R - s := by linarith [htt, hs, hb₀]
  have hlogs : (∫ u in s..t, (R - u)⁻¹) = Real.log (R - s) - Real.log (R - t) := by
    calc
      (∫ u in s..t, (R - u)⁻¹) = ∫ v in R - t..R - s, v⁻¹ := by
        rw [intervalIntegral.integral_comp_sub_left (fun v : ℝ => v⁻¹) R]
      _ = Real.log ((R - s) / (R - t)) := integral_inv_of_pos hRt hRs
      _ = Real.log (R - s) - Real.log (R - t) := by
        rw [Real.log_div hRs.ne' hRt.ne']
  unfold gauge gaugeInv
  rw [UnforcedLeray.Special.ofReal_cpow_eq_cexp hRt κ,
    UnforcedLeray.Special.ofReal_cpow_eq_cexp hRs (-κ)]
  rw [← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add]
  congr 1
  rw [hlogs]
  push_cast
  ring

end UnforcedLeray.Cons.G3b
