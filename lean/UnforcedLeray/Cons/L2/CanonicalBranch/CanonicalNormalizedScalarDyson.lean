import UnforcedLeray.Cons.L2.CanonicalBranch.CanonicalNormalizedClockClamp

/-!
# Scalar gauge as a bounded Dyson perturbation of the turnover diffusion clock

The exact scalar exponential multiplying `freeDiffusion` is the Dyson perturbation generated by
`-λ-βκ`, with the block coefficient extended by the proved global clamp.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set
open scoped InnerProductSpace

namespace UnforcedLeray.Cons.G3b

open UnforcedLeray.B0010 UnforcedLeray.B0123 UnforcedLeray.Evolution

/-- The scalar part of the turnover generator, using the globally bounded block coefficient. -/
def turnoverScalarPert (lam κ : ℂ) (R b₀ : ℝ) (hb₀ : 0 < b₀) (hR : b₀ ≤ R)
    (a b : ℝ) : BoundedPert XG a b := by
  let β : ℝ → ℝ := turnoverBlockBeta R b₀
  let I : XG →L[ℂ] XG := 1
  let ψ : ℝ → XG →L[ℂ] XG := fun t => (-lam - (β t : ℂ) * κ) • I
  have hβc : Continuous β := continuous_turnoverBlockBeta hb₀ hR
  have hβcomplex : Continuous (fun t : ℝ => (β t : ℂ)) :=
    Complex.continuous_ofReal.comp hβc
  have hcoefc : Continuous (fun t : ℝ => -lam - (β t : ℂ) * κ) :=
    continuous_const.sub (hβcomplex.mul continuous_const)
  have hψ : Continuous ψ := by
    dsimp [ψ, I]
    exact hcoefc.smul continuous_const
  refine ⟨ψ, ?_, ?_⟩
  · intro x
    exact (hψ.clm_apply continuous_const).aestronglyMeasurable
  · refine ⟨‖lam‖ + (1 / b₀) * ‖κ‖, fun t _ => ?_⟩
    have hβpos : 0 < β t := turnoverBlockBeta_pos hb₀ hR
    have hβle : β t ≤ 1 / b₀ := turnoverBlockBeta_le_inv hb₀ hR
    have hβ : ‖(β t : ℂ)‖ ≤ 1 / b₀ := by
      simpa [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβpos] using hβle
    have hcoef : ‖-lam - (β t : ℂ) * κ‖ ≤ ‖lam‖ + (1 / b₀) * ‖κ‖ := by
      calc
        ‖-lam - (β t : ℂ) * κ‖ ≤ ‖lam‖ + ‖(β t : ℂ) * κ‖ := by
          calc
            ‖-lam - (β t : ℂ) * κ‖ = ‖(-lam) + (-(β t : ℂ) * κ)‖ := by
              rw [sub_eq_add_neg]
              congr 1
              ring
            _ ≤ ‖-lam‖ + ‖-(β t : ℂ) * κ‖ := norm_add_le _ _
            _ = ‖lam‖ + ‖(β t : ℂ) * κ‖ := by simp
        _ = ‖lam‖ + ‖(β t : ℂ)‖ * ‖κ‖ := by rw [norm_mul]
        _ ≤ ‖lam‖ + (1 / b₀) * ‖κ‖ := by
          exact add_le_add le_rfl (mul_le_mul_of_nonneg_right hβ (norm_nonneg κ))
    calc
      ‖ψ t‖ = ‖-lam - (β t : ℂ) * κ‖ * ‖I‖ := norm_smul _ _
      _ ≤ (‖lam‖ + (1 / b₀) * ‖κ‖) * 1 := by
        calc
          ‖-lam - (β t : ℂ) * κ‖ * ‖I‖ ≤
              (‖lam‖ + (1 / b₀) * ‖κ‖) * ‖I‖ :=
                mul_le_mul_of_nonneg_right hcoef (norm_nonneg I)
          _ ≤ (‖lam‖ + (1 / b₀) * ‖κ‖) * 1 := by
                gcongr
                exact ContinuousLinearMap.norm_id_le
      _ = _ := by simp

/-- FTC for the scalar gauge ratio on an active finite turnover block. -/
theorem turnoverScalarGauge_integral {lam κ : ℂ} {R b₀ s t : ℝ}
    (hb₀ : 0 < b₀) (hR : b₀ ≤ R) (hs : 0 ≤ s) (hst : s ≤ t)
    (htt : t ≤ R - b₀) :
    (∫ r in s..t,
      (-lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) *
        (gauge lam κ (R - r) * gaugeInv lam κ (R - s))) =
      gauge lam κ (R - t) * gaugeInv lam κ (R - s) - 1 := by
  have hder : ∀ r ∈ uIcc s t,
      HasDerivAt (fun u : ℝ => gauge lam κ (R - u) * gaugeInv lam κ (R - s))
        ((-lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) *
          (gauge lam κ (R - r) * gaugeInv lam κ (R - s))) r := by
    intro r hr
    have hrs : s ≤ r := by
      rw [uIcc_of_le hst] at hr
      exact hr.1
    have hrt : r ≤ t := by
      rw [uIcc_of_le hst] at hr
      exact hr.2
    have hr0 : 0 ≤ r := hs.trans hrs
    have hrb : r ≤ R - b₀ := hrt.trans htt
    have hθ : 0 < R - r := by linarith [hb₀, hrb]
    have hbase := (gauge_hasDerivAt_log (lam := lam) (κ := κ) hθ).scomp r
      ((hasDerivAt_id' r).const_sub R)
    have hprod := hbase.mul_const (gaugeInv lam κ (R - s))
    have hβ := turnoverBlockBeta_eq_reciprocal hR hr0 hrb
    have hcoef :
        ((-1 : ℝ) • ((lam + κ / ((R - r : ℝ) : ℂ)) * gauge lam κ (R - r))) *
            gaugeInv lam κ (R - s) =
          (-lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) *
            (gauge lam κ (R - r) * gaugeInv lam κ (R - s)) := by
      rw [hβ]
      push_cast
      rw [Complex.real_smul]
      field_simp [Complex.ofReal_ne_zero.mpr hθ.ne']
      push_cast
      ring
    have hprod' := hprod.congr_deriv hcoef
    simpa only [Function.comp_def] using hprod'
  have hc : ContinuousOn
      (fun r : ℝ => (-lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) *
        (gauge lam κ (R - r) * gaugeInv lam κ (R - s))) (uIcc s t) := by
    have hβc : Continuous (turnoverBlockBeta R b₀) := continuous_turnoverBlockBeta hb₀ hR
    have hθc : Continuous (fun r : ℝ => R - r) := continuous_const.sub continuous_id
    have hgc : ContinuousOn (fun r : ℝ => gauge lam κ (R - r)) (uIcc s t) := by
      apply (continuousOn_gauge lam κ).comp hθc.continuousOn
      intro r hr
      rw [uIcc_of_le hst] at hr
      exact mem_Ioi.mpr (by linarith [hr.1, hr.2, htt, hb₀])
    have hconst : ContinuousOn (fun _ : ℝ => gaugeInv lam κ (R - s)) (uIcc s t) := continuousOn_const
    have hcoefc : Continuous (fun r : ℝ => -lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) := by
      fun_prop
    exact hcoefc.continuousOn.mul (hgc.mul hconst)
  have hc' : ContinuousOn
      (fun r : ℝ => (-lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) *
        (gauge lam κ (R - r) * gaugeInv lam κ (R - s))) (Icc s t) := by
    simpa [uIcc_of_le hst] using hc
  have hInt := hc'.intervalIntegrable_of_Icc (μ := volume) hst
  have hFTC :
      (∫ r in s..t, (-lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) *
        (gauge lam κ (R - r) * gaugeInv lam κ (R - s))) =
        gauge lam κ (R - t) * gaugeInv lam κ (R - s) -
          gauge lam κ (R - s) * gaugeInv lam κ (R - s) := by
    exact intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun u : ℝ => gauge lam κ (R - u) * gaugeInv lam κ (R - s))
      (f' := fun r => (-lam - ((turnoverBlockBeta R b₀ r : ℝ) : ℂ) * κ) *
        (gauge lam κ (R - r) * gaugeInv lam κ (R - s))) hder hInt
  have hsval : gauge lam κ (R - s) * gaugeInv lam κ (R - s) = 1 := by
    exact gauge_mul_gaugeInv (lam := lam) (κ := κ) (by linarith [htt, hs, hst, hb₀])
  rw [hFTC, hsval]

end UnforcedLeray.Cons.G3b
