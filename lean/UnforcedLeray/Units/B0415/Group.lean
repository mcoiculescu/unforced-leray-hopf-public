import UnforcedLeray.Units.B0415.Action

/-!
# Unit B0415, helper: the group `𝒪` is generated by the rotations about `e₃` and one
meridional reflection; continuity of the rotation action

Blueprint unit `B0415` (`eq:free-stress-2`, `paper/main.tex` lines 7346–7362), proof outline:
"`𝒪 ≅ O(2)` is generated by rotations about `e₃` together with one meridional reflection".

* `fixesAxis_cases`: every linear isometry `g` of `ℝ³` with `g e₃ = e₃` is a rotation `R_θ`
  about the axis or `R_θ ∘ σ` with `σ = Axi.reflY` the reflection in the plane `{y₁ = 0}`;
* `continuous_actLp_rotZ`: for `q < ∞` and `F ∈ L^q(ℝ³;ℂ³)`, `θ ↦ R_θ·F` is continuous into
  `L^q` (Mathlib's `Continuous.compMeasurePreservingLp`);
* `actLp_rotZ_of_rat`: invariance under the rational-angle rotations implies invariance under
  every rotation (density of `ℚ` in `ℝ`);
* `actLp_of_generators`: a field of `L^q`, `q < ∞`, fixed by the rational rotations and by `σ`
  is fixed by every `g ∈ 𝒪`, i.e. axisymmetric without swirl (`isAxiNoSwirlC_iff_actLp`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology

namespace UnforcedLeray.B0415

open UnforcedLeray.PhaseSpace (CVec3 Yq)
open UnforcedLeray.RieszLp (reV imV ofReV ofImV)
open UnforcedLeray.Axi (rotZ reflY rotFun reflFun fixesAxis_rotZ fixesAxis_reflY)

/-! ### Classification of `𝒪` -/

theorem inner_coord_coord (i j : Fin 3) :
    inner ℝ (coordinateVector i) (coordinateVector j) = if i = j then (1 : ℝ) else 0 := by
  rw [Blueprint.L12.inner_coord_left]
  simp only [coordinateVector, PiLp.single_apply]

theorem ext_of_coord {g h : Space ≃ₗᵢ[ℝ] Space}
    (h0 : g (coordinateVector 0) = h (coordinateVector 0))
    (h1 : g (coordinateVector 1) = h (coordinateVector 1))
    (h2 : g (coordinateVector 2) = h (coordinateVector 2)) : g = h := by
  refine LinearIsometryEquiv.ext fun w => ?_
  rw [Blueprint.L12.map_eq_sum g w, Blueprint.L12.map_eq_sum h w, Fin.sum_univ_three,
    Fin.sum_univ_three, h0, h1, h2]

/-- **`𝒪` is generated by the rotations about `e₃` and one meridional reflection.** Every
linear isometry of `ℝ³` fixing `e₃` is `R_θ` or `R_θ ∘ σ` for some angle `θ`, with `σ` the
reflection in the plane `{y₁ = 0}` (`Axi.reflY`). -/
theorem fixesAxis_cases {g : Space ≃ₗᵢ[ℝ] Space} (hg : FixesAxis g) :
    ∃ θ : ℝ, g = rotZ θ ∨ g = reflY.trans (rotZ θ) := by
  have hin : ∀ i j : Fin 3, inner ℝ (g (coordinateVector i)) (g (coordinateVector j)) =
      if i = j then (1 : ℝ) else 0 := fun i j => by
    rw [g.inner_map_map, inner_coord_coord]
  have hsq : ∀ v : Space, inner ℝ v v = v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 := by
    intro v
    rw [Blueprint.L12.inner_eq_sum, Fin.sum_univ_three]
    ring
  have hdot : ∀ v w : Space, inner ℝ v w = v 0 * w 0 + v 1 * w 1 + v 2 * w 2 := by
    intro v w
    rw [Blueprint.L12.inner_eq_sum, Fin.sum_univ_three]
  have ha2 : g (coordinateVector 0) 2 = 0 := by
    rw [← Blueprint.L12.inner_coord_left 2, ← hg, hin]
    simp
  have hb2 : g (coordinateVector 1) 2 = 0 := by
    rw [← Blueprint.L12.inner_coord_left 2, ← hg, hin]
    simp
  have ha : g (coordinateVector 0) 0 ^ 2 + g (coordinateVector 0) 1 ^ 2 = 1 := by
    have := hin 0 0
    rw [hsq, ha2] at this
    simpa using this
  have hb : g (coordinateVector 1) 0 ^ 2 + g (coordinateVector 1) 1 ^ 2 = 1 := by
    have := hin 1 1
    rw [hsq, hb2] at this
    simpa using this
  have hab : g (coordinateVector 0) 0 * g (coordinateVector 1) 0 +
      g (coordinateVector 0) 1 * g (coordinateVector 1) 1 = 0 := by
    have := hin 0 1
    rw [hdot, ha2] at this
    simpa using this
  -- the angle of `g e₀`
  obtain ⟨θ, hcos, hsin⟩ : ∃ θ : ℝ, Real.cos θ = g (coordinateVector 0) 0 ∧
      Real.sin θ = g (coordinateVector 0) 1 := by
    set z : ℂ := ⟨g (coordinateVector 0) 0, g (coordinateVector 0) 1⟩ with hz
    have hzn : ‖z‖ = 1 := by
      rw [Complex.norm_def, Complex.normSq_mk]
      have : g (coordinateVector 0) 0 * g (coordinateVector 0) 0 +
          g (coordinateVector 0) 1 * g (coordinateVector 0) 1 = 1 := by nlinarith
      rw [this, Real.sqrt_one]
    refine ⟨Complex.arg z, ?_, ?_⟩
    · have h := Complex.norm_mul_cos_arg z
      rw [hzn, one_mul] at h
      exact h
    · have h := Complex.norm_mul_sin_arg z
      rw [hzn, one_mul] at h
      exact h
  have hs2 : (g (coordinateVector 0) 0 * g (coordinateVector 1) 1 -
      g (coordinateVector 0) 1 * g (coordinateVector 1) 0) *
      (g (coordinateVector 0) 0 * g (coordinateVector 1) 1 -
      g (coordinateVector 0) 1 * g (coordinateVector 1) 0) = 1 := by
    linear_combination (g (coordinateVector 1) 0 ^ 2 + g (coordinateVector 1) 1 ^ 2) * ha + hb -
      (g (coordinateVector 0) 0 * g (coordinateVector 1) 0 +
        g (coordinateVector 0) 1 * g (coordinateVector 1) 1) * hab
  have hb0 : g (coordinateVector 1) 0 = -g (coordinateVector 0) 1 *
      (g (coordinateVector 0) 0 * g (coordinateVector 1) 1 -
      g (coordinateVector 0) 1 * g (coordinateVector 1) 0) := by
    linear_combination g (coordinateVector 0) 0 * hab - g (coordinateVector 1) 0 * ha
  have hb1 : g (coordinateVector 1) 1 = g (coordinateVector 0) 0 *
      (g (coordinateVector 0) 0 * g (coordinateVector 1) 1 -
      g (coordinateVector 0) 1 * g (coordinateVector 1) 0) := by
    linear_combination g (coordinateVector 0) 1 * hab - g (coordinateVector 1) 1 * ha
  generalize hs : g (coordinateVector 0) 0 * g (coordinateVector 1) 1 -
      g (coordinateVector 0) 1 * g (coordinateVector 1) 0 = s at hs2 hb0 hb1
  simp only [← hcos, ← hsin] at hb0 hb1
  refine ⟨θ, ?_⟩
  have hga : g (coordinateVector 0) = rotZ θ (coordinateVector 0) := by
    generalize g (coordinateVector 0) = a at ha2 hcos hsin ⊢
    ext i
    fin_cases i <;> simp [rotFun, coordinateVector, ← hcos, ← hsin, ha2]
  have hg2 : ∀ φ : ℝ, g (coordinateVector 2) = rotZ φ (coordinateVector 2) := by
    intro φ
    rw [hg]
    ext i
    fin_cases i <;> simp [rotFun, coordinateVector]
  rcases mul_self_eq_one_iff.mp hs2 with h1 | h1
  · left
    refine ext_of_coord hga ?_ (hg2 _)
    generalize g (coordinateVector 1) = b at hb0 hb1 hb2 ⊢
    ext i
    fin_cases i <;> simp [rotFun, coordinateVector, hb0, hb1, hb2, h1]
  · right
    refine ext_of_coord ?_ ?_ ?_
    · rw [hga]
      simp only [LinearIsometryEquiv.trans_apply]
      congr 1
      ext i
      fin_cases i <;> simp [reflFun, coordinateVector]
    · simp only [LinearIsometryEquiv.trans_apply]
      generalize g (coordinateVector 1) = b at hb0 hb1 hb2 ⊢
      ext i
      fin_cases i <;> simp [rotFun, reflFun, coordinateVector, hb0, hb1, hb2, h1]
    · rw [hg]
      simp only [LinearIsometryEquiv.trans_apply]
      ext i
      fin_cases i <;> simp [rotFun, reflFun, coordinateVector]

/-! ### Continuity of the rotation action on `L^q` -/

theorem continuous_actV_rotZ : Continuous fun θ : ℝ => actV (rotZ θ) := by
  rw [continuous_clm_apply]
  intro z
  have h : (fun θ : ℝ => actV (rotZ θ) z) =
      fun θ => ofReV (rotFun θ (reV z)) + ofImV (rotFun θ (imV z)) := rfl
  rw [h]
  have hr : Continuous fun θ : ℝ => rotFun θ (reV z) := by
    unfold rotFun
    fun_prop
  have hi : Continuous fun θ : ℝ => rotFun θ (imV z) := by
    unfold rotFun
    fun_prop
  exact (ofReV.continuous.comp hr).add (ofImV.continuous.comp hi)

variable {q : ℝ≥0∞} [Fact (1 ≤ q)]

/-- The rotation family as continuous maps, `θ ↦ R_θ⁻¹ = R_{-θ}`. -/
def rotInvC : C(ℝ, C(Space, Space)) :=
  ContinuousMap.curry ⟨fun p : ℝ × Space => rotFun (-p.1) p.2, by
    unfold rotFun
    fun_prop⟩

theorem rotInvC_apply (θ : ℝ) (y : Space) : rotInvC θ y = (rotZ θ).symm y := rfl

/-- **Continuity of the rotation action.** For `q < ∞` and `F ∈ L^q(ℝ³;ℂ³)`, the orbit
`θ ↦ R_θ·F` is continuous into `L^q`. -/
theorem continuous_actLp_rotZ (hq : q ≠ ⊤) (F : Lp CVec3 q (volume : Measure Space)) :
    Continuous fun θ : ℝ => actLp q (rotZ θ) F := by
  have hmp : ∀ θ : ℝ, MeasurePreserving (rotInvC θ) volume volume :=
    fun θ => (rotZ θ).symm.measurePreserving
  have h1 : Continuous fun θ : ℝ => Lp.compMeasurePreserving (rotInvC θ) (hmp θ) F :=
    Continuous.compMeasurePreservingLp (f := fun _ => F) continuous_const rotInvC.continuous
      hmp hq
  have h2 : Continuous fun θ : ℝ =>
      ContinuousLinearMap.compLpL₂ q (volume : Measure Space)
        (ContinuousLinearMap.id ℂ (CVec3 →L[ℂ] CVec3)) (actV (rotZ θ)) :=
    (ContinuousLinearMap.compLpL₂ q (volume : Measure Space)
      (ContinuousLinearMap.id ℂ (CVec3 →L[ℂ] CVec3))).continuous.comp continuous_actV_rotZ
  exact h2.clm_apply h1

/-- Invariance under the rational-angle rotations implies invariance under every rotation
about `e₃` (`q < ∞`). -/
theorem actLp_rotZ_of_rat (hq : q ≠ ⊤) {F : Lp CVec3 q (volume : Measure Space)}
    (h : ∀ r : ℚ, actLp q (rotZ r) F = F) (θ : ℝ) : actLp q (rotZ θ) F = F := by
  have hc : IsClosed {θ : ℝ | actLp q (rotZ θ) F = F} :=
    isClosed_eq (continuous_actLp_rotZ hq F) continuous_const
  have hsub : closure (range ((↑) : ℚ → ℝ)) ⊆ {θ : ℝ | actLp q (rotZ θ) F = F} :=
    hc.closure_subset_iff.2 (by rintro _ ⟨r, rfl⟩; exact h r)
  exact hsub (Rat.denseRange_cast θ)

/-- **Generators.** A field of `L^q(ℝ³;ℂ³)`, `q < ∞`, fixed by the rational rotations about
`e₃` and by the meridional reflection `σ` is fixed by every `g ∈ 𝒪`. -/
theorem actLp_of_generators (hq : q ≠ ⊤) {F : Lp CVec3 q (volume : Measure Space)}
    (hrot : ∀ r : ℚ, actLp q (rotZ r) F = F) (hJ : actLp q reflY F = F)
    {g : Space ≃ₗᵢ[ℝ] Space} (hg : FixesAxis g) : actLp q g F = F := by
  obtain ⟨θ, rfl | rfl⟩ := fixesAxis_cases hg
  · exact actLp_rotZ_of_rat hq hrot θ
  · rw [actLp_trans, hJ]
    exact actLp_rotZ_of_rat hq hrot θ

end UnforcedLeray.B0415
