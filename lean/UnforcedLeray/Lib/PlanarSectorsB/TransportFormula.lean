import UnforcedLeray.Lib.PlanarSectorsB.TransportDuhamel

/-!
# The transport group is the differential rotation `f(r, ϑ - Ω(r)t)` (INF12 P7)


§5, Level P, target **P7** (the transport group of the mild form).

Manuscript (`paper/main.tex` lines 1228–1245, units `B0062`–`B0064`): the transport group
`T(t)f(r,ϑ) = f(r, ϑ - Ω(r)t)` generated by `-Ω∂_ϑ`. On the sector `w(r)e^{inϑ}` this is the
multiplication by `e^{-inΩ(r)t}`. This module proves that the abstract exponential
`transportExpSec M t n = exp(t(-inΩ))` (`TransportDuhamel.lean`) is that multiplication
(`coeFn_transportExpSec`), and that `transportGroupW` rotates each sector function by the
radius-dependent angle `-Ω(r)t` (`coeFn_transportGroupW_secEmb`).

Main declarations (namespace `UnforcedLeray.Planar`):
* `expOmega z t r = e^{tzΩ(r)}`, `expOmegaOp M z t` (multiplication on `ProfL2 M`),
  `hasDerivAt_expOmegaOp` (`∂ₜ(e^{tzΩ}w) = zΩ e^{tzΩ}w` in `ProfL2 M`);
* `exp_smul_omegaP_apply`: `exp(t·zΩ) = e^{tzΩ}` for every real `t` (uniqueness for the linear
  equation `u' = zΩu`, Duhamel with zero forcing);
* `coeFn_transportExpSec`: `exp(t(-inΩ))w = e^{-inΩ(r)t} w(r)` a.e.;
* `coeFn_transportGroupW_secEmb`: `T(t)(w(r)e^{inϑ})(y) = (w e^{inϑ})(rot_{-Ω(|y|)t} y)` a.e.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set Filter Topology Real Asymptotics
open scoped ENNReal InnerProductSpace ComplexConjugate

namespace UnforcedLeray.Planar

open UnforcedLeray.GaussianVortex (radialOmega radialOmega_pos)
open UnforcedLeray.Planar.NUE

/-- The multiplier `e^{tzΩ(r)}`. -/
def expOmega (z : ℂ) (t : ℝ) (r : ℝ) : ℂ := Complex.exp ((t : ℂ) * z * (radialOmega r : ℂ))

theorem continuous_expOmega (z : ℂ) (t : ℝ) : Continuous (expOmega z t) :=
  Complex.continuous_exp.comp
    (continuous_const.mul (Complex.continuous_ofReal.comp B0012.continuous_radialOmega))

theorem norm_omega_le_one (r : ℝ) : ‖(radialOmega r : ℂ)‖ ≤ 1 := by
  rw [Complex.norm_real, Real.norm_of_nonneg (radialOmega_pos r).le]
  exact B0012.radialOmega_le_one r

theorem norm_expOmega_le (z : ℂ) (t r : ℝ) : ‖expOmega z t r‖ ≤ Real.exp (|t| * ‖z‖) := by
  rw [expOmega, Complex.norm_exp]
  apply Real.exp_le_exp.2
  calc ((t : ℂ) * z * (radialOmega r : ℂ)).re ≤ ‖(t : ℂ) * z * (radialOmega r : ℂ)‖ :=
        Complex.re_le_norm _
    _ = |t| * ‖z‖ * ‖(radialOmega r : ℂ)‖ := by
        rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    _ ≤ |t| * ‖z‖ * 1 := by
        gcongr
        exact norm_omega_le_one r
    _ = |t| * ‖z‖ := mul_one _

/-- Multiplication by `e^{tzΩ(r)}` on `ProfL2 M`. -/
def expOmegaOp (M : ℝ) (z : ℂ) (t : ℝ) : ProfL2 M →L[ℂ] ProfL2 M :=
  Infra.Mult.mulOp (expOmega z t) (continuous_expOmega z t).aestronglyMeasurable
    (Eventually.of_forall (norm_expOmega_le z t))

theorem coeFn_expOmegaOp (M : ℝ) (z : ℂ) (t : ℝ) (w : ProfL2 M) :
    ⇑(expOmegaOp M z t w) =ᵐ[profileMeasure M] fun r => expOmega z t r * w r := by
  filter_upwards [Infra.Mult.coeFn_mulOp (continuous_expOmega z t).aestronglyMeasurable
    (Eventually.of_forall (norm_expOmega_le z t)) w] with r hr
  exact hr.trans (smul_eq_mul _ _)

theorem expOmegaOp_zero (M : ℝ) (z : ℂ) : expOmegaOp M z 0 = 1 :=
  Infra.Mult.mulOp_eq_one _ _ (Eventually.of_forall fun r => by simp [expOmega])

/-- The pointwise remainder `e^{(t+h)c} - e^{tc} - hc e^{tc}` for `c = zΩ(r)`. -/
theorem norm_expOmega_remainder_le (z : ℂ) (t h r : ℝ) (hh : |h| * ‖z‖ ≤ 1) :
    ‖expOmega z (t + h) r - expOmega z t r -
        (h : ℂ) * (z * ((radialOmega r : ℂ) * expOmega z t r))‖ ≤
      Real.exp (|t| * ‖z‖) * (|h| * ‖z‖) ^ 2 := by
  set c : ℂ := z * (radialOmega r : ℂ)
  have hc : ‖c‖ ≤ ‖z‖ := by
    rw [norm_mul]
    calc ‖z‖ * ‖(radialOmega r : ℂ)‖ ≤ ‖z‖ * 1 := by gcongr; exact norm_omega_le_one r
      _ = ‖z‖ := mul_one _
  have hx : ‖(h : ℂ) * c‖ ≤ |h| * ‖z‖ := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    gcongr
  have e : expOmega z (t + h) r - expOmega z t r -
      (h : ℂ) * (z * ((radialOmega r : ℂ) * expOmega z t r)) =
      expOmega z t r * (Complex.exp ((h : ℂ) * c) - 1 - (h : ℂ) * c) := by
    simp only [expOmega, c]
    rw [show ((t + h : ℝ) : ℂ) * z * (radialOmega r : ℂ) =
        (t : ℂ) * z * (radialOmega r : ℂ) + (h : ℂ) * (z * (radialOmega r : ℂ)) by
      push_cast; ring, Complex.exp_add]
    ring
  rw [e, norm_mul]
  have h1 := Complex.norm_exp_sub_one_sub_id_le (hx.trans hh)
  calc ‖expOmega z t r‖ * ‖Complex.exp ((h : ℂ) * c) - 1 - (h : ℂ) * c‖
      ≤ Real.exp (|t| * ‖z‖) * ‖(h : ℂ) * c‖ ^ 2 :=
        mul_le_mul (norm_expOmega_le z t r) h1 (norm_nonneg _) (Real.exp_pos _).le
    _ ≤ Real.exp (|t| * ‖z‖) * (|h| * ‖z‖) ^ 2 := by
        gcongr

/-- The second-order remainder of `s ↦ e^{szΩ}w` in `ProfL2 M`:
`‖e^{(t+h)zΩ}w - e^{tzΩ}w - h zΩ e^{tzΩ}w‖ ≤ K h²` for `|h|‖z‖ ≤ 1`. -/
theorem norm_expOmegaOp_remainder_le (M : ℝ) (z : ℂ) (t : ℝ) (w : ProfL2 M) (h : ℝ)
    (hh : |h| * ‖z‖ ≤ 1) :
    ‖expOmegaOp M z (t + h) w - expOmegaOp M z t w -
        (h : ℂ) • (z • omegaP M) (expOmegaOp M z t w)‖ ≤
      (Real.exp (|t| * ‖z‖) * ‖z‖ ^ 2 * ‖w‖) * h ^ 2 := by
  have hle : ‖expOmegaOp M z (t + h) w - expOmegaOp M z t w -
      (h : ℂ) • (z • omegaP M) (expOmegaOp M z t w)‖ ≤
      (Real.exp (|t| * ‖z‖) * (|h| * ‖z‖) ^ 2) * ‖w‖ := by
    apply Lp.norm_le_mul_norm_of_ae_le_mul
    have e1 : (z • omegaP M) (expOmegaOp M z t w) = z • omegaP M (expOmegaOp M z t w) := rfl
    rw [e1]
    filter_upwards [Lp.coeFn_sub (expOmegaOp M z (t + h) w - expOmegaOp M z t w)
        ((h : ℂ) • z • omegaP M (expOmegaOp M z t w)),
      Lp.coeFn_sub (expOmegaOp M z (t + h) w) (expOmegaOp M z t w),
      Lp.coeFn_smul (h : ℂ) (z • omegaP M (expOmegaOp M z t w)),
      Lp.coeFn_smul z (omegaP M (expOmegaOp M z t w)),
      coeFn_omegaP M (expOmegaOp M z t w), coeFn_expOmegaOp M z (t + h) w,
      coeFn_expOmegaOp M z t w] with r h1 h2 h3 h4 h5 h6 h7
    rw [h1, Pi.sub_apply, h2, Pi.sub_apply, h3, Pi.smul_apply, h4, Pi.smul_apply, h5, h6, h7,
      smul_eq_mul, smul_eq_mul]
    have e2 : expOmega z (t + h) r * w r - expOmega z t r * w r -
        (h : ℂ) * (z * ((radialOmega r : ℂ) * (expOmega z t r * w r))) =
        (expOmega z (t + h) r - expOmega z t r -
          (h : ℂ) * (z * ((radialOmega r : ℂ) * expOmega z t r))) * w r := by ring
    rw [e2, norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_expOmega_remainder_le z t h r hh) (norm_nonneg _)
  refine hle.trans (le_of_eq ?_)
  rw [mul_pow, sq_abs]
  ring

/-- **`exp(t·zΩ) = e^{tzΩ}` for `t ≥ 0`** (variation of constants with zero forcing: the
multiplication semigroup solves `u' = zΩu`, `norm_expOmegaOp_remainder_le`). -/
theorem exp_smul_omegaP_apply_of_nonneg (M : ℝ) (z : ℂ) {t : ℝ} (ht : 0 ≤ t) (w : ProfL2 M) :
    NormedSpace.exp ((t : ℂ) • (z • omegaP M)) w = expOmegaOp M z t w := by
  have h := Infra.BanachExp.eq_duhamel_of_hasDerivWithinAt (z • omegaP M)
    (u := fun s => expOmegaOp M z s w) (g := fun _ => 0) (T := t) continuousOn_const ?_
    t ⟨ht, le_rfl⟩
  · simp only [map_zero, intervalIntegral.integral_zero, add_zero] at h
    rw [h, expOmegaOp_zero, ContinuousLinearMap.one_apply]
  intro s _
  refine HasDerivAt.hasDerivWithinAt ?_
  rw [hasDerivAt_iff_isLittleO_nhds_zero]
  set K : ℝ := Real.exp (|s| * ‖z‖) * ‖z‖ ^ 2 * ‖w‖ with hK
  have hK0 : 0 ≤ K := by positivity
  refine IsLittleO.of_bound fun ε hε => ?_
  have hδ : 0 < min (1 / (‖z‖ + 1)) (ε / (K + 1)) := by positivity
  filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hδ] with h hh
  rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hh
  have hh1 : |h| * ‖z‖ ≤ 1 := by
    have h2 : |h| < 1 / (‖z‖ + 1) := hh.trans_le (min_le_left _ _)
    have h3 : |h| * (‖z‖ + 1) < 1 := by
      rwa [lt_div_iff₀ (by positivity)] at h2
    nlinarith [abs_nonneg h]
  have hh2 : |h| * (K + 1) ≤ ε := by
    have h2 : |h| < ε / (K + 1) := hh.trans_le (min_le_right _ _)
    rw [lt_div_iff₀ (by positivity)] at h2
    exact h2.le
  have hb := norm_expOmegaOp_remainder_le M z s w h hh1
  rw [← hK] at hb
  refine le_trans (le_of_eq ?_) (hb.trans ?_)
  · simp only [add_zero]
    rfl
  rw [Real.norm_eq_abs, ← sq_abs]
  have h4 : K * |h| ≤ ε := by nlinarith [abs_nonneg h]
  calc K * |h| ^ 2 = (K * |h|) * |h| := by ring
    _ ≤ ε * |h| := mul_le_mul_of_nonneg_right h4 (abs_nonneg h)

/-- **`exp(t·zΩ) = e^{tzΩ}` for every real `t`**. -/
theorem exp_smul_omegaP_apply (M : ℝ) (z : ℂ) (t : ℝ) (w : ProfL2 M) :
    NormedSpace.exp ((t : ℂ) • (z • omegaP M)) w = expOmegaOp M z t w := by
  rcases le_total 0 t with ht | ht
  · exact exp_smul_omegaP_apply_of_nonneg M z ht w
  · have e : ((-t : ℝ) : ℂ) • ((-z) • omegaP M) = (t : ℂ) • (z • omegaP M) := by
      rw [Complex.ofReal_neg, neg_smul, neg_smul, smul_neg, neg_neg]
    have e2 : expOmegaOp M (-z) (-t) w = expOmegaOp M z t w := by
      apply Lp.ext
      filter_upwards [coeFn_expOmegaOp M (-z) (-t) w, coeFn_expOmegaOp M z t w] with r h1 h2
      rw [h1, h2]
      simp only [expOmega]
      push_cast
      ring_nf
    rw [← e, exp_smul_omegaP_apply_of_nonneg M (-z) (neg_nonneg.2 ht) w, e2]

/-- **The sector transport is the multiplication by `e^{-inΩ(r)t}`** (`paper/main.tex` lines
1228–1245: `T(t)f(r,ϑ) = f(r, ϑ - Ω(r)t)` on `w(r)e^{inϑ}`). -/
theorem coeFn_transportExpSec (M t : ℝ) (n : ℤ) (w : ProfL2 M) :
    ⇑(transportExpSec M t n w) =ᵐ[profileMeasure M] fun r =>
      Complex.exp (-(Complex.I * n * (radialOmega r : ℂ) * t)) * w r := by
  have e : transportExpSec M t n w = expOmegaOp M (-(Complex.I * n)) t w :=
    exp_smul_omegaP_apply M _ t w
  rw [e]
  filter_upwards [coeFn_expOmegaOp M (-(Complex.I * n)) t w] with r hr
  rw [hr, expOmega]
  congr 2
  ring

/-- **The transport group rotates by `-Ω(|y|)t`**: for a sector function `w(r)e^{inϑ}`,
`T(t)(w e^{inϑ})(y) = (w e^{inϑ})(e^{-iΩ(|y|)t} y)` almost everywhere. -/
theorem coeFn_transportGroupW_secEmb (M t : ℝ) (n : ℤ) (w : ProfL2 M) :
    ⇑(transportGroupW M t (secEmb M n w)) =ᵐ[wMeasure M] fun y =>
      Ang.ofProfile n w (rot (-(radialOmega ‖y‖ * t)) y) := by
  have e : transportGroupW M t (secEmb M n w) = secEmb M n (transportExpSec M t n w) := by
    apply eq_of_secProf
    intro m
    rw [secProf_transportGroupW, secProf_secEmb, secProf_secEmb]
    split_ifs with h
    · subst h
      rfl
    · exact map_zero _
  rw [e]
  filter_upwards [coeFn_secEmb M n (transportExpSec M t n w),
    ofProfile_congr_ae' M n (coeFn_transportExpSec M t n w)] with y h1 h2
  rw [h1, h2]
  simp only [Ang.ofProfile]
  rw [Polar.norm_rot, angPhase_rot]
  push_cast
  ring_nf

end UnforcedLeray.Planar
