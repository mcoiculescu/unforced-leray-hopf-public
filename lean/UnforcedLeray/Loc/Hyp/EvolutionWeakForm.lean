import UnforcedLeray.Loc.Hyp.EvolutionWeakForm.Adjoint
import UnforcedLeray.Loc.L14Realization.TestCalculus

/-!
# H-EvolWeak: mild solutions of the evolution of L3 are weak solutions

Proves the named hypothesis `UnforcedLeray.Blueprint.L13.EvolutionWeakForm`

`paper/main.tex` lines 292–306 (the free evolution `S₀` generated by `𝓛₀ = hΔ + ½y·∇ + ½`,
line 293; the evolution `E(τ,s)` of `∂_τ - 𝓛_*`, `𝓛_* = 𝓛₀ + 𝓑_*`, with its Duhamel formula,
line 299) and 406–417 (mild solutions `z(τ) = E(τ,s)z(s) + ∫_s^τ E(τ,r)F(r) dr` of the Green
problem). Blueprint units B0712, B0713, B1018, B1019; infrastructure INF07, INF08, INF14.

**Statement** (`evolutionWeakForm`): if `z : ℝ → Z` and `F : ℝ → X` are continuous on
`(-∞, τ₀]` and `z(τ) = E(τ,s)z(s) + ∫_s^τ E(τ,r)F(r) dr` for `s ≤ τ ≤ τ₀`, then for every
vector test `φ` and every `τ < τ₀`,
`d/dτ ⟨z(τ), φ⟩ = ⟨hΔz(τ) + 𝓑_*(τ)z(τ) + F(τ), φ⟩ - ⟨z(τ), φ⟩ - ½⟨z(τ), y·∇φ⟩`.

## Proof

No Fubini argument is needed: the mild formula is used between the two endpoints of each
difference quotient only. For `s < t` near `τ` (so `t ≤ τ₀`), the mild formula on `[s, t]`, the
Duhamel formula for `E(t,s)` (line 299) and the adjoint identity
`⟨S₀(u)f, φ⟩ = ⟨f, S₀(u)^*φ⟩` (`Adjoint.lean`) give (`pairing_decomp`)

  `⟨z(t),φ⟩ - ⟨z(s),φ⟩ = ⟨z(s), S₀(t-s)^*φ - φ⟩`
      `+ ∫_s^t ⟨𝓑_*(r)E(r,s)z(s), S₀(t-r)^*φ⟩ dr + ∫_s^t ⟨E(t,r)F(r), φ⟩ dr`.

Divided by `t - s`, the first term tends to `⟨z(τ), 𝓛₀^*φ⟩` by the adjoint generator on tests
(`tendsto_adjTest_slope`) and the continuity of `z`; the two averages tend to
`⟨𝓑_*(τ)z(τ), φ⟩` and `⟨F(τ), φ⟩`, since their integrands converge uniformly in `r ∈ (s,t)`
(joint strong continuity of `E`, its strip bound, `E(τ,τ) = I`, the continuity of `𝓑_*`, `z`,
`F` and `S₀(u)^*φ → φ`). Convergence of the difference quotients along all pairs `s < t`
tending to `(τ, τ)` is two-sided differentiability (`hasDerivAt_of_tendsto_pair`). Finally
`⟨z, 𝓛₀^*φ⟩ = ⟨hΔz, φ⟩ - ⟨z, φ⟩ - ½⟨z, y·∇φ⟩` by `L14.inner_laplace_toL2`.

The hypotheses are exactly those of the named hypothesis (no strengthening); `h > 0` comes from
the package (`IsExactBackground.h_pos`, line 151). The integrals are genuine Bochner integrals:
the integrability of both integrands is a hypothesis of the statement (mild formula) or a clause
of `IsEvolution` (`duhamel_integrable`).
-/

set_option autoImplicit false

noncomputable section

open Set MeasureTheory Filter
open scoped ENNReal ContDiff Topology

namespace UnforcedLeray.Blueprint.EvolWeak

open SobolevGraph
open UnforcedLeray.Blueprint.L13 (radialDeriv XclassCLM LclassCLM)

/-! ## Calculus on pairs `s < t` -/

/-- If the difference quotients `(f t - f s)/(t - s)` converge to `L` along all pairs `s < t`
tending to `(τ, τ)`, then `f'(τ) = L` (two-sided). -/
theorem hasDerivAt_of_tendsto_pair {f : ℝ → ℝ} {τ L : ℝ}
    (h : Tendsto (fun p : ℝ × ℝ => (p.2 - p.1)⁻¹ * (f p.2 - f p.1))
      (𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ)) (𝓝 L)) : HasDerivAt f L τ := by
  rw [hasDerivAt_iff_tendsto_slope]
  have hm : Tendsto (fun σ : ℝ => (min σ τ, max σ τ)) (𝓝[≠] τ)
      (𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ)) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨?_, ?_⟩
    · have hc : Continuous (fun σ : ℝ => (min σ τ, max σ τ)) :=
        (continuous_id.min continuous_const).prodMk (continuous_id.max continuous_const)
      have := (hc.tendsto τ).mono_left (nhdsWithin_le_nhds (s := {τ}ᶜ))
      simpa only [min_self, max_self] using this
    · filter_upwards [self_mem_nhdsWithin] with σ hσ
      exact min_lt_max.mpr hσ
  refine (h.comp hm).congr' ?_
  filter_upwards [self_mem_nhdsWithin] with σ hσ
  have hσ' : σ ≠ τ := hσ
  simp only [Function.comp_apply, slope_def_field]
  rcases lt_or_gt_of_ne hσ' with hlt | hgt
  · rw [min_eq_left hlt.le, max_eq_right hlt.le,
      show f σ - f τ = -(f τ - f σ) by ring, show σ - τ = -(τ - σ) by ring, neg_div_neg_eq,
      div_eq_inv_mul]
  · rw [min_eq_right hgt.le, max_eq_left hgt.le, div_eq_inv_mul]

/-- Averages over `(s, t)` of integrands converging uniformly in `r ∈ (s, t)` converge. -/
theorem tendsto_average {τ c : ℝ} {k : ℝ × ℝ → ℝ → ℝ}
    (hk : Tendsto (fun q : (ℝ × ℝ) × ℝ => k q.1 q.2)
      (𝓝[{q : (ℝ × ℝ) × ℝ | q.1.1 < q.2 ∧ q.2 < q.1.2}] ((τ, τ), τ)) (𝓝 c))
    (hint : ∀ᶠ p in 𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ), IntegrableOn (k p) (Ioo p.1 p.2)) :
    Tendsto (fun p : ℝ × ℝ => (p.2 - p.1)⁻¹ * ∫ r in Ioo p.1 p.2, k p r)
      (𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ)) (𝓝 c) := by
  rw [Metric.tendsto_nhdsWithin_nhds] at hk
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨δ, hδ, hball⟩ := hk (ε / 2) (half_pos hε)
  have hnear : ∀ᶠ p in 𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ),
      p.1 < p.2 ∧ dist p (τ, τ) < δ := by
    filter_upwards [self_mem_nhdsWithin,
      mem_nhdsWithin_of_mem_nhds (Metric.ball_mem_nhds (τ, τ) hδ)] with p hp1 hp2
    exact ⟨hp1, hp2⟩
  filter_upwards [hnear, hint] with p hp hpi
  obtain ⟨hlt, hd⟩ := hp
  simp only [Prod.dist_eq, Real.dist_eq] at hd
  have hd1 : |p.1 - τ| < δ := (le_max_left _ _).trans_lt hd
  have hd2 : |p.2 - τ| < δ := (le_max_right _ _).trans_lt hd
  have hbound : ∀ r ∈ Ioo p.1 p.2, ‖k p r - c‖ ≤ ε / 2 := by
    intro r hr
    have hq : (p, r) ∈ {q : (ℝ × ℝ) × ℝ | q.1.1 < q.2 ∧ q.2 < q.1.2} := ⟨hr.1, hr.2⟩
    have hdist : dist (p, r) ((τ, τ), τ) < δ := by
      simp only [Prod.dist_eq, Real.dist_eq]
      refine max_lt (max_lt hd1 hd2) ?_
      rw [abs_lt] at hd1 hd2 ⊢
      constructor <;> linarith [hr.1, hr.2, hd1.1, hd1.2, hd2.1, hd2.2]
    have := hball hq hdist
    rw [Real.dist_eq] at this
    rw [Real.norm_eq_abs]
    exact this.le
  have hlen : 0 < p.2 - p.1 := sub_pos.mpr hlt
  have hci : IntegrableOn (fun _ : ℝ => c) (Ioo p.1 p.2) :=
    integrableOn_const measure_Ioo_lt_top.ne
  have hsplit : ∫ r in Ioo p.1 p.2, (k p r - c) =
      (∫ r in Ioo p.1 p.2, k p r) - (p.2 - p.1) * c := by
    rw [integral_sub hpi hci, setIntegral_const, Real.volume_real_Ioo_of_le hlt.le, smul_eq_mul]
  have hnorm : ‖∫ r in Ioo p.1 p.2, (k p r - c)‖ ≤ ε / 2 * (p.2 - p.1) := by
    have := norm_setIntegral_le_of_norm_le_const (μ := volume) (s := Ioo p.1 p.2)
      measure_Ioo_lt_top hbound
    rwa [Real.volume_real_Ioo_of_le hlt.le] at this
  have heq : (p.2 - p.1)⁻¹ * (∫ r in Ioo p.1 p.2, k p r) - c =
      (p.2 - p.1)⁻¹ * ∫ r in Ioo p.1 p.2, (k p r - c) := by
    rw [hsplit, mul_sub, ← mul_assoc, inv_mul_cancel₀ hlen.ne', one_mul]
  rw [Real.dist_eq, heq, abs_mul, abs_inv, abs_of_pos hlen, ← Real.norm_eq_abs]
  calc (p.2 - p.1)⁻¹ * ‖∫ r in Ioo p.1 p.2, (k p r - c)‖
      ≤ (p.2 - p.1)⁻¹ * (ε / 2 * (p.2 - p.1)) := by gcongr
    _ = ε / 2 := by field_simp
    _ < ε := half_lt_self hε

/-! ## The evolution near the diagonal -/

/-- `E(a)f → f₀` when `a → (τ, τ)` inside `{s ≤ τ'}` and `f → f₀`: joint strong continuity of
`E`, `E(τ,τ) = I` and the strip bound (lines 300–306). -/
theorem tendsto_E_apply {D : BackgroundData} {c : Coefficients} {S : FreeEvolution}
    {ev : Evolution} (hev : IsEvolution D c S ev) {α : Type*} {l : Filter α}
    {a : α → ℝ × ℝ} {f : α → X} {τ : ℝ} {f₀ : X}
    (ha : Tendsto a l (𝓝[{p : ℝ × ℝ | p.2 ≤ p.1}] (τ, τ))) (hf : Tendsto f l (𝓝 f₀)) :
    Tendsto (fun x => ev.E (a x).1 (a x).2 (f x)) l (𝓝 f₀) := by
  obtain ⟨C, hC⟩ := hev.strip_bounds 1 one_pos
  have ha0 : Tendsto a l (𝓝 (τ, τ)) := (tendsto_nhdsWithin_iff.mp ha).1
  have hS : ∀ᶠ x in l, (a x).2 ≤ (a x).1 := (tendsto_nhdsWithin_iff.mp ha).2
  have hgap : ∀ᶠ x in l, (a x).1 - (a x).2 < 1 := by
    have h1 : Tendsto (fun x => (a x).1 - (a x).2) l (𝓝 (τ - τ)) :=
      ((continuous_fst.sub continuous_snd).tendsto (τ, τ)).comp ha0
    rw [sub_self] at h1
    exact h1.eventually (Iio_mem_nhds one_pos)
  have h1 : Tendsto (fun x => ev.E (a x).1 (a x).2 f₀) l (𝓝 f₀) := by
    have hcw := hev.strongly_continuous f₀ (τ, τ)
      (show (τ, τ) ∈ {p : ℝ × ℝ | p.2 ≤ p.1} from le_refl τ)
    have h1' : Tendsto (fun p : ℝ × ℝ => ev.E p.1 p.2 f₀)
        (𝓝[{p : ℝ × ℝ | p.2 ≤ p.1}] (τ, τ)) (𝓝 f₀) := by
      have := hcw.tendsto
      have hd : ev.E (τ, τ).1 (τ, τ).2 f₀ = f₀ := by
        show ev.E τ τ f₀ = f₀
        rw [hev.at_diag, ContinuousLinearMap.id_apply]
      rwa [hd] at this
    exact h1'.comp ha
  have h2 : Tendsto (fun x => ev.E (a x).1 (a x).2 (f x - f₀)) l (𝓝 0) := by
    have hn : Tendsto (fun x => C * ‖f x - f₀‖) l (𝓝 0) := by
      have := ((hf.sub_const f₀).norm).const_mul C
      rwa [sub_self, norm_zero, mul_zero] at this
    refine squeeze_zero_norm' ?_ hn
    filter_upwards [hS, hgap] with x hx1 hx2
    exact ((ev.E _ _).le_opNorm _).trans
      (mul_le_mul_of_nonneg_right (hC (a x).2 (a x).1 hx1 (by linarith)).1 (norm_nonneg _))
  have := h2.add h1
  rw [zero_add] at this
  refine this.congr (fun x => ?_)
  rw [map_sub, sub_add_cancel]

/-! ## The pairing functional and the decomposition of a difference -/

/-- `f ↦ ⟨f, φ⟩` as a bounded functional on `X`. -/
theorem exists_pairingCLM (φ : Space → Space) :
    ∃ ℓ : X →L[ℝ] ℝ, ∀ v : X, ℓ v = inner ℝ (Xclass v) (toL2 φ) :=
  ⟨(innerSL ℝ (toL2 φ)).comp XclassCLM, fun v => by
    show inner ℝ (toL2 φ) (XclassCLM v) = inner ℝ (Xclass v) (toL2 φ)
    exact real_inner_comm _ _⟩

/-- The mild-solution hypothesis of `EvolutionWeakForm`. -/
def IsMildOn (ev : Evolution) (τ₀ : ℝ) (z : ℝ → Z) (F : ℝ → X) : Prop :=
  ∀ s τ, s ≤ τ → τ ≤ τ₀ →
    IntegrableOn (fun r => ev.E τ r (F r)) (Ioo s τ) ∧
      ιZ (z τ) = ev.E τ s (ιZ (z s)) + ∫ r in Ioo s τ, ev.E τ r (F r)

theorem integrableOn_k3 {ev : Evolution} {τ₀ : ℝ} {z : ℝ → Z} {F : ℝ → X}
    (hmild : IsMildOn ev τ₀ z F) (φ : Space → Space) {s t : ℝ} (hst : s ≤ t) (ht : t ≤ τ₀) :
    IntegrableOn (fun r => inner ℝ (Xclass (ev.E t r (F r))) (toL2 φ)) (Ioo s t) := by
  obtain ⟨ℓ, hℓ⟩ := exists_pairingCLM φ
  have := ℓ.integrable_comp (hmild s t hst ht).1
  simp only [hℓ] at this
  exact this

theorem integrableOn_k2 {D : BackgroundData} {c : Coefficients} {S : FreeEvolution}
    {ev : Evolution} (hS : IsFreeEvolution D.h S) (hev : IsEvolution D c S ev) {z : ℝ → Z}
    {φ : Space → Space} (hφ : IsVectorTest φ) {s t : ℝ} (hst : s ≤ t) :
    IntegrableOn (fun r => inner ℝ (Lclass (c.B r (ev.E r s (ιZ (z s)))))
      (adjTest D.h φ (t - r))) (Ioo s t) := by
  obtain ⟨ℓ, hℓ⟩ := exists_pairingCLM φ
  have hdi := hev.duhamel_integrable s t hst (ιZ (z s))
  refine IntegrableOn.congr_fun (ℓ.integrable_comp hdi) ?_ measurableSet_Ioo
  intro r hr
  dsimp only
  rw [hℓ, inner_S0L hS (sub_pos.mpr hr.2) _ hφ]

/-- The decomposition of `⟨z(t),φ⟩ - ⟨z(s),φ⟩` from the mild formula on `[s,t]`, the Duhamel
formula for `E(t,s)` (line 299) and the adjoint identities of `S₀`. -/
theorem pairing_decomp {D : BackgroundData} {c : Coefficients} {S : FreeEvolution}
    {ev : Evolution} (hS : IsFreeEvolution D.h S) (hev : IsEvolution D c S ev) {τ₀ : ℝ}
    {z : ℝ → Z} {F : ℝ → X} (hmild : IsMildOn ev τ₀ z F) {φ : Space → Space}
    (hφ : IsVectorTest φ) {s t : ℝ} (hst : s ≤ t) (ht : t ≤ τ₀) :
    inner ℝ (Zclass (z t)) (toL2 φ) - inner ℝ (Zclass (z s)) (toL2 φ) =
      inner ℝ (Zclass (z s)) (adjTest D.h φ (t - s) - toL2 φ) +
      (∫ r in Ioo s t, inner ℝ (Lclass (c.B r (ev.E r s (ιZ (z s)))))
        (adjTest D.h φ (t - r))) +
      ∫ r in Ioo s t, inner ℝ (Xclass (ev.E t r (F r))) (toL2 φ) := by
  obtain ⟨hi, hm⟩ := hmild s t hst ht
  have hd := hev.duhamel s t hst (ιZ (z s))
  have hdi := hev.duhamel_integrable s t hst (ιZ (z s))
  obtain ⟨ℓ, hℓ⟩ := exists_pairingCLM φ
  have e1 : inner ℝ (Zclass (z t)) (toL2 φ) = ℓ (ιZ (z t)) := (hℓ (ιZ (z t))).symm
  have e2 : ∫ r in Ioo s t, ℓ (S.S0L (t - r) (c.B r (ev.E r s (ιZ (z s))))) =
      ∫ r in Ioo s t, inner ℝ (Lclass (c.B r (ev.E r s (ιZ (z s))))) (adjTest D.h φ (t - r)) := by
    apply setIntegral_congr_fun measurableSet_Ioo
    intro r hr
    dsimp only
    rw [hℓ, inner_S0L hS (sub_pos.mpr hr.2) _ hφ]
  have e3 : ∫ r in Ioo s t, ℓ (ev.E t r (F r)) =
      ∫ r in Ioo s t, inner ℝ (Xclass (ev.E t r (F r))) (toL2 φ) := by
    congr 1
    funext r
    exact hℓ _
  rw [e1, hm, map_add, hd, map_add, ← ContinuousLinearMap.integral_comp_comm ℓ hdi,
    ← ContinuousLinearMap.integral_comp_comm ℓ hi, e2, e3, hℓ (S.S0 (t - s) (ιZ (z s))),
    inner_S0 hS (sub_nonneg.mpr hst) _ hφ, Xclass_ιZ, inner_sub_right]
  ring

/-! ## The three limits -/

theorem tendsto_k2 {D : BackgroundData} {c : Coefficients} {S : FreeEvolution}
    {ev : Evolution} (hD : IsUnstableBackground D) (hc : IsCoefficients D c)
    (hev : IsEvolution D c S ev) {z : ℝ → Z} {τ : ℝ} (hzτ : ContinuousAt z τ)
    {φ : Space → Space} (hφ : IsVectorTest φ) :
    Tendsto (fun q : (ℝ × ℝ) × ℝ =>
      inner ℝ (Lclass (c.B q.2 (ev.E q.2 q.1.1 (ιZ (z q.1.1))))) (adjTest D.h φ (q.1.2 - q.2)))
      (𝓝[{q : (ℝ × ℝ) × ℝ | q.1.1 < q.2 ∧ q.2 < q.1.2}] ((τ, τ), τ))
      (𝓝 (inner ℝ (Lclass (c.B τ (ιZ (z τ)))) (toL2 φ))) := by
  set l := 𝓝[{q : (ℝ × ℝ) × ℝ | q.1.1 < q.2 ∧ q.2 < q.1.2}] ((τ, τ), τ) with hl
  have hT : ∀ᶠ q in l, q.1.1 < q.2 ∧ q.2 < q.1.2 := self_mem_nhdsWithin
  have h0 : Tendsto (fun q : (ℝ × ℝ) × ℝ => q) l (𝓝 ((τ, τ), τ)) := nhdsWithin_le_nhds
  have hs : Tendsto (fun q : (ℝ × ℝ) × ℝ => q.1.1) l (𝓝 τ) :=
    ((continuous_fst.comp continuous_fst).tendsto ((τ, τ), τ)).comp h0
  have ht : Tendsto (fun q : (ℝ × ℝ) × ℝ => q.1.2) l (𝓝 τ) :=
    ((continuous_snd.comp continuous_fst).tendsto ((τ, τ), τ)).comp h0
  have hr : Tendsto (fun q : (ℝ × ℝ) × ℝ => q.2) l (𝓝 τ) :=
    (continuous_snd.tendsto ((τ, τ), τ)).comp h0
  have ha : Tendsto (fun q : (ℝ × ℝ) × ℝ => (q.2, q.1.1)) l
      (𝓝[{p : ℝ × ℝ | p.2 ≤ p.1}] (τ, τ)) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨hr.prodMk_nhds hs, ?_⟩
    filter_upwards [hT] with q hq
    exact hq.1.le
  have hf : Tendsto (fun q : (ℝ × ℝ) × ℝ => ιZ (z q.1.1)) l (𝓝 (ιZ (z τ))) :=
    (ιZ.continuous.tendsto _).comp (hzτ.tendsto.comp hs)
  have hE : Tendsto (fun q : (ℝ × ℝ) × ℝ => ev.E q.2 q.1.1 (ιZ (z q.1.1))) l
      (𝓝 (ιZ (z τ))) := tendsto_E_apply hev ha hf
  have hB : Tendsto (fun q : (ℝ × ℝ) × ℝ => c.B q.2) l (𝓝 (c.B τ)) :=
    (hc.B_continuous.tendsto τ).comp hr
  have hBE : Tendsto (fun q : (ℝ × ℝ) × ℝ => c.B q.2 (ev.E q.2 q.1.1 (ιZ (z q.1.1)))) l
      (𝓝 (c.B τ (ιZ (z τ)))) :=
    (isBoundedBilinearMap_apply.continuous.tendsto (c.B τ, ιZ (z τ))).comp (hB.prodMk_nhds hE)
  have hL : Tendsto (fun q : (ℝ × ℝ) × ℝ => Lclass (c.B q.2 (ev.E q.2 q.1.1 (ιZ (z q.1.1)))))
      l (𝓝 (Lclass (c.B τ (ιZ (z τ))))) :=
    (LclassCLM.continuous.tendsto _).comp hBE
  have hgap : Tendsto (fun q : (ℝ × ℝ) × ℝ => q.1.2 - q.2) l (𝓝[>] 0) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨?_, ?_⟩
    · have := ht.sub hr
      rwa [sub_self] at this
    · filter_upwards [hT] with q hq
      exact sub_pos.mpr hq.2
  have hA : Tendsto (fun q : (ℝ × ℝ) × ℝ => adjTest D.h φ (q.1.2 - q.2)) l (𝓝 (toL2 φ)) :=
    (tendsto_adjTest_zero hD.1.h_pos hφ).comp hgap
  exact hL.inner hA

theorem tendsto_k3 {D : BackgroundData} {c : Coefficients} {S : FreeEvolution}
    {ev : Evolution} (hev : IsEvolution D c S ev) {F : ℝ → X} {τ : ℝ}
    (hFτ : ContinuousAt F τ) (φ : Space → Space) :
    Tendsto (fun q : (ℝ × ℝ) × ℝ => inner ℝ (Xclass (ev.E q.1.2 q.2 (F q.2))) (toL2 φ))
      (𝓝[{q : (ℝ × ℝ) × ℝ | q.1.1 < q.2 ∧ q.2 < q.1.2}] ((τ, τ), τ))
      (𝓝 (inner ℝ (Xclass (F τ)) (toL2 φ))) := by
  set l := 𝓝[{q : (ℝ × ℝ) × ℝ | q.1.1 < q.2 ∧ q.2 < q.1.2}] ((τ, τ), τ) with hl
  have hT : ∀ᶠ q in l, q.1.1 < q.2 ∧ q.2 < q.1.2 := self_mem_nhdsWithin
  have h0 : Tendsto (fun q : (ℝ × ℝ) × ℝ => q) l (𝓝 ((τ, τ), τ)) := nhdsWithin_le_nhds
  have ht : Tendsto (fun q : (ℝ × ℝ) × ℝ => q.1.2) l (𝓝 τ) :=
    ((continuous_snd.comp continuous_fst).tendsto ((τ, τ), τ)).comp h0
  have hr : Tendsto (fun q : (ℝ × ℝ) × ℝ => q.2) l (𝓝 τ) :=
    (continuous_snd.tendsto ((τ, τ), τ)).comp h0
  have ha : Tendsto (fun q : (ℝ × ℝ) × ℝ => (q.1.2, q.2)) l
      (𝓝[{p : ℝ × ℝ | p.2 ≤ p.1}] (τ, τ)) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨ht.prodMk_nhds hr, ?_⟩
    filter_upwards [hT] with q hq
    exact hq.2.le
  have hf : Tendsto (fun q : (ℝ × ℝ) × ℝ => F q.2) l (𝓝 (F τ)) := hFτ.tendsto.comp hr
  have hE : Tendsto (fun q : (ℝ × ℝ) × ℝ => ev.E q.1.2 q.2 (F q.2)) l (𝓝 (F τ)) :=
    tendsto_E_apply hev ha hf
  exact ((XclassCLM.continuous.tendsto _).comp hE).inner tendsto_const_nhds

theorem tendsto_q1 {h : ℝ} (hh : 0 < h) {z : ℝ → Z} {τ : ℝ} (hzτ : ContinuousAt z τ)
    {φ : Space → Space} (hφ : IsVectorTest φ) :
    Tendsto (fun p : ℝ × ℝ => inner ℝ (Zclass (z p.1))
        ((p.2 - p.1)⁻¹ • (adjTest h φ (p.2 - p.1) - toL2 φ)))
      (𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ)) (𝓝 (inner ℝ (Zclass (z τ)) (adjGen h φ))) := by
  set l := 𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ) with hl
  have h0 : Tendsto (fun p : ℝ × ℝ => p) l (𝓝 (τ, τ)) := nhdsWithin_le_nhds
  have hs : Tendsto (fun p : ℝ × ℝ => p.1) l (𝓝 τ) := (continuous_fst.tendsto (τ, τ)).comp h0
  have ht : Tendsto (fun p : ℝ × ℝ => p.2) l (𝓝 τ) := (continuous_snd.tendsto (τ, τ)).comp h0
  have hgap : Tendsto (fun p : ℝ × ℝ => p.2 - p.1) l (𝓝[>] 0) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨?_, ?_⟩
    · have := ht.sub hs
      rwa [sub_self] at this
    · filter_upwards [self_mem_nhdsWithin] with p hp
      exact sub_pos.mpr hp
  have hZc : Continuous (fun g : Z => Zclass g) :=
    (XclassCLM.comp ιZ).continuous.congr (fun g => rfl)
  have hZ : Tendsto (fun p : ℝ × ℝ => Zclass (z p.1)) l (𝓝 (Zclass (z τ))) :=
    (hZc.tendsto _).comp (hzτ.tendsto.comp hs)
  exact hZ.inner ((tendsto_adjTest_slope hh hφ).comp hgap)

end UnforcedLeray.Blueprint.EvolWeak

namespace UnforcedLeray.Blueprint.L13

open SobolevGraph EvolWeak

/-- **H-EvolWeak** (`paper/main.tex` lines 292–306 and 406–417; B0712, B0713, B1018, B1019;
INF07, INF08, INF14): a `Z`-continuous mild solution
`z(τ) = E(τ,s)z(s) + ∫_s^τ E(τ,r)F(r) dr` of the evolution of L3 with continuous `X`-forcing
`F` is a weak solution of `∂_τz = hΔz + ½z + ½y·∇z + 𝓑_*(τ)z + F` on `(-∞, τ₀)`. -/
theorem evolutionWeakForm : EvolutionWeakForm := by
  intro D c S ev hD hc hS hev τ₀ z F hz hF hmild φ hφ τ hτ
  have hmild' : IsMildOn ev τ₀ z F := hmild
  have hh : 0 < D.h := hD.1.h_pos
  have hτ' : τ < τ₀ := hτ
  have hzτ : ContinuousAt z τ := hz.continuousAt (Iic_mem_nhds hτ')
  have hFτ : ContinuousAt F τ := hF.continuousAt (Iic_mem_nhds hτ')
  set l := 𝓝[{p : ℝ × ℝ | p.1 < p.2}] (τ, τ) with hl
  have hev2 : ∀ᶠ p in l, p.1 < p.2 ∧ p.2 ≤ τ₀ := by
    have h0 : Tendsto (fun p : ℝ × ℝ => p.2) l (𝓝 τ) :=
      (continuous_snd.tendsto (τ, τ)).comp nhdsWithin_le_nhds
    filter_upwards [self_mem_nhdsWithin, h0.eventually (Iic_mem_nhds hτ')] with p hp hp2
    exact ⟨hp, hp2⟩
  have hint2 : ∀ᶠ p in l, IntegrableOn (fun r => inner ℝ (Lclass (c.B r (ev.E r p.1
      (ιZ (z p.1))))) (adjTest D.h φ (p.2 - r))) (Ioo p.1 p.2) := by
    filter_upwards [hev2] with p hp
    exact integrableOn_k2 hS hev hφ hp.1.le
  have hint3 : ∀ᶠ p in l, IntegrableOn (fun r => inner ℝ (Xclass (ev.E p.2 r (F r))) (toL2 φ))
      (Ioo p.1 p.2) := by
    filter_upwards [hev2] with p hp
    exact integrableOn_k3 hmild' φ hp.1.le hp.2
  have hA2 := tendsto_average (k := fun p r => inner ℝ (Lclass (c.B r (ev.E r p.1
      (ιZ (z p.1))))) (adjTest D.h φ (p.2 - r))) (tendsto_k2 hD hc hev hzτ hφ) hint2
  have hA3 := tendsto_average (k := fun p r => inner ℝ (Xclass (ev.E p.2 r (F r))) (toL2 φ))
    (tendsto_k3 hev hFτ φ) hint3
  have hA1 := tendsto_q1 hh hzτ hφ
  have hsum := (hA1.add hA2).add hA3
  have hQ : Tendsto (fun p : ℝ × ℝ => (p.2 - p.1)⁻¹ *
      (inner ℝ (Zclass (z p.2)) (toL2 φ) - inner ℝ (Zclass (z p.1)) (toL2 φ))) l
      (𝓝 (inner ℝ (Zclass (z τ)) (adjGen D.h φ) +
        inner ℝ (Lclass (c.B τ (ιZ (z τ)))) (toL2 φ) + inner ℝ (Xclass (F τ)) (toL2 φ))) := by
    refine hsum.congr' ?_
    filter_upwards [hev2] with p hp
    beta_reduce
    rw [pairing_decomp hS hev hmild' hφ hp.1.le hp.2, real_inner_smul_right]
    ring
  have hd := hasDerivAt_of_tendsto_pair (f := fun σ => inner ℝ (Zclass (z σ)) (toL2 φ)) hQ
  refine hd.congr_deriv ?_
  have hlap : inner ℝ (H2.laplace (z τ).toH2) (toL2 φ) =
      inner ℝ (Zclass (z τ)) (toL2 (B0418.vecLaplacian φ)) :=
    (L14.inner_laplace_toL2 _ hφ).trans rfl
  beta_reduce
  rw [adjGen, inner_add_left, inner_add_left, real_inner_smul_left, hlap]
  simp only [inner_add_right, inner_sub_right, inner_neg_right, real_inner_smul_right]
  have e : ((z τ).toH2).value = Zclass (z τ) := rfl
  rw [e]
  ring

end UnforcedLeray.Blueprint.L13
