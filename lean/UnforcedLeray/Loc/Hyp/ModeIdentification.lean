import UnforcedLeray.Loc.Hyp.ModeIdentification.Regularity
import UnforcedLeray.Loc.Hyp.EvolutionWeakForm

/-!
# H-ModeId: `e^{στ} b_*` is the solution generated by `E` (`ModeIdentificationHyp`)

Target: `UnforcedLeray.Blueprint.L04.ModeIdentificationHyp` (`Loc/L04ModeRegularity.lean`,
line 92), `paper/main.tex` lines 308–318, blueprint units B1009 and B1010.

## The proof (tex lines 308–318)

1. **Phase slices** (`ModeIdentification/Slices.lean`, `ModeEq.lean`): the graph clauses and the
   mode equation, stated against spacetime tests in the package, hold at almost every phase
   against every vector test (Fubini with product tests, a countable dense family of tests).
2. **B1009, continuous representative** (`Drift.lean`): in the frame `P_b(τ) = D(-τ)b_*(τ)`
   (`D(s)F = e^{s/2}F(e^{s/2}·)`; the manuscript's `g(x,τ) = b_*(e^{-τ/2}x,τ)` up to the factor
   `e^{-τ/2}`) the mode has the weak time derivative `D(-τ)(driftB - ½b_*)` on every bounded
   interval, hence a continuous `L²` representative (`BochnerTime.HasWeakDerivTime.rep`).
3. **The mode as an `X`-field** (`Phase.lean`): at a.e. phase `b_*(τ) ∈ X` with weak Laplacian
   `lapB(τ)` (elliptic regularity, `LaplacianH1Regularity`), and the mode equation holds in `L²`
   with `𝓑_*(τ)` (identified through `B_weak`).
4. **The `E`-solution in the frame** (`Evolution.lean`): conditional on the mild-to-weak theorem
   `L13.EvolutionWeakForm`, `D(-τ)E(τ,s₀)f₀` is differentiable for `τ > s₀` with derivative
   `D(-τ)(hΔE + 𝓑_*E)`.
5. **B1010, forward uniqueness** (`Energy.lean`, `Uniqueness.lean`): the energy estimate
   `⟨hΔδ + 𝓑_*δ - σδ, δ⟩ ≤ K‖δ‖²` (Young against the dissipation, with only
   `𝓑_* ∈ L(X,L²_div)`), the weighted energy identity and `d(a) → 0` as `a ↓ s₀`.
6. **Assembly** (here): `s₀ ∈ (0,1)` is chosen where `b_*(s₀) ∈ X` and the representative agrees
   with `P_b`; `F₀ = ι_X b̃(s₀)`.

## Status

**Proved unconditionally**: `modeIdentificationHyp : L04.ModeIdentificationHyp`. The two inputs
of the conditional form `modeIdentificationHyp_of_regularity` are both compiled theorems:

* `L13.evolutionWeakForm : L13.EvolutionWeakForm` (mild ⇒ weak for the evolution of L3,

* `laplacianH1Regularity : LaplacianH1Regularity` (`ModeIdentification/Regularity.lean`:
  `f, Δf ∈ L²(ℝ³)` gives `f ∈ H¹` with weak Laplacian `Δf`, by mollification and closedness
  of the weak Laplacian graph).
-/

set_option autoImplicit false

noncomputable section

open Set MeasureTheory Filter
open scoped ENNReal ContDiff Topology

namespace UnforcedLeray.Blueprint.ModeId

open SobolevGraph
open UnforcedLeray.BochnerTime
open UnforcedLeray.Loc.L02 (dil)

variable {D : BackgroundData} {c : Coefficients} {S : FreeEvolution} {ev : Evolution}

/-- **`e^{στ}b_*` is generated by `E` from an `L²_div` datum** (tex lines 308–318, B1009 +
B1010), for one package and one evolution, from `L13.EvolutionWeakForm` and
`LaplacianH1Regularity`. -/
theorem modeGeneratedByL2_of (hW : L13.EvolutionWeakForm) (hR : LaplacianH1Regularity)
    (hD : IsUnstableBackground D) (hc : IsCoefficients D c) (hS : IsFreeEvolution D.h S)
    (hev : IsEvolution D c S ev) : L04.ModeGeneratedByL2 D ev := by
  have hT := hD.1.period_pos
  have hg := hD.2.graph
  have hrepN : ∀ N : ℕ, ∀ᵐ τ, τ ∈ Ioo (-1 : ℝ) ((N : ℝ) + 2) →
      Pb D τ = (mode_hasWeakDerivTime' hD (-1) ((N : ℝ) + 2)).rep τ := fun N =>
    (ae_restrict_iff' measurableSet_Ioo).1 (mode_hasWeakDerivTime' hD _ _).ae_eq_rep
  have hall := ae_all_iff.2 hrepN
  -- the initial phase
  have hgood : ∀ᵐ s ∂(volume.restrict (Ioo (0 : ℝ) 1)), s ∈ Ioo (0 : ℝ) 1 ∧
      (MemLp (D.bstar s) 2 volume ∧ ∃ bt : X, Xclass bt = toL2 (D.bstar s) ∧
        HasWeakLaplacian bt.toH1 (toL2 (D.lapB s)) ∧
        toL2 (D.driftB s) - (1 / 2 : ℝ) • toL2 (D.bstar s) =
          D.h • toL2 (D.lapB s) - D.σ • toL2 (D.bstar s) + Lclass (c.B s bt)) ∧
      ∀ N : ℕ, s ∈ Ioo (-1 : ℝ) ((N : ℝ) + 2) →
        Pb D s = (mode_hasWeakDerivTime' hD (-1) ((N : ℝ) + 2)).rep s := by
    filter_upwards [ae_restrict_mem measurableSet_Ioo, ae_restrict_of_ae (ae_phase hR hD hc),
      ae_restrict_of_ae hall] with s h1 h2 h3
    exact ⟨h1, h2, h3⟩
  have : (ae (volume.restrict (Ioo (0 : ℝ) 1))).NeBot :=
    ae_restrict_neBot.2 (by simp [Real.volume_Ioo])
  obtain ⟨s₀, hs₀mem, ⟨_, bt, hbt, _, _⟩, hs₀rep⟩ := hgood.exists
  refine ⟨s₀, ιX bt, ?_⟩
  have hfr : ∀ N : ℕ, ∀ t ∈ Ioo s₀ ((N : ℝ) + 2),
      Wf D ev s₀ bt t = (mode_hasWeakDerivTime' hD (-1) ((N : ℝ) + 2)).rep t := by
    intro N
    have hN : (0 : ℝ) ≤ N := Nat.cast_nonneg N
    have hmem : s₀ ∈ Ioo (-1 : ℝ) ((N : ℝ) + 2) := ⟨by linarith [hs₀mem.1], by linarith [hs₀mem.2]⟩
    refine frame_eq hW hR hD hc hS hev (by linarith [hs₀mem.1]) (by linarith [hs₀mem.2]) bt ?_
    rw [hbt, ← hs₀rep N hmem]
    rfl
  filter_upwards [Y2.ae_memLp hT hg.value, hall] with τ hm hrep hτ
  have hτN : τ < (⌈τ⌉₊ : ℝ) + 2 := by
    have := Nat.le_ceil τ
    linarith
  have hτmem : τ ∈ Ioo (-1 : ℝ) ((⌈τ⌉₊ : ℝ) + 2) := ⟨by linarith [hs₀mem.1], hτN⟩
  have h3 : Wf D ev s₀ bt τ = Pb D τ := (hfr _ τ ⟨hτ, hτN⟩).trans (hrep _ hτmem).symm
  have h4 : Xclass (ev.E τ s₀ bt) = Real.exp (D.σ * (τ - s₀)) • toL2 (D.bstar τ) := by
    have h5 : dil (-τ) (Real.exp (-(D.σ * (τ - s₀))) • Xclass (ev.E τ s₀ bt)) =
        dil (-τ) (toL2 (D.bstar τ)) := by
      rw [map_smul]
      exact h3
    have h6 := dil_injective _ h5
    rw [← h6, smul_smul, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_smul]
  rw [L04.EL_apply hev hτ]
  show ((Xclass (ev.E τ s₀ bt) : L2Space) : SpatialField) =ᵐ[volume] _
  rw [h4]
  filter_upwards [Lp.coeFn_smul (Real.exp (D.σ * (τ - s₀))) (toL2 (D.bstar τ)), coeFn_toL2 hm]
    with y hy1 hy2
  rw [hy1, Pi.smul_apply, hy2, Pi.smul_apply]

/-- **`ModeIdentificationHyp`** (tex lines 308–318, B1009 + B1010), from the mild-to-weak
theorem `L13.EvolutionWeakForm` and elliptic regularity `LaplacianH1Regularity`. -/
theorem modeIdentificationHyp_of_regularity (hW : L13.EvolutionWeakForm)
    (hR : LaplacianH1Regularity) : L04.ModeIdentificationHyp := by
  intro D hD c S ev hc hS hev
  exact modeGeneratedByL2_of hW hR hD hc hS hev

/-- **H-ModeId: `ModeIdentificationHyp`** (`paper/main.tex` lines 308–318, the sentence
"Consequently `e^{στ}b_*` is the solution generated by `E`"; blueprint units B1009 and B1010).
For every package `D` with `IsUnstableBackground D` and every evolution `ev` of its coefficients,
there are `s₀` and `F₀ ∈ L²_div` with `E_L(τ,s₀)F₀ = e^{σ(τ-s₀)} b_*(τ)` in `L²` for almost every
`τ > s₀`. -/
theorem modeIdentificationHyp : L04.ModeIdentificationHyp :=
  modeIdentificationHyp_of_regularity L13.evolutionWeakForm laplacianH1Regularity

end UnforcedLeray.Blueprint.ModeId
