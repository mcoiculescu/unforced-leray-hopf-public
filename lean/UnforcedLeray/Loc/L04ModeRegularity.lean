import UnforcedLeray.Loc.L04ModeRegularity.ZContinuity

/-!
# L4. Regularity of the graph mode: `ModeRegularityStep`

`paper/main.tex` lines 307–329 (the paragraph "For the graph mode …", `loc:eq:mode-regularity`
and the no-zero-phase half of `loc:eq:phase-minimum`). Blueprint units B1009 (continuous `L²`
representative), B1010 (energy uniqueness; `e^{στ} b_*` is generated by `E`), B1011
(`b_* ∈ C_per H²`); the minimum `m_* > 0` (B1012) is proved from the step in
`Blueprint/Localization/Compose.lean` (`phase_minimum`).
The target is the step proposition `UnforcedLeray.Blueprint.ModeRegularityStep`
(`Blueprint/Localization/Linear.lean`, line 175).

## What is proved here

`modeRegularityStep_of` proves `ModeRegularityStep` from one named hypothesis, the analytic
theorem of lines 308–318 that no compiled module provides:

* `ModeIdentificationHyp` (B1009 + B1010): `e^{στ} b_*` is the solution generated by `E`, in
  the weakest form used: for one initial time `s₀` and one `L²_div` datum `F₀`,
  `E_L(τ,s₀) F₀ = e^{σ(τ-s₀)} b_*(τ)` in `L²` for almost every `τ > s₀`.

The hypothesis is also implied by the step (`modeIdentificationHyp_of_step`), so
`modeRegularityStep_iff : ModeRegularityStep ↔ ModeIdentificationHyp`: the step is exactly
the identification of the weak graph mode with the `E`-solution, and everything else in
lines 307–329 is proved:

* the `X = H¹_div` datum one unit of time later, `E_L(s₀+1,s₀) F₀`, by the evolution law
  (`modeGeneratedBy_of_L2`);
* the continuous periodic `X`-valued representative, built from the single solution
  `τ ↦ e^{-σ(τ-s₀)} E(τ,s₀) f₀` by translating by whole periods; its periodicity is proved from
  the periodicity of `b_*` and of `E`, by "continuous and equal a.e. on an open set ⇒ equal"
  (`btilde_periodic`, `btilde_continuous`);
* generation by `E` at every pair `s ≤ τ` (evolution law and double periodicity,
  `btilde_generated`);
* "forward uniqueness and periodicity exclude a zero phase" (lines 325–326): a zero phase
  makes the representative vanish forward, then everywhere, so `b_* = 0` a.e. on the period
  slab, by Fubini on the jointly measurable `b_*` (`btilde_ne_zero`);
* `𝒪`-invariance at every phase from invariance at almost every phase, by continuity of the
  rotation on `L²` and density of a conull set (`btilde_symmetric`);
* the `Z`-valued representative `b̂(τ) = e^{-σ𝒯} E_Z(τ,τ-𝒯) b̃(τ-𝒯)` ("starting one period
  earlier and applying the smoothing", lines 318–320), with `ι_Z b̂ = b̃` and continuity in `Z`
  (`isRegularMode_bhatOf`);
* the strong continuity of `E` on `Z` used there, for every `E` with `IsEvolution`
  (`evolutionZContinuity_of`, in `L04ModeRegularity/ZContinuity.lean`): `S₀` is bounded on
  `Z` by duality from the Duhamel formula and the strip bounds, hence strongly continuous on
  `Z` (`Loc/L03Evolution/ZContinuity.lean`), and `E` is the Volterra evolution of
  `Infra/VolterraEvolution.lean` by uniqueness of strip solutions, whose `Z`-level version is
  strongly continuous.
-/

set_option autoImplicit false

noncomputable section

open Set MeasureTheory Filter
open scoped ENNReal Topology

namespace UnforcedLeray.Blueprint.L04

open SobolevGraph

/-! ## The missing theorem, as a named hypothesis -/

/-- `e^{στ} b_*` is the solution generated by `E` from an `L²_div` datum (tex lines 308–318,
the sentence "Consequently `e^{στ}b_*` is the solution generated by `E`"; blueprint units
B1009, B1010), in its weakest form: there are an initial time `s₀` and an initial value
`F₀ ∈ L²_div` with `E_L(τ,s₀) F₀ = e^{σ(τ-s₀)} b_*(τ)` in `L²` for almost every `τ > s₀`.

The manuscript's proof: `g(x,τ) = b_*(e^{-τ/2}x,τ)` lies in `L²H²` with `∂_τ g ∈ L²L²` on
bounded intervals, so `b_*` has a continuous `L²` representative with `b_*(s) ∈ H²_div` for a.e.
`s` (B1009); the mild solution `E(τ,s)[e^{σs}b_*(s)]` is a graph solution of `∂_τ w = 𝓛_* w`,
and graph solutions are unique forward in time by the energy estimate
`|⟨f·∇U_*, f⟩| ≤ C‖∇U_*‖₃‖f‖₂‖∇f‖₂` and Gronwall (B1010). -/
def ModeGeneratedByL2 (D : BackgroundData) (ev : Evolution) : Prop :=
  ∃ s₀ : ℝ, ∃ F₀ : L2div, ∀ᵐ τ, s₀ < τ →
    Xval (ev.EL τ s₀ F₀) =ᵐ[volume] Real.exp (D.σ * (τ - s₀)) • D.bstar τ

/-- The same with an `X = H¹_div` datum (tex line 318). It follows from `ModeGeneratedByL2`
by the smoothing `E_L(s₀+1,s₀) : L²_div → X` (`modeGeneratedBy_of_L2`). -/
def ModeGeneratedBy (D : BackgroundData) (ev : Evolution) : Prop :=
  ∃ s₀ : ℝ, ∃ f₀ : X, ∀ᵐ τ, s₀ < τ →
    Xval (ev.E τ s₀ f₀) =ᵐ[volume] Real.exp (D.σ * (τ - s₀)) • D.bstar τ

/-- **Missing theorem (B1009 + B1010, tex lines 308–318).** For every package and every
evolution of its coefficients, `e^{στ} b_*` is generated by `E` from an `L²_div` datum
(`ModeGeneratedByL2`). It is equivalent to the step (`modeRegularityStep_iff`).
Missing infrastructure: `W^{1,2}(I;L²) ⊂ C(I;L²)` with the time-dependent dilation (INF14,
INF25), `H²` from `‖f‖₂ + ‖Δf‖₂` (INF11), the Lions–Magenes energy identity for graph
solutions, `H¹ ⊂ L⁶` with Hölder and Gronwall (INF11, INF15), and "mild ⇒ graph solution"
for `E` (INF08, INF30). -/
def ModeIdentificationHyp : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D →
    ∀ (c : Coefficients) (S : FreeEvolution) (ev : Evolution),
      IsCoefficients D c → IsFreeEvolution D.h S → IsEvolution D c S ev →
        ModeGeneratedByL2 D ev

/-! ## Rotations on `L²` and `𝒪`-invariance -/

/-- `F ↦ g F(g⁻¹ ·)` on `L²(ℝ³;ℝ³)`, a continuous linear map. -/
def rotL2 (g : Space ≃ₗᵢ[ℝ] Space) : L2Space →L[ℝ] L2Space :=
  (g.toLinearIsometry.toContinuousLinearMap.compLpL 2 volume).comp
    (Lp.compMeasurePreservingₗᵢ ℝ (g.symm : Space → Space)
      g.symm.measurePreserving).toContinuousLinearMap

theorem rotL2_ae (g : Space ≃ₗᵢ[ℝ] Space) (F : L2Space) :
    (rotL2 g F : SpatialField) =ᵐ[volume] rotateField g (F : SpatialField) := by
  have h1 := ContinuousLinearMap.coeFn_compLpL (μ := volume) (p := 2)
    g.toLinearIsometry.toContinuousLinearMap
    (Lp.compMeasurePreserving (g.symm : Space → Space) g.symm.measurePreserving F)
  have h2 := Lp.coeFn_compMeasurePreserving F g.symm.measurePreserving
  have h3 : (fun x => g.toLinearIsometry.toContinuousLinearMap
      ((Lp.compMeasurePreserving (g.symm : Space → Space) g.symm.measurePreserving F) x))
        =ᵐ[volume] rotateField g (F : SpatialField) := by
    filter_upwards [h2] with x hx
    simp only [rotateField, hx, Function.comp_apply]
    rfl
  exact h1.trans h3

/-- `𝒪`-invariance passes to a.e. equal fields. -/
theorem isAxisymmetricNoSwirl_congr {f f' : SpatialField} (h : f =ᵐ[volume] f')
    (hf : IsAxisymmetricNoSwirl f) : IsAxisymmetricNoSwirl f' := by
  intro g hg
  have h1 : rotateField g f' =ᵐ[volume] rotateField g f := by
    have h2 := g.symm.measurePreserving.quasiMeasurePreserving.ae_eq_comp h.symm
    filter_upwards [h2] with x hx
    simp only [rotateField]
    simp only [Function.comp_apply] at hx
    rw [hx]
  exact h1.trans ((hf g hg).trans h)

/-- A continuous `L²`-valued path that is `𝒪`-invariant at almost every phase is invariant at
every phase. -/
theorem forall_isAxisymmetricNoSwirl_of_ae {b : ℝ → L2Space} (hb : Continuous b)
    (hae : ∀ᵐ τ, IsAxisymmetricNoSwirl (b τ : SpatialField)) (τ : ℝ) :
    IsAxisymmetricNoSwirl (b τ : SpatialField) := by
  intro g hg
  have hclosed : IsClosed {t : ℝ | rotL2 g (b t) = b t} :=
    isClosed_eq ((rotL2 g).continuous.comp hb) hb
  have hdense : Dense {t : ℝ | rotL2 g (b t) = b t} := by
    apply Measure.dense_of_ae (μ := volume)
    filter_upwards [hae] with t ht
    apply Lp.ext
    exact (rotL2_ae g (b t)).trans (ht g hg)
  have hmem : rotL2 g (b τ) = b τ := by
    have : τ ∈ {t : ℝ | rotL2 g (b t) = b t} := by
      rw [← hclosed.closure_eq, hdense.closure_eq]
      trivial
    exact this
  have h := rotL2_ae g (b τ)
  rw [hmem] at h
  exact h.symm

/-! ## Fubini: a field vanishing at a.e. phase vanishes a.e. on spacetime -/

theorem ae_eq_zero_of_ae_ae {F : ℝ → SpatialField}
    (hm : AEStronglyMeasurable (fun z : SpaceTime => F z.1 z.2) volume)
    (h : ∀ᵐ τ, F τ =ᵐ[volume] 0) :
    (fun z : SpaceTime => F z.1 z.2) =ᵐ[volume] 0 := by
  have hGG := hm.ae_eq_mk
  have h1 := Measure.ae_ae_of_ae_prod (μ := (volume : Measure ℝ))
    (ν := (volume : Measure Space)) hGG
  have hset : MeasurableSet {z : SpaceTime | hm.mk _ z = 0} :=
    hm.stronglyMeasurable_mk.measurable (measurableSet_singleton 0)
  have h2 : ∀ᵐ z ∂(volume : Measure SpaceTime), hm.mk _ z = 0 := by
    refine (Measure.ae_prod_iff_ae_ae (μ := (volume : Measure ℝ))
      (ν := (volume : Measure Space)) hset).2 ?_
    filter_upwards [h1, h] with τ hτ1 hτ2
    filter_upwards [hτ1, hτ2] with y hy1 hy2
    rw [← hy1]
    exact hy2
  filter_upwards [hGG, h2] with z hz1 hz2
  rw [hz1, hz2]
  rfl

/-! ## Evolution identities -/

variable {D : BackgroundData} {c : Coefficients} {S : FreeEvolution} {ev : Evolution}

theorem E_add_nat_mul (hev : IsEvolution D c S ev) (n : ℕ) (τ s : ℝ) :
    ev.E (τ + n * D.period) (s + n * D.period) = ev.E τ s := by
  induction n with
  | zero => simp
  | succ n ih =>
    have h := hev.periodic (τ + n * D.period) (s + n * D.period)
    rw [show τ + ((n + 1 : ℕ) : ℝ) * D.period = τ + n * D.period + D.period by push_cast; ring,
      show s + ((n + 1 : ℕ) : ℝ) * D.period = s + n * D.period + D.period by push_cast; ring,
      h, ih]

/-- An `L²_div` datum generating the mode gives an `X` datum one unit of time later:
`f₀ = e^{-σ} E_L(s₀+1,s₀) F₀`, since `E(τ,s₀+1) E_L(s₀+1,s₀) = E_L(τ,s₀)`. -/
theorem modeGeneratedBy_of_L2 (hS : IsFreeEvolution D.h S) (hev : IsEvolution D c S ev)
    (h : ModeGeneratedByL2 D ev) : ModeGeneratedBy D ev := by
  obtain ⟨s₀, F₀, hF₀⟩ := h
  refine ⟨s₀ + 1, Real.exp (-D.σ) • ev.EL (s₀ + 1) s₀ F₀, ?_⟩
  filter_upwards [hF₀] with τ hτ hlt
  have hlt' : s₀ < τ := by linarith
  have h1 : ev.E τ (s₀ + 1) (Real.exp (-D.σ) • ev.EL (s₀ + 1) s₀ F₀) =
      Real.exp (-D.σ) • ev.EL τ s₀ F₀ := by
    rw [map_smul, E_EL hS hev (by linarith) hlt.le]
  rw [h1]
  refine (Xval_smul_ae _ _).trans ?_
  filter_upwards [hτ hlt'] with y hy
  simp only [Pi.smul_apply] at hy ⊢
  rw [hy, smul_smul, ← Real.exp_add]
  congr 2
  ring

/-! ## The `X`-valued representative -/

/-- The properties of an `H¹_div` representative of the mode proved before the `Z` lift:
`b_* ∈ C_per H¹`, generated by `E` with rate `σ`, no zero phase, `𝒪`-invariant. -/
structure IsRegularModeX (D : BackgroundData) (ev : Evolution) (b : ℝ → X) : Prop where
  continuous : Continuous b
  periodic : Function.Periodic b D.period
  represents : ∀ᵐ τ, Xval (b τ) =ᵐ[volume] D.bstar τ
  generated : ∀ s τ, s ≤ τ → b τ = Real.exp (-(D.σ * (τ - s))) • ev.E τ s (b s)
  no_zero_phase : ∀ τ, Xclass (b τ) ≠ 0
  symmetric : ∀ τ, IsAxisymmetricNoSwirl (Xval (b τ))

/-- The single solution `ψ(τ) = e^{-σ(τ-s₀)} E(τ,s₀) f₀`, meaningful for `τ ≥ s₀`. -/
def psi (D : BackgroundData) (ev : Evolution) (s₀ : ℝ) (f₀ : X) (τ : ℝ) : X :=
  Real.exp (-(D.σ * (τ - s₀))) • ev.E τ s₀ f₀

/-- A number of periods `n` with `s₀ < τ + n𝒯`. -/
def idx (period s₀ τ : ℝ) : ℕ := ⌈(s₀ - τ) / period⌉₊ + 1

theorem lt_add_idx {period : ℝ} (hT : 0 < period) (s₀ τ : ℝ) :
    s₀ < τ + idx period s₀ τ * period := by
  unfold idx
  have h := Nat.le_ceil ((s₀ - τ) / period)
  rw [div_le_iff₀ hT] at h
  push_cast
  rw [add_mul, one_mul]
  linarith

/-- The periodic representative `b̃(τ) = ψ(τ + n𝒯)` with `n = idx`. -/
def btilde (D : BackgroundData) (ev : Evolution) (s₀ : ℝ) (f₀ : X) (τ : ℝ) : X :=
  psi D ev s₀ f₀ (τ + idx D.period s₀ τ * D.period)

theorem psi_continuousOn (hev : IsEvolution D c S ev) (s₀ : ℝ) (f₀ : X) :
    ContinuousOn (psi D ev s₀ f₀) (Ici s₀) := by
  have h1 : ContinuousOn (fun τ : ℝ => ev.E τ s₀ f₀) (Ici s₀) := by
    have hp : Continuous (fun τ : ℝ => (τ, s₀)) := continuous_id.prodMk continuous_const
    refine (hev.strongly_continuous f₀).comp (f := fun τ : ℝ => (τ, s₀)) hp.continuousOn ?_
    intro τ hτ
    exact hτ
  have he : Continuous (fun τ : ℝ => Real.exp (-(D.σ * (τ - s₀)))) := by fun_prop
  show ContinuousOn (fun τ => Real.exp (-(D.σ * (τ - s₀))) • ev.E τ s₀ f₀) (Ici s₀)
  exact he.continuousOn.smul h1

section Representative

variable {s₀ : ℝ} {f₀ : X}

theorem psi_ae
    (hf₀ : ∀ᵐ τ, s₀ < τ →
      Xval (ev.E τ s₀ f₀) =ᵐ[volume] Real.exp (D.σ * (τ - s₀)) • D.bstar τ) :
    ∀ᵐ τ, s₀ < τ → Xval (psi D ev s₀ f₀ τ) =ᵐ[volume] D.bstar τ := by
  filter_upwards [hf₀] with τ hτ hlt
  have h1 := hτ hlt
  have h2 := Xval_smul_ae (Real.exp (-(D.σ * (τ - s₀)))) (ev.E τ s₀ f₀)
  filter_upwards [h1, h2] with y hy1 hy2
  unfold psi
  rw [hy2, Pi.smul_apply, hy1, Pi.smul_apply, smul_smul, ← Real.exp_add, neg_add_cancel,
    Real.exp_zero, one_smul]

variable (hD : IsUnstableBackground D) (hev : IsEvolution D c S ev)
  (hf₀ : ∀ᵐ τ, s₀ < τ →
    Xval (ev.E τ s₀ f₀) =ᵐ[volume] Real.exp (D.σ * (τ - s₀)) • D.bstar τ)
include hD hev hf₀

theorem psi_add_period {τ : ℝ} (hτ : s₀ < τ) :
    psi D ev s₀ f₀ (τ + D.period) = psi D ev s₀ f₀ τ := by
  have hT := hD.1.period_pos
  have hae := psi_ae hf₀
  have hae' : ∀ᵐ t, s₀ < t + D.period →
      Xval (psi D ev s₀ f₀ (t + D.period)) =ᵐ[volume] D.bstar (t + D.period) :=
    (measurePreserving_add_right volume D.period).quasiMeasurePreserving.ae hae
  have hper := hD.2.graph.value.periodic
  have heq : (fun t => psi D ev s₀ f₀ (t + D.period)) =ᵐ[volume.restrict (Ioi s₀)]
      psi D ev s₀ f₀ := by
    rw [EventuallyEq, ae_restrict_iff' measurableSet_Ioi]
    filter_upwards [hae, hae'] with t h1 h2 ht
    have ht' : s₀ < t := ht
    apply Xclass_injective
    apply Lp.ext
    have e1 := h2 (by linarith)
    have e2 := h1 ht'
    rw [hper t] at e1
    exact e1.trans e2.symm
  have hc1 : ContinuousOn (fun t => psi D ev s₀ f₀ (t + D.period)) (Ioi s₀) := by
    refine (psi_continuousOn hev s₀ f₀).comp (Continuous.continuousOn (by fun_prop)) ?_
    intro t ht
    have ht' : s₀ < t := ht
    show s₀ ≤ t + D.period
    linarith
  have hc2 : ContinuousOn (psi D ev s₀ f₀) (Ioi s₀) :=
    (psi_continuousOn hev s₀ f₀).mono Ioi_subset_Ici_self
  exact Measure.eqOn_open_of_ae_eq heq isOpen_Ioi hc1 hc2 hτ

theorem psi_add_nat_period (n : ℕ) {τ : ℝ} (hτ : s₀ < τ) :
    psi D ev s₀ f₀ (τ + n * D.period) = psi D ev s₀ f₀ τ := by
  have hT := hD.1.period_pos
  induction n with
  | zero => simp
  | succ n ih =>
    have h1 : s₀ < τ + n * D.period := by
      have : 0 ≤ (n : ℝ) * D.period := mul_nonneg (Nat.cast_nonneg n) hT.le
      linarith
    rw [show τ + ((n + 1 : ℕ) : ℝ) * D.period = τ + n * D.period + D.period by push_cast; ring,
      psi_add_period hD hev hf₀ h1, ih]

theorem psi_nat_eq {τ : ℝ} {m n : ℕ} (hm : s₀ < τ + m * D.period)
    (hn : s₀ < τ + n * D.period) :
    psi D ev s₀ f₀ (τ + m * D.period) = psi D ev s₀ f₀ (τ + n * D.period) := by
  rcases le_total m n with h | h
  · obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le h
    subst hk
    rw [show τ + ((m + k : ℕ) : ℝ) * D.period = τ + m * D.period + k * D.period by
      push_cast; ring, psi_add_nat_period hD hev hf₀ k hm]
  · obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le h
    subst hk
    rw [show τ + ((n + k : ℕ) : ℝ) * D.period = τ + n * D.period + k * D.period by
      push_cast; ring, psi_add_nat_period hD hev hf₀ k hn]

theorem btilde_eq (τ : ℝ) (n : ℕ) (hn : s₀ < τ + n * D.period) :
    btilde D ev s₀ f₀ τ = psi D ev s₀ f₀ (τ + n * D.period) :=
  psi_nat_eq hD hev hf₀ (lt_add_idx hD.1.period_pos s₀ τ) hn

theorem btilde_periodic : Function.Periodic (btilde D ev s₀ f₀) D.period := by
  intro τ
  have hT := hD.1.period_pos
  have hm := lt_add_idx hT s₀ τ
  have h1 : s₀ < τ + D.period + idx D.period s₀ τ * D.period := by linarith
  rw [btilde_eq hD hev hf₀ (τ + D.period) _ h1,
    show τ + D.period + (idx D.period s₀ τ : ℝ) * D.period =
      (τ + idx D.period s₀ τ * D.period) + D.period by ring,
    psi_add_period hD hev hf₀ hm]
  rfl

theorem btilde_continuous : Continuous (btilde D ev s₀ f₀) := by
  have hT := hD.1.period_pos
  rw [continuous_iff_continuousAt]
  intro τ₁
  have hU : IsOpen {τ : ℝ | s₀ < τ + idx D.period s₀ τ₁ * D.period} :=
    isOpen_lt continuous_const (by fun_prop)
  have hmem : τ₁ ∈ {τ : ℝ | s₀ < τ + idx D.period s₀ τ₁ * D.period} := lt_add_idx hT s₀ τ₁
  have hcont : ContinuousOn (fun τ => psi D ev s₀ f₀ (τ + idx D.period s₀ τ₁ * D.period))
      {τ : ℝ | s₀ < τ + idx D.period s₀ τ₁ * D.period} := by
    refine (psi_continuousOn hev s₀ f₀).comp (Continuous.continuousOn (by fun_prop)) ?_
    intro τ hτ
    have hτ' : s₀ < τ + idx D.period s₀ τ₁ * D.period := hτ
    show s₀ ≤ τ + idx D.period s₀ τ₁ * D.period
    exact hτ'.le
  have heq : (fun τ => psi D ev s₀ f₀ (τ + idx D.period s₀ τ₁ * D.period))
      =ᶠ[𝓝 τ₁] btilde D ev s₀ f₀ := by
    filter_upwards [hU.mem_nhds hmem] with τ hτ
    exact (btilde_eq hD hev hf₀ τ _ hτ).symm
  exact (hcont.continuousAt (hU.mem_nhds hmem)).congr heq

theorem btilde_generated {s τ : ℝ} (hsτ : s ≤ τ) :
    btilde D ev s₀ f₀ τ =
      Real.exp (-(D.σ * (τ - s))) • ev.E τ s (btilde D ev s₀ f₀ s) := by
  have hT := hD.1.period_pos
  have hs : s₀ < s + idx D.period s₀ s * D.period := lt_add_idx hT s₀ s
  have hτ : s₀ < τ + idx D.period s₀ s * D.period := by linarith
  rw [btilde_eq hD hev hf₀ τ _ hτ, btilde_eq hD hev hf₀ s _ hs]
  unfold psi
  rw [E_apply_law hev hs.le
      (by linarith : s + idx D.period s₀ s * D.period ≤ τ + idx D.period s₀ s * D.period) f₀,
    E_add_nat_mul hev, map_smul, smul_smul, ← Real.exp_add]
  have e : -(D.σ * (τ + idx D.period s₀ s * D.period - s₀)) =
      -(D.σ * (τ - s)) + -(D.σ * (s + idx D.period s₀ s * D.period - s₀)) := by ring
  rw [e]

omit hev in
theorem btilde_ae : ∀ᵐ τ, Xval (btilde D ev s₀ f₀ τ) =ᵐ[volume] D.bstar τ := by
  have hT := hD.1.period_pos
  have hae := psi_ae hf₀
  have hall : ∀ᵐ τ, ∀ n : ℕ, s₀ < τ + n * D.period →
      Xval (psi D ev s₀ f₀ (τ + n * D.period)) =ᵐ[volume] D.bstar (τ + n * D.period) := by
    rw [ae_all_iff]
    intro n
    exact (measurePreserving_add_right volume ((n : ℝ) * D.period)).quasiMeasurePreserving.ae hae
  filter_upwards [hall] with τ hτ
  have h := hτ _ (lt_add_idx hT s₀ τ)
  rw [hD.2.graph.value.periodic.nat_mul _ τ] at h
  exact h

theorem btilde_ne_zero (τ₁ : ℝ) : btilde D ev s₀ f₀ τ₁ ≠ 0 := by
  intro h0
  have hT := hD.1.period_pos
  have hper := btilde_periodic hD hev hf₀
  have hfwd : ∀ τ, τ₁ ≤ τ → btilde D ev s₀ f₀ τ = 0 := by
    intro τ hτ
    rw [btilde_generated hD hev hf₀ hτ, h0, map_zero, smul_zero]
  have hall : ∀ τ, btilde D ev s₀ f₀ τ = 0 := by
    intro τ
    rw [← hper.nat_mul (idx D.period τ₁ τ) τ]
    exact hfwd _ (lt_add_idx hT τ₁ τ).le
  apply hD.2.bstar_nonzero
  apply ae_restrict_of_ae
  apply ae_eq_zero_of_ae_ae hD.2.graph.value.measurable
  filter_upwards [btilde_ae hD hf₀] with τ hτ
  refine hτ.symm.trans ?_
  rw [hall τ]
  exact Xval_zero_ae

theorem btilde_symmetric (τ : ℝ) : IsAxisymmetricNoSwirl (Xval (btilde D ev s₀ f₀ τ)) := by
  refine forall_isAxisymmetricNoSwirl_of_ae (b := fun t => Xclass (btilde D ev s₀ f₀ t))
    (continuous_Xclass.comp (btilde_continuous hD hev hf₀)) ?_ τ
  filter_upwards [btilde_ae hD hf₀, hD.2.bstar_symmetric] with t h1 h2
  exact isAxisymmetricNoSwirl_congr h1.symm h2

theorem isRegularModeX_btilde : IsRegularModeX D ev (btilde D ev s₀ f₀) where
  continuous := btilde_continuous hD hev hf₀
  periodic := btilde_periodic hD hev hf₀
  represents := btilde_ae hD hf₀
  generated := fun _ _ h => btilde_generated hD hev hf₀ h
  no_zero_phase := fun τ h =>
    btilde_ne_zero hD hev hf₀ τ (Xclass_injective (h.trans Xclass_zero.symm))
  symmetric := btilde_symmetric hD hev hf₀

end Representative

/-- **`b_* ∈ C_per H¹`, generated by `E`, no zero phase** (tex lines 308–318 and 325–326,
B1009, B1010, first half of B1012), from the identification hypothesis alone. -/
theorem exists_regularModeX (hD : IsUnstableBackground D) (hev : IsEvolution D c S ev)
    (hgen : ModeGeneratedBy D ev) : ∃ b : ℝ → X, IsRegularModeX D ev b := by
  obtain ⟨s₀, f₀, hf₀⟩ := hgen
  exact ⟨btilde D ev s₀ f₀, isRegularModeX_btilde hD hev hf₀⟩

/-! ## The `Z`-valued representative (lines 318–324) -/

/-- `b̂(τ) = e^{-σ𝒯} E(τ,τ-𝒯) b(τ-𝒯) ∈ Z`: start one period earlier and smooth (line 319). -/
def bhatOf (D : BackgroundData) (ev : Evolution) (b : ℝ → X) (τ : ℝ) : Z :=
  Real.exp (-(D.σ * D.period)) • ev.EZ τ (τ - D.period) (b (τ - D.period))

theorem ιZ_bhatOf {b : ℝ → X} (hT : 0 < D.period) (hev : IsEvolution D c S ev)
    (hb : IsRegularModeX D ev b) (τ : ℝ) : ιZ (bhatOf D ev b τ) = b τ := by
  unfold bhatOf
  rw [map_smul, EZ_apply hev (by linarith : τ - D.period < τ)]
  have h := hb.generated (τ - D.period) τ (by linarith)
  rw [sub_sub_cancel] at h
  exact h.symm

/-- **`b_* ∈ C_per H²`** (`loc:eq:mode-regularity`, B1011): the lift of an `X`-representative
is a regular mode, given strong continuity of `E` on `Z`. -/
theorem isRegularMode_bhatOf {b : ℝ → X} (hT : 0 < D.period) (hev : IsEvolution D c S ev)
    (hb : IsRegularModeX D ev b) (hZ : EvolutionZContinuity ev) :
    IsRegularMode D ev (bhatOf D ev b) where
  continuous := by
    rw [continuous_iff_continuousAt]
    intro τ₁
    have hlt : τ₁ - D.period < τ₁ := by linarith
    have heq : (fun τ => Real.exp (-(D.σ * (τ - (τ₁ - D.period)))) •
        ev.EZ τ (τ₁ - D.period) (ιZ (bhatOf D ev b (τ₁ - D.period))))
          =ᶠ[𝓝 τ₁] bhatOf D ev b := by
      filter_upwards [isOpen_Ioi.mem_nhds hlt] with τ hτ
      have hτ' : τ₁ - D.period < τ := hτ
      apply ιZ_injective
      rw [map_smul, EZ_apply hev hτ', ιZ_bhatOf hT hev hb, ιZ_bhatOf hT hev hb]
      exact (hb.generated (τ₁ - D.period) τ hτ'.le).symm
    have he : Continuous (fun τ : ℝ => Real.exp (-(D.σ * (τ - (τ₁ - D.period))))) := by
      fun_prop
    have hc : ContinuousAt (fun τ => Real.exp (-(D.σ * (τ - (τ₁ - D.period)))) •
        ev.EZ τ (τ₁ - D.period) (ιZ (bhatOf D ev b (τ₁ - D.period)))) τ₁ :=
      he.continuousAt.smul
        ((hZ (τ₁ - D.period) (bhatOf D ev b (τ₁ - D.period))).continuousAt
          (isOpen_Ioi.mem_nhds hlt))
    exact hc.congr heq
  periodic := fun τ => ιZ_injective (by
    rw [ιZ_bhatOf hT hev hb, ιZ_bhatOf hT hev hb, hb.periodic τ])
  represents := by
    filter_upwards [hb.represents] with τ hτ
    have h : Zval (bhatOf D ev b τ) = Xval (b τ) := by
      rw [← Xval_ιZ, ιZ_bhatOf hT hev hb]
    rw [h]
    exact hτ
  generated := fun s τ hsτ => by
    rw [ιZ_bhatOf hT hev hb, ιZ_bhatOf hT hev hb]
    exact hb.generated s τ hsτ
  no_zero_phase := fun τ => by
    rw [← Xclass_ιZ, ιZ_bhatOf hT hev hb]
    exact hb.no_zero_phase τ
  symmetric := fun τ => by
    rw [← Xval_ιZ, ιZ_bhatOf hT hev hb]
    exact hb.symmetric τ

/-- The step for one package and one evolution, from the identification. -/
theorem exists_regularMode (hD : IsUnstableBackground D) (hc : IsCoefficients D c)
    (hS : IsFreeEvolution D.h S) (hev : IsEvolution D c S ev)
    (hgen : ModeGeneratedByL2 D ev) : ∃ bhat : ℝ → Z, IsRegularMode D ev bhat := by
  obtain ⟨b, hb⟩ := exists_regularModeX hD hev (modeGeneratedBy_of_L2 hS hev hgen)
  exact ⟨bhatOf D ev b, isRegularMode_bhatOf hD.1.period_pos hev hb
    (evolutionZContinuity_of hD hc hS hev)⟩

/-! ## The step -/

/-- **Step L4** `ModeRegularityStep` (tex lines 307–329; units B1009, B1010, B1011), proved
from the one missing theorem `ModeIdentificationHyp` (B1009 + B1010: `e^{στ} b_*` is the
solution generated by `E`). The strong continuity of `E` on `Z` (B1011) is proved
(`evolutionZContinuity_of`). -/
theorem modeRegularityStep_of (hgen : ModeIdentificationHyp) : ModeRegularityStep := by
  intro D hD c S ev hc hS hev
  exact exists_regularMode hD hc hS hev (hgen D hD c S ev hc hS hev)

/-! ## The identification hypothesis is not stronger than the step -/

/-- A regular mode is generated by `E` in the sense of `ModeGeneratedByL2` (with `s₀ = 0` and
`F₀ = ι_X ι_Z b̂(0)`). -/
theorem modeGeneratedByL2_of_regularMode {bhat : ℝ → Z} (hev : IsEvolution D c S ev)
    (h : IsRegularMode D ev bhat) : ModeGeneratedByL2 D ev := by
  refine ⟨0, ιX (ιZ (bhat 0)), ?_⟩
  filter_upwards [h.represents] with τ hτ hpos
  have hg := h.generated 0 τ hpos.le
  have hE : ev.EL τ 0 (ιX (ιZ (bhat 0))) = Real.exp (D.σ * (τ - 0)) • ιZ (bhat τ) := by
    rw [EL_apply hev hpos, hg, smul_smul, ← Real.exp_add, add_neg_cancel, Real.exp_zero,
      one_smul]
  rw [hE]
  refine (Xval_smul_ae _ _).trans ?_
  rw [Xval_ιZ]
  filter_upwards [hτ] with y hy
  rw [Pi.smul_apply, Pi.smul_apply, hy]

/-- `ModeRegularityStep` implies `ModeIdentificationHyp`: the named hypothesis is a
consequence of the step, so assuming it does not strengthen the manuscript's claim. -/
theorem modeIdentificationHyp_of_step (h : ModeRegularityStep) : ModeIdentificationHyp := by
  intro D hD c S ev hc hS hev
  obtain ⟨bhat, hb⟩ := h D hD c S ev hc hS hev
  exact modeGeneratedByL2_of_regularMode hev hb

/-- **The step is exactly the identification** (lines 307–329): `ModeRegularityStep` holds
if and only if `e^{στ} b_*` is generated by `E` from an `L²_div` datum. -/
theorem modeRegularityStep_iff : ModeRegularityStep ↔ ModeIdentificationHyp :=
  ⟨modeIdentificationHyp_of_step, modeRegularityStep_of⟩

end UnforcedLeray.Blueprint.L04
