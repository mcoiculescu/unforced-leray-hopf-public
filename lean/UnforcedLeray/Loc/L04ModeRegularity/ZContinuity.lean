import UnforcedLeray.Blueprint.Localization.Linear
import UnforcedLeray.Loc.L03Evolution.Abstract
import UnforcedLeray.Loc.L03Evolution.ZContinuity

/-!
# L4 helper: `E` is strongly continuous on `Z`, and the `L²` form of "generated by `E`"

`paper/main.tex` lines 299–306 (the evolution `E(τ,s)`, blueprint unit B0713) and 318–324
("Starting one period earlier and applying the two smoothing estimates proves
`b_* ∈ C_per H²`", blueprint unit B1011). The `Z`-valued representative of the mode needs
`τ ↦ E(τ,s) g` continuous into `Z = H²_div` for `g ∈ Z` and `τ > s`. `IsEvolution` records
strong continuity on `X` only. This file proves the `Z`-continuity for every `E` satisfying
`IsEvolution` (`evolutionZContinuity_of`), with no further hypothesis:

1. **`S₀` is bounded on `Z` for short times** (`free_Zbound`). From the Duhamel formula at
   `s = 0`, `S₀(t) g = E(t,0) g - ∫_0^t S₀(t-r) 𝓑_*(r) E(r,0) g dr`. Tested against
   `ι_Z^* x` (`x ∈ X`), the first term is bounded by the strip bound `‖E_Z(t,0) ι_Z‖ ≤ K` of
   `IsEvolution`, and the integrand equals `⟪ι_Z^* x, S₀^{X→Z}(t-r) 𝓑_*^{Z→X}(r) E_Z(r,0) g⟫_Z`,
   bounded by `‖ι_Z^* x‖ C (t-r)^{-1/2} β K ‖g‖` (lines 297–304). Since `ι_Z^*(X)` is dense in
   `Z`, `‖S₀(t) g‖_Z ≤ (K + 2CβK) ‖g‖_Z`. This is the hypothesis `FreeEvolutionZBound` of
   `Loc/L03Evolution.lean`, here derived from the existence of the evolution.
2. **`S₀` is strongly continuous on `Z` at `0`**, by
   `Loc/L03Evolution/ZContinuity.lean` (`tendsto_S0Z_of_bound`).
3. **Volterra construction and uniqueness.** The `X`-level and `Z`-level Volterra problems of
   line 300 (`Infra/VolterraEvolution.lean`) have evolutions `V`, `V_Z`; `V_Z` is strongly
   continuous on `Z` (`continuousOn_evolution`), and `ι_Z V_Z = V ι_Z` (`intertwine`). By
   uniqueness of strip solutions of the Volterra equation (`eq_evolution_of_volterra`), every
   `E` with `IsEvolution` equals `V` (`evolution_eq_volterra`), hence
   `E_Z(τ,s) ι_Z = V_Z(τ,s)` for `τ > s`.

It also proves `E(τ,r) E_L(r,s) = E_L(τ,s)` (`E_EL`), used to start the mode from an `L²`
datum (lines 309–318: the mode has a continuous `L²` representative).
-/

set_option autoImplicit false

noncomputable section

open Set MeasureTheory Filter
open scoped ENNReal Topology

namespace UnforcedLeray.Blueprint.L04

open SobolevGraph
open UnforcedLeray.Infra.VolterraEvolution
open UnforcedLeray.Loc.L03Evolution (S0ZZ S0ZZ_of_pos S0ZZ_of_nonpos free_bounds
  exists_norm_le_of_periodic continuousOn_S0L continuousOn_S0Z continuousOn_S0ZZ S0_comp_S0 S0_comp_S0L
  S0ZZ_comp_S0ZZ S0ZZ_comp_S0Z ιZ_S0ZZ ιZ_comp_S0Z S0L_comp_ιX intertwine tendsto_S0Z_of_bound
  ιZadj dense_range_ιZadj denseRange_ιX)

/-! ## Class maps -/

theorem Xclass_injective : Function.Injective Xclass := by
  intro f g h
  have h1 : f.toH1 = g.toH1 := H1.value_injective h
  exact Subtype.ext h1

theorem Xclass_smul (a : ℝ) (f : X) : Xclass (a • f) = a • Xclass f := rfl

theorem Xclass_zero : Xclass (0 : X) = 0 := by
  simpa using Xclass_smul 0 0

theorem continuous_Xclass : Continuous Xclass := by
  show Continuous (fun f : X => (H1.valueCLM.comp Xincl) f)
  exact (H1.valueCLM.comp Xincl).continuous

theorem ιZ_injective : Function.Injective ιZ := by
  intro f g h
  have h1 : Zclass f = Zclass g := by
    rw [← Xclass_ιZ, ← Xclass_ιZ, h]
  exact Subtype.ext (H2.value_injective h1)

theorem Xval_smul_ae (a : ℝ) (f : X) : Xval (a • f) =ᵐ[volume] a • Xval f := by
  unfold Xval
  rw [Xclass_smul]
  exact Lp.coeFn_smul _ _

theorem Xval_zero_ae : Xval (0 : X) =ᵐ[volume] 0 := by
  unfold Xval
  rw [Xclass_zero]
  exact Lp.coeFn_zero _ _ _

/-! ## A Hilbert-space bound by duality on a dense set -/

/-- If `|⟪φ, z⟫| ≤ A ‖φ‖` for `φ` in a dense set, then `‖z‖ ≤ A`. -/
theorem norm_le_of_dense_inner {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {s : Set H} (hs : Dense s) {z : H} {A : ℝ} (hA : 0 ≤ A)
    (h : ∀ φ ∈ s, |inner ℝ φ z| ≤ A * ‖φ‖) : ‖z‖ ≤ A := by
  have hclosed : IsClosed {φ : H | |inner ℝ φ z| ≤ A * ‖φ‖} :=
    isClosed_le (continuous_id.inner continuous_const).abs (continuous_const.mul continuous_norm)
  have hz : |inner ℝ z z| ≤ A * ‖z‖ := closure_minimal h hclosed (hs z)
  rw [real_inner_self_eq_norm_sq, abs_of_nonneg (sq_nonneg _)] at hz
  rcases (norm_nonneg z).eq_or_lt with h0 | hpos
  · rw [← h0]
    exact hA
  · nlinarith

/-! ## Evolution identities -/

variable {D : BackgroundData} {c : Coefficients} {S : FreeEvolution} {ev : Evolution}

theorem E_apply_law (hev : IsEvolution D c S ev) {s r τ : ℝ} (h1 : s ≤ r) (h2 : r ≤ τ)
    (f : X) : ev.E τ s f = ev.E τ r (ev.E r s f) := by
  rw [← hev.law s r τ h1 h2]
  rfl

theorem EZ_apply (hev : IsEvolution D c S ev) {s τ : ℝ} (h : s < τ) (f : X) :
    ιZ (ev.EZ τ s f) = ev.E τ s f := by
  rw [← hev.EZ_compat s τ h]
  rfl

theorem EL_apply (hev : IsEvolution D c S ev) {s τ : ℝ} (h : s < τ) (f : X) :
    ev.EL τ s (ιX f) = ev.E τ s f := by
  rw [← hev.EL_compat s τ h]
  rfl

/-- `E(τ,r) E_L(r,s) = E_L(τ,s)` for `s < r ≤ τ`: both sides agree on the dense subspace
`ι_X(X) ⊂ L²_div` by the evolution law. -/
theorem E_EL (hS : IsFreeEvolution D.h S) (hev : IsEvolution D c S ev) {s r τ : ℝ}
    (hsr : s < r) (hrτ : r ≤ τ) (F : L2div) :
    ev.E τ r (ev.EL r s F) = ev.EL τ s F := by
  have h : ⇑((ev.E τ r).comp (ev.EL r s)) = ⇑(ev.EL τ s) := by
    refine (denseRange_ιX hS).equalizer ((ev.E τ r).comp (ev.EL r s)).continuous
      (ev.EL τ s).continuous (funext fun f => ?_)
    simp only [Function.comp_apply, ContinuousLinearMap.comp_apply]
    rw [EL_apply hev hsr, EL_apply hev (hsr.trans_le hrτ)]
    exact (E_apply_law hev hsr.le hrτ f).symm
  exact congrFun h F

/-! ## Step 1: `S₀` is bounded on `Z` for short times -/

/-- **`‖S₀(t)‖_{Z→Z} ≤ A` for `0 < t ≤ 1`**, derived from the evolution: the Duhamel formula
at `s = 0` (line 299), the strip bound `‖E_Z(t,0) ι_Z‖ ≤ K` (line 302), the smoothing
`‖S₀(t)‖_{X→Z} ≤ C t^{-1/2}` (line 298) and `𝓑_* ∈ C_per 𝓛(Z,X)` (line 290), tested
against the dense set `ι_Z^*(X) ⊂ Z`. -/
theorem free_Zbound (hD : IsUnstableBackground D) (hc : IsCoefficients D c)
    (hS : IsFreeEvolution D.h S) (hev : IsEvolution D c S ev) :
    ∃ A : ℝ, ∀ t, 0 < t → t ≤ 1 → ‖(S.S0Z t).comp ιZ‖ ≤ A := by
  have hP : 0 < D.period := hD.1.period_pos
  obtain ⟨K, hK⟩ := hev.strip_bounds 1 one_pos
  have hK0 : 0 ≤ K :=
    (norm_nonneg _).trans ((hK 0 1 zero_le_one (by norm_num)).2 one_pos).2.2
  have hEZ : ∀ r, 0 < r → r ≤ 1 → ∀ g : Z, ‖ev.EZ r 0 (ιZ g)‖ ≤ K * ‖g‖ := by
    intro r hr hr1 g
    have hb := ((hK 0 r hr.le (by linarith)).2 hr).2.2
    have h1 := ((ev.EZ r 0).comp ιZ).le_opNorm g
    rw [ContinuousLinearMap.comp_apply] at h1
    exact h1.trans (mul_le_mul_of_nonneg_right hb (norm_nonneg _))
  obtain ⟨C, hC, -, -, hS0Z⟩ := free_bounds hS
  obtain ⟨β, hβ⟩ := exists_norm_le_of_periodic hP.ne' hc.BZ_periodic hc.BZ_continuous
  have hβ0 : 0 ≤ β := (norm_nonneg _).trans (hβ 0)
  have hA0 : 0 ≤ K + 2 * (C * β * K) := by positivity
  refine ⟨K + 2 * (C * β * K), fun t ht ht1 =>
    ContinuousLinearMap.opNorm_le_bound _ hA0 fun g => ?_⟩
  rw [ContinuousLinearMap.comp_apply]
  have hdense : Dense (Set.range ιZadj) := by
    have : DenseRange ιZadj := Metric.denseRange_iff.mpr fun u r hr => by
      obtain ⟨x, hx⟩ := dense_range_ιZadj u hr
      exact ⟨x, by rwa [dist_eq_norm]⟩
    exact this
  refine norm_le_of_dense_inner hdense (by positivity) ?_
  rintro _ ⟨x, rfl⟩
  have hadj : ∀ w : Z, inner ℝ (ιZadj x) w = inner ℝ x (ιZ w) := fun w =>
    ContinuousLinearMap.adjoint_inner_left ιZ w x
  -- the Duhamel formula at `s = 0`
  set F : ℝ → X := fun r => S.S0L (t - r) (c.B r (ev.E r 0 (ιZ g))) with hFdef
  have hduh : ev.E t 0 (ιZ g) = S.S0 t (ιZ g) + ∫ r in Ioo 0 t, F r := by
    have h := hev.duhamel 0 t ht.le (ιZ g)
    rw [sub_zero] at h
    exact h
  have hFint : IntegrableOn F (Ioo 0 t) := hev.duhamel_integrable 0 t ht.le (ιZ g)
  have hsplit : ιZ (S.S0Z t (ιZ g)) = ιZ (ev.EZ t 0 (ιZ g)) - ∫ r in Ioo 0 t, F r := by
    rw [← ContinuousLinearMap.comp_apply ιZ, ιZ_comp_S0Z hS ht, EZ_apply hev ht, hduh]
    abel
  have hinner : inner ℝ (ιZadj x) (S.S0Z t (ιZ g)) =
      inner ℝ (ιZadj x) (ev.EZ t 0 (ιZ g)) - ∫ r in Ioo 0 t, inner ℝ x (F r) := by
    rw [hadj, hsplit, inner_sub_right, integral_inner hFint, hadj]
  -- the first term
  have hfirst : |inner ℝ (ιZadj x) (ev.EZ t 0 (ιZ g))| ≤ ‖ιZadj x‖ * (K * ‖g‖) :=
    (abs_real_inner_le_norm _ _).trans
      (mul_le_mul_of_nonneg_left (hEZ t ht ht1 g) (norm_nonneg _))
  -- the integrand
  set M : ℝ := ‖ιZadj x‖ * (C * β * K * ‖g‖) with hM
  have hpt : ∀ r ∈ Ioo 0 t, ‖inner ℝ x (F r)‖ ≤ M * (t - r) ^ (-(1 / 2 : ℝ)) := by
    intro r hr
    have htr : 0 < t - r := sub_pos.2 hr.2
    have htr1 : t - r ≤ 1 := by linarith [hr.1]
    have hFr : F r = ιZ (S.S0Z (t - r) (c.BZ r (ev.EZ r 0 (ιZ g)))) := by
      simp only [hFdef]
      rw [← EZ_apply hev hr.1, ← hc.BZ_compat r, ← ContinuousLinearMap.comp_apply (S.S0L (t - r)),
        S0L_comp_ιX hS htr, ← ContinuousLinearMap.comp_apply ιZ, ιZ_comp_S0Z hS htr]
    rw [hFr, ← hadj, Real.norm_eq_abs]
    refine (abs_real_inner_le_norm _ _).trans ?_
    have h1 : ‖S.S0Z (t - r) (c.BZ r (ev.EZ r 0 (ιZ g)))‖ ≤
        C * (t - r) ^ (-(1 / 2 : ℝ)) * (β * (K * ‖g‖)) := by
      refine ((S.S0Z (t - r)).le_opNorm _).trans
        (mul_le_mul (hS0Z (t - r) htr htr1) ?_ (norm_nonneg _) (by positivity))
      exact ((c.BZ r).le_opNorm _).trans
        (mul_le_mul (hβ r) (hEZ r hr.1 (by linarith [hr.2]) g) (norm_nonneg _) hβ0)
    calc ‖ιZadj x‖ * ‖S.S0Z (t - r) (c.BZ r (ev.EZ r 0 (ιZ g)))‖
        ≤ ‖ιZadj x‖ * (C * (t - r) ^ (-(1 / 2 : ℝ)) * (β * (K * ‖g‖))) :=
          mul_le_mul_of_nonneg_left h1 (norm_nonneg _)
      _ = M * (t - r) ^ (-(1 / 2 : ℝ)) := by rw [hM]; ring
  -- the kernel integral
  have hkint : IntegrableOn (fun r : ℝ => (t - r) ^ (-(1 / 2 : ℝ))) (Ioo 0 t) :=
    (intervalIntegrable_iff_integrableOn_Ioo_of_le ht.le).mp
      (UnforcedLeray.Infra.VolterraEvolution.intervalIntegrable_kernel t 0 t)
  have hkval : ∫ r in Ioo 0 t, (t - r) ^ (-(1 / 2 : ℝ)) = 2 * t ^ (1 / 2 : ℝ) := by
    rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le ht.le,
      UnforcedLeray.Infra.VolterraEvolution.integral_kernel, sub_zero]
  have ht12 : t ^ (1 / 2 : ℝ) ≤ 1 := Real.rpow_le_one ht.le ht1 (by norm_num)
  have hM0 : 0 ≤ M := by positivity
  have hsecond : |∫ r in Ioo 0 t, inner ℝ x (F r)| ≤ M * 2 := by
    rw [← Real.norm_eq_abs]
    refine (norm_integral_le_of_norm_le (hkint.const_mul M) ?_).trans ?_
    · filter_upwards [ae_restrict_mem measurableSet_Ioo] with r hr
      exact hpt r hr
    · rw [integral_const_mul, hkval]
      nlinarith
  rw [hinner]
  have e1 := abs_le.mp hfirst
  have e2 := abs_le.mp hsecond
  refine abs_le.mpr ⟨?_, ?_⟩
  · have : M * 2 = ‖ιZadj x‖ * (2 * (C * β * K) * ‖g‖) := by rw [hM]; ring
    nlinarith [norm_nonneg (ιZadj x)]
  · have : M * 2 = ‖ιZadj x‖ * (2 * (C * β * K) * ‖g‖) := by rw [hM]; ring
    nlinarith [norm_nonneg (ιZadj x)]

/-! ## Steps 2–3: Volterra construction, uniqueness, `Z`-continuity -/

/-- **Uniqueness of the evolution** (lines 299–300): every `E` satisfying `IsEvolution` is the
Volterra evolution of `(S₀, S₀^{L²→X}, 𝓑_*)`. -/
theorem evolution_eq_volterra (hev : IsEvolution D c S ev) (V : VolterraData ℝ X L2div)
    (hVc : V.Compatible) (hVS₀ : V.S₀ = S.S0) (hVS : V.S = S.S0L) (hVB : V.B = c.B) :
    ∀ s τ, s ≤ τ → ev.E τ s = V.evolution τ s :=
  VolterraData.eq_evolution_of_volterra hVc ev.E
    (fun s x => (hev.strongly_continuous x).comp
      (continuous_id.prodMk continuous_const).continuousOn (fun τ hτ => hτ.1))
    (fun s τ hτ x => by
      rw [hVS₀, hVS, hVB, intervalIntegral.integral_of_le hτ.1, integral_Ioc_eq_integral_Ioo]
      exact hev.duhamel s τ hτ.1 x)
    hev.law

/-- `E` is strongly continuous on `Z = H²_div` after the initial time: for `g ∈ Z`, the
smoothing lift `τ ↦ E_Z(τ,s) ι_Z g ∈ Z` is continuous on `τ > s`. -/
def EvolutionZContinuity (ev : Evolution) : Prop :=
  ∀ (s : ℝ) (g : Z), ContinuousOn (fun τ => ev.EZ τ s (ιZ g)) (Ioi s)

/-- **Strong continuity of `E` on `Z`** (lines 299–306, used at lines 318–324 for
`b_* ∈ C_per H²`; B0713, B1011), for every `E` satisfying `IsEvolution`. -/
theorem evolutionZContinuity_of (hD : IsUnstableBackground D) (hc : IsCoefficients D c)
    (hS : IsFreeEvolution D.h S) (hev : IsEvolution D c S ev) : EvolutionZContinuity ev := by
  have hh : 0 < D.h := hD.1.h_pos
  have hP : 0 < D.period := hD.1.period_pos
  obtain ⟨C, -, hS0, hS0L, hS0Z⟩ := free_bounds hS
  obtain ⟨β, hβ⟩ := exists_norm_le_of_periodic hP.ne' hc.B_periodic hc.B_continuous
  obtain ⟨βZ, hβZ⟩ := exists_norm_le_of_periodic hP.ne' hc.BZ_periodic hc.BZ_continuous
  obtain ⟨CZ, hCZ⟩ := free_Zbound hD hc hS hev
  have hZc := tendsto_S0Z_of_bound hS hh.le ⟨CZ, hCZ⟩
  have hZZ : ∀ t, 0 ≤ t → t ≤ 1 → ‖S0ZZ S t‖ ≤ max CZ 1 := by
    intro t ht ht1
    rcases eq_or_lt_of_le ht with h0 | hpos
    · rw [← h0, S0ZZ_of_nonpos S le_rfl]
      exact ContinuousLinearMap.norm_id_le.trans (le_max_right _ _)
    · rw [S0ZZ_of_pos S hpos]
      exact (hCZ t hpos ht1).trans (le_max_left _ _)
  obtain ⟨V, hVS₀, hVS, hVB⟩ : ∃ V : VolterraData ℝ X L2div,
      V.S₀ = S.S0 ∧ V.S = S.S0L ∧ V.B = c.B :=
    ⟨{ S₀ := S.S0
       S := S.S0L
       B := c.B
       M₀ := C
       C₀ := C
       β := β
       norm_S₀_le := fun t ht _ => hS0 t ht
       norm_S_le := hS0L
       norm_B_le := hβ
       continuousOn_S₀ := fun x => (hS.strongly_continuous x).mono Icc_subset_Ici_self
       continuousOn_S := fun y => (continuousOn_S0L hS hh.le y).mono fun t ht => ht.1
       continuous_B := fun x => hc.B_continuous.clm_apply continuous_const }, rfl, rfl, rfl⟩
  obtain ⟨VZ, hZS₀, hZS, hZB⟩ : ∃ VZ : VolterraData ℝ Z X,
      VZ.S₀ = S0ZZ S ∧ VZ.S = S.S0Z ∧ VZ.B = c.BZ :=
    ⟨{ S₀ := S0ZZ S
       S := S.S0Z
       B := c.BZ
       M₀ := max CZ 1
       C₀ := C
       β := βZ
       norm_S₀_le := hZZ
       norm_S_le := hS0Z
       norm_B_le := hβZ
       continuousOn_S₀ := continuousOn_S0ZZ hS hh.le hZc
       continuousOn_S := fun y => (continuousOn_S0Z hS hh.le y).mono fun t ht => ht.1
       continuous_B := fun g => hc.BZ_continuous.clm_apply continuous_const }, rfl, rfl, rfl⟩
  have hVc : V.Compatible :=
    ⟨fun a b ha hb _ => by rw [hVS₀]; exact S0_comp_S0 hS hh.le ha hb,
      fun a b ha hb _ => by rw [hVS₀, hVS]; exact S0_comp_S0L hS hh.le ha hb⟩
  have hVZc : VZ.Compatible :=
    ⟨fun a b ha hb _ => by rw [hZS₀]; exact S0ZZ_comp_S0ZZ hS hh.le ha hb,
      fun a b ha hb _ => by rw [hZS₀, hZS]; exact S0ZZ_comp_S0Z hS hh.le ha hb⟩
  have huniq := evolution_eq_volterra hev V hVc hVS₀ hVS hVB
  have hint : ∀ s τ, s ≤ τ → ∀ g, ιZ (VZ.evolution τ s g) = V.evolution τ s (ιZ g) := by
    refine intertwine VZ hVZc V hVc ιZ (fun t ht _ w => ?_) (fun t r ht _ w => ?_)
    · rw [hZS₀, hVS₀]
      exact ιZ_S0ZZ hS ht w
    · rw [hZS, hZB, hVS, hVB, ← hc.BZ_compat r w, ← ContinuousLinearMap.comp_apply ιZ,
        ιZ_comp_S0Z hS ht, ← ContinuousLinearMap.comp_apply (S.S0L t), S0L_comp_ιX hS ht]
  intro s g
  refine ((VolterraData.continuousOn_evolution hVZc s g).mono Ioi_subset_Ici_self).congr
    fun τ hτ => ?_
  have hτ' : s < τ := hτ
  apply ιZ_injective
  rw [EZ_apply hev hτ', huniq s τ hτ'.le, hint s τ hτ'.le]

end UnforcedLeray.Blueprint.L04
