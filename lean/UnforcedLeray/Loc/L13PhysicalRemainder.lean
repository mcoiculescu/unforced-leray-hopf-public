import UnforcedLeray.Loc.L13PhysicalRemainder.HeatSolenoidal

/-!
# L13. Physical remainders: `PhysicalRemainderStep`

`paper/main.tex` lines 501–503 (fixed points give solutions, using `j² = j`) and 525–547
(`loc:eq:physical-fields`, `loc:eq:total-field`, the rates of lines 536–540 and the strong
projected equation of lines 546–547). Blueprint units B1022 (fixed points give solutions),
B1025 (symmetry of the fields), B1026 (physical fields), B1028 (heat-plus-remainder form),
B1029 (the rates). The target is `UnforcedLeray.Blueprint.PhysicalRemainderStep`
(`Blueprint/Localization/Realization.lean`, line 80).

## What is proved

`physicalRemainderStep_of` proves `PhysicalRemainderStep` from two named hypotheses, each a
theorem that no compiled module provides:

* `BackgroundStrongForm` (lines 159–168, B0707, B0708): `-𝔓div(U_*⊗U_*)` is a continuous `L²`
  path `N_bg`, and the periodic remainder `r_heat = U_* - H_h[u_dss]` solves
  `∂_τ r = hΔr + ½r + ½y·∇r + N_bg` weakly in space at every phase. (The package states the
  background equation only against spacetime tests; this is its pointwise-in-time form, which
  needs the equation `∂_τH = (hΔ + ½ + ½y·∇)H` of the heat profile and a Du Bois-Reymond
  argument.)
* `EvolutionWeakForm` (lines 293–306, 406–417; INF07, INF08, INF14): a `Z`-continuous mild
  solution `z(τ) = E(τ,s)z(s) + ∫_s^τ E(τ,r)F(r) dr` of the evolution of L3 with a continuous
  `X`-forcing is a weak solution of `∂_τz = 𝓛₀z + 𝓑_*(τ)z + F` with
  `𝓛₀ = hΔ + ½ + ½y·∇` (mild-to-weak regularity).

Everything else in lines 501–547 is proved here and in the helper folder:

* the similarity remainders `R_j = r_heat + j e^{στ}b̂ + e^{βτ}w_j` (lines 517, 536) and the
  nonlinearity `𝒩_j = N_bg + G_* + 𝓑_*(Y) - 𝓒(K_loc,Y) + 𝓝(Y,Y)`, `Y = jv + z_j`, which is
  `-𝔓div(V⊗V)` for `V = H_h[u₀] + R_j = U_* + K_loc + Y` (lines 462–466, using the linearity
  `H_h[u₀] = H_h[u_dss] + H_h[u₀ - u_dss]` from the convergence of the heat integrals);
* the expansion of the quadratic term with `j² = j`: `R_j` solves `∂_τR = 𝓛₀R + 𝒩_j` weakly
  (lines 501–503), from the fixed-point equation `w_j = Bq w_j w_j + L_j w_j + G_j`, the
  specifications of the correction maps, the Green operator's mild formula and the generation
  of the mode by `E`;
* the solenoidality and `𝒪`-invariance of `H_h[u_dss](τ)` and hence of `r_heat(τ)`
  (lines 152, 159–167, 188–189; Fubini with the bound `|u_dss(x)| ≤ C|x|⁻¹`), in
  `L13PhysicalRemainder/HeatSolenoidal.lean` and `L13PhysicalRemainder/Background.lean`;
* the physical fields `ρ_j(t) = t^{-1/2}R_j(·/√t, log t)` in `H²` and
  `N_j(t) = t^{-3/2}𝒩_j(·/√t, log t)`; `-𝔓div(u⊗u) = N_j(t)` for the total field
  `u = e^{htΔ}u₀ + ρ_j(t)` (dilation invariance of the literal `𝔓`);
* the strong equation `∂_tρ_j = hΔρ_j + N_j` in `L²` on `(0, e^{τ₀})` (change of variables in
  the weak equation, then weak-to-strong upgrade), continuity, the rates of line 540,
  solenoidality and `𝒪`-invariance.
-/

set_option autoImplicit false

noncomputable section

open Set MeasureTheory Filter
open scoped ENNReal ContDiff Topology BoundedContinuousFunction

namespace UnforcedLeray.Blueprint.L13

open SobolevGraph
open UnforcedLeray.Loc.L02 (dil dilH2 coeFn_dil norm_dil_apply_le dil_mem_solenoidal)

/-! ## The missing theorems -/

/-- **Missing theorem** (lines 159–168, B0707, B0708): the background equation in strong form.
For every unstable background, `-𝔓div(U_*(τ)⊗U_*(τ))` is an `L²` class `N_bg(τ)` depending
continuously on `τ` (true since `|H_h[u_dss]| ≲ ⟨y⟩⁻¹`, `|∇H_h[u_dss]| ≲ ⟨y⟩⁻²` and
`r_heat ∈ C(H²) ⊂ C(L^∞ ∩ H¹)`), and `r_heat` solves `∂_τ r = hΔr + ½r + ½y·∇r + N_bg` weakly
in space at every phase. It follows from the spacetime weak equation `Ustar_equation`, the
exact equation of the heat profile, and continuity of `r_heat` in `H²`. -/
def BackgroundStrongForm : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D →
    ∃ Nbg : ℝ → L2Space, Continuous Nbg ∧
      (∀ τ, IsMinusLerayDiv (tensorColumns (D.Ustar τ) (D.Ustar τ)) (Nbg τ)) ∧
      IsSimilarityWeakSolution D.h univ D.rheat Nbg

/-- **Missing theorem** (lines 293–306, 406–417; INF07, INF08, INF14): mild solutions of the
evolution of L3 are weak solutions. If `z : ℝ → Z` and `F : ℝ → X` are continuous on
`(-∞, τ₀]` and `z(τ) = E(τ,s)z(s) + ∫_s^τ E(τ,r)F(r) dr` for `s ≤ τ ≤ τ₀` (with integrable
integrand), then `∂_τz = hΔz + ½z + ½y·∇z + 𝓑_*(τ)z + F` weakly in space on `(-∞, τ₀)`,
with `𝓑_*(τ)z = -𝔓div(U_*⊗z + z⊗U_*)` the coefficient of L1. (The free evolution `S₀` is
generated by `hΔ + ½y·∇ + ½`, B0418; `E` is its Duhamel perturbation by `𝓑_*`.) -/
def EvolutionWeakForm : Prop :=
  ∀ (D : BackgroundData) (c : Coefficients) (S : FreeEvolution) (ev : Evolution),
    IsUnstableBackground D → IsCoefficients D c → IsFreeEvolution D.h S →
      IsEvolution D c S ev →
        ∀ (τ₀ : ℝ) (z : ℝ → Z) (F : ℝ → X),
          ContinuousOn z (Iic τ₀) → ContinuousOn F (Iic τ₀) →
          (∀ s τ, s ≤ τ → τ ≤ τ₀ →
            IntegrableOn (fun r => ev.E τ r (F r)) (Ioo s τ) ∧
              ιZ (z τ) = ev.E τ s (ιZ (z s)) + ∫ r in Ioo s τ, ev.E τ r (F r)) →
          IsSimilarityWeakSolution D.h (Iio τ₀) (fun τ => (z τ).toH2)
            (fun τ => Lclass (c.B τ (ιZ (z τ))) + Xclass (F τ))

/-! ## The algebra of `IsMinusLerayDiv` (copied from `Loc/L10Nonlinear/Pairing.lean`) -/

theorem lerayDivPairing_congr {c₁ c₂ : Fin 3 → SpatialField} (h₁ : ColumnsL2 c₁)
    (h : ∀ j, c₁ j =ᵐ[volume] c₂ j) (φ : Space → Space) :
    lerayDivPairing c₁ φ = lerayDivPairing c₂ φ := by
  unfold lerayDivPairing
  congr 1
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [toL2_congr (h₁ j) (h j)]

theorem isMinusLerayDiv_congr {c₁ c₂ : Fin 3 → SpatialField} {F : L2Space}
    (hF : IsMinusLerayDiv c₁ F) (h : ∀ j, c₁ j =ᵐ[volume] c₂ j) : IsMinusLerayDiv c₂ F :=
  ⟨fun j => (memLp_congr_ae (h j)).mp (hF.1 j),
    fun φ hφ => by rw [hF.2 φ hφ, lerayDivPairing_congr hF.1 h]⟩

theorem isMinusLerayDiv_add {c₁ c₂ : Fin 3 → SpatialField} {F₁ F₂ : L2Space}
    (h₁ : IsMinusLerayDiv c₁ F₁) (h₂ : IsMinusLerayDiv c₂ F₂) :
    IsMinusLerayDiv (addColumns c₁ c₂) (F₁ + F₂) := by
  refine ⟨fun j => (h₁.1 j).add (h₂.1 j), fun φ hφ => ?_⟩
  rw [inner_add_left, h₁.2 φ hφ, h₂.2 φ hφ]
  unfold lerayDivPairing addColumns
  have e : ∀ j, toL2 (c₁ j + c₂ j) = toL2 (c₁ j) + toL2 (c₂ j) :=
    fun j => toL2_add' (h₁.1 j) (h₂.1 j)
  simp only [e, inner_add_left, Finset.sum_add_distrib]
  ring

/-! ## Linear maps for the `L²` classes -/

/-- `Lclass` as a bounded operator. -/
def LclassCLM : L2div →L[ℝ] L2Space := Leray.solenoidalSubspace.subtypeL

/-- `Xclass` as a bounded operator. -/
def XclassCLM : X →L[ℝ] L2Space := H1.valueCLM.comp Xincl

theorem Lclass_eq (F : L2div) : Lclass F = LclassCLM F := rfl

theorem Xclass_eq (f : X) : Xclass f = XclassCLM f := rfl

/-! ## The similarity fields (lines 517, 536) -/

/-- `v(τ) = e^{στ} b̂(τ)` (line 492). -/
def modeField (D : BackgroundData) (ld : LinearData) (τ : ℝ) : Z :=
  Real.exp (D.σ * τ) • ld.bhat τ

/-- `Y_j(τ) = j v(τ) + z_j(τ)`, `z_j = e^{βτ} w_j` (`0` after `τ₀`). -/
def corrField (D : BackgroundData) (ld : LinearData) {τ₀ : ℝ} (w : WeightedZ τ₀) (j : Fin 2)
    (τ : ℝ) : Z :=
  jcoef j • modeField D ld τ + unweight ld.sp.β w τ

/-- The similarity remainder `R_j = r_heat + j v + z_j` (line 536) in `H²`. -/
def simRemainder (D : BackgroundData) (ld : LinearData) {τ₀ : ℝ} (w : WeightedZ τ₀)
    (j : Fin 2) (τ : ℝ) : H2 :=
  D.rheat τ + (corrField D ld w j τ).toH2

/-- The similarity nonlinearity `𝒩_j = N_bg + G_* + 𝓑_*(Y) - 𝓒(K_loc, Y) + 𝓝(Y,Y)`, which is
`-𝔓div(V⊗V)` for `V = U_* + K_loc + Y` (lines 464–466, 501–503). -/
def simForcing (D : BackgroundData) (ld : LinearData) (nm : NonlinearMaps)
    (Nbg : ℝ → L2Space) {τ₀ : ℝ} (w : WeightedZ τ₀) (j : Fin 2) (τ : ℝ) : L2Space :=
  Nbg τ + Xclass (nm.Gstar τ) + Lclass (ld.c.B τ (ιZ (corrField D ld w j τ))) -
    Xclass (nm.CK τ (corrField D ld w j τ)) +
    Xclass (nm.N (corrField D ld w j τ) (corrField D ld w j τ))

theorem simRemainder_value (D : BackgroundData) (ld : LinearData) {τ₀ : ℝ} (w : WeightedZ τ₀)
    (j : Fin 2) (τ : ℝ) :
    (simRemainder D ld w j τ).value =
      remainderClass D ld.bhat ld.sp.β w (jcoef j) τ := by
  have hv : ∀ F G : H2, (F + G).value = F.value + G.value := fun _ _ => rfl
  simp only [simRemainder, remainderClass, hv, corrField, modeField]
  change _ + Zclass _ = _
  rw [Zclass_add, Zclass_smul, Zclass_smul, smul_smul, add_assoc]

/-! ## Continuity, bounds, solenoidality and symmetry of the similarity fields -/

section Fields

variable {D : BackgroundData} {ld : LinearData}

theorem continuous_modeField (hld : IsLinearData D ld) : Continuous (modeField D ld) :=
  (Real.continuous_exp.comp (continuous_const.mul continuous_id)).smul hld.mode.continuous

theorem continuousOn_corrField (hld : IsLinearData D ld) {τ₀ : ℝ} (w : WeightedZ τ₀)
    (j : Fin 2) : ContinuousOn (corrField D ld w j) (Iic τ₀) :=
  ((continuous_modeField hld).continuousOn.const_smul (jcoef j)).add
    (continuousOn_unweight _ w)

theorem continuousOn_simRemainder (hD : IsUnstableBackground D) (hld : IsLinearData D ld)
    {τ₀ : ℝ} (w : WeightedZ τ₀) (j : Fin 2) :
    ContinuousOn (simRemainder D ld w j) (Iic τ₀) :=
  hD.1.rheat_continuous.continuousOn.add
    (Zincl.continuous.comp_continuousOn (continuousOn_corrField hld w j))

theorem abs_jcoef_le (j : Fin 2) : |jcoef j| ≤ 1 := by
  fin_cases j <;> simp [jcoef]

theorem jcoef_mul_self (j : Fin 2) : jcoef j * jcoef j = jcoef j := by
  fin_cases j <;> simp [jcoef]

/-- A common bound `‖R_j(τ)‖_{H²} ≤ M` on `(-∞, τ₀]`, `τ₀ ≤ 0`. -/
theorem simRemainder_bound (hD : IsUnstableBackground D) (hld : IsLinearData D ld) {τ₀ : ℝ}
    (hτ₀ : τ₀ ≤ 0) (w : Fin 2 → WeightedZ τ₀) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ j τ, τ ≤ τ₀ → ‖simRemainder D ld (w j) j τ‖ ≤ M := by
  obtain ⟨Mr, hMr⟩ := isBounded_iff_forall_norm_le.mp
    (hD.1.rheat_periodic.isBounded_of_continuous hD.1.period_pos.ne' hD.1.rheat_continuous)
  obtain ⟨Mb, hMb⟩ := isBounded_iff_forall_norm_le.mp
    (hld.mode.periodic.isBounded_of_continuous hD.1.period_pos.ne' hld.mode.continuous)
  have hσ : 0 < D.σ := hD.2.σ_pos
  have hβ : 0 < ld.sp.β := lt_trans hσ hld.splitting.weight_lower
  refine ⟨max Mr 0 + max Mb 0 + (‖w 0‖ + ‖w 1‖), by positivity, fun j τ hτ => ?_⟩
  have hτ0 : τ ≤ 0 := hτ.trans hτ₀
  have h1 : ‖D.rheat τ‖ ≤ max Mr 0 := (hMr _ (mem_range_self τ)).trans (le_max_left _ _)
  have h2 : ‖modeField D ld τ‖ ≤ max Mb 0 := by
    rw [modeField, norm_smul, Real.norm_of_nonneg (Real.exp_pos _).le]
    have he : Real.exp (D.σ * τ) ≤ 1 := Real.exp_le_one_iff.mpr (by nlinarith)
    calc Real.exp (D.σ * τ) * ‖ld.bhat τ‖ ≤ 1 * max Mb 0 :=
          mul_le_mul he ((hMb _ (mem_range_self τ)).trans (le_max_left _ _)) (norm_nonneg _)
            zero_le_one
      _ = max Mb 0 := one_mul _
  have h3 : ‖unweight ld.sp.β (w j) τ‖ ≤ ‖w 0‖ + ‖w 1‖ := by
    have he : Real.exp (ld.sp.β * τ) ≤ 1 := Real.exp_le_one_iff.mpr (by nlinarith)
    have hw : ‖w j‖ ≤ ‖w 0‖ + ‖w 1‖ := by
      fin_cases j
      · simp
      · simp
    calc ‖unweight ld.sp.β (w j) τ‖ ≤ Real.exp (ld.sp.β * τ) * ‖w j‖ := norm_unweight_le _ _ hτ
      _ ≤ 1 * (‖w 0‖ + ‖w 1‖) := mul_le_mul he hw (norm_nonneg _) zero_le_one
      _ = ‖w 0‖ + ‖w 1‖ := one_mul _
  have h4 : ‖corrField D ld (w j) j τ‖ ≤ max Mb 0 + (‖w 0‖ + ‖w 1‖) := by
    unfold corrField
    calc ‖jcoef j • modeField D ld τ + unweight ld.sp.β (w j) τ‖
        ≤ ‖jcoef j • modeField D ld τ‖ + ‖unweight ld.sp.β (w j) τ‖ := norm_add_le _ _
      _ ≤ 1 * max Mb 0 + (‖w 0‖ + ‖w 1‖) := by
          rw [norm_smul, Real.norm_eq_abs]
          exact add_le_add (mul_le_mul (abs_jcoef_le j) h2 (norm_nonneg _) zero_le_one) h3
      _ = max Mb 0 + (‖w 0‖ + ‖w 1‖) := by ring
  calc ‖simRemainder D ld (w j) j τ‖ ≤ ‖D.rheat τ‖ + ‖(corrField D ld (w j) j τ).toH2‖ :=
        norm_add_le _ _
    _ ≤ max Mr 0 + (max Mb 0 + (‖w 0‖ + ‖w 1‖)) := by
        rw [norm_toH2]
        exact add_le_add h1 h4
    _ = max Mr 0 + max Mb 0 + (‖w 0‖ + ‖w 1‖) := by ring

theorem simRemainder_solenoidal (hD : IsUnstableBackground D) {τ₀ : ℝ} (w : WeightedZ τ₀) (j : Fin 2) (τ : ℝ) :
    (simRemainder D ld w j τ).value ∈ Leray.solenoidalSubspace := by
  have hv : ∀ F G : H2, (F + G).value = F.value + G.value := fun _ _ => rfl
  rw [simRemainder, hv]
  have hz : (corrField D ld w j τ).toH2.value ∈ Leray.solenoidalSubspace :=
    Submodule.mem_comap.mp (Z.mem (corrField D ld w j τ))
  exact Submodule.add_mem _ (rheat_solenoidal hD τ) hz

theorem simRemainder_symmetric (hD : IsUnstableBackground D) (hld : IsLinearData D ld) {τ₀ : ℝ} (w : WeightedZ τ₀)
    (hsym : ∀ τ : Iic τ₀, IsAxisymmetricNoSwirl (Zval (w τ))) (j : Fin 2) (τ : ℝ) :
    IsAxisymmetricNoSwirl ((simRemainder D ld w j τ).value : SpatialField) := by
  rw [simRemainder_value]
  unfold remainderClass
  refine isAxisymmetricNoSwirl_add (isAxisymmetricNoSwirl_add (rheat_symmetric hD τ)
    (isAxisymmetricNoSwirl_smul _ (hld.mode.symmetric τ))) ?_
  by_cases hτ : τ ≤ τ₀
  · rw [unweight_of_le _ _ hτ, Zclass_smul]
    exact isAxisymmetricNoSwirl_smul _ (hsym ⟨τ, hτ⟩)
  · have h0 : unweight ld.sp.β w τ = 0 := by simp only [unweight, hτ, ↓reduceDIte]
    rw [h0]
    have hz : Zclass (0 : Z) = 0 := by
      have := Zclass_smul 0 (0 : Z)
      simpa using this
    rw [hz]
    intro g _
    filter_upwards [Lp.coeFn_zero Space 2 (volume : Measure Space),
      g.symm.measurePreserving.quasiMeasurePreserving.ae_eq_comp
        (Lp.coeFn_zero Space 2 (volume : Measure Space))] with x h1 h2
    simp only [Function.comp_apply] at h2
    rw [h1, h2]
    simp

end Fields

/-! ## The nonlinearity `𝒩_j = -𝔓div(V⊗V)` (lines 462–466) -/

theorem simForcing_isMinusLerayDiv {D : BackgroundData} (hD : IsUnstableBackground D)
    {ld : LinearData} (hld : IsLinearData D ld) {u₀ : SpatialField} (hu₀ : IsCompactDatum D u₀)
    {nm : NonlinearMaps} (hnm : IsNonlinearMaps D u₀ nm) {Nbg : ℝ → L2Space}
    (hNw : ∀ τ, IsMinusLerayDiv (tensorColumns (D.Ustar τ) (D.Ustar τ)) (Nbg τ))
    {τ₀ : ℝ} (w : WeightedZ τ₀) (j : Fin 2) {τ : ℝ} (hτ : τ ≤ 0) :
    IsMinusLerayDiv
      (tensorColumns (heatProfile D.h u₀ τ + ((simRemainder D ld w j τ).value : SpatialField))
        (heatProfile D.h u₀ τ + ((simRemainder D ld w j τ).value : SpatialField)))
      (simForcing D ld nm Nbg w j τ) := by
  set Y := corrField D ld w j τ with hYdef
  have h1 := hNw τ
  have h2 := hnm.Gstar_weak τ hτ
  have h3 := hld.coefficients.B_weak τ (ιZ Y)
  have h4 := hnm.CK_weak τ hτ Y
  have h5 := hnm.N_weak Y Y
  rw [Xval_ιZ] at h3
  have hsum := isMinusLerayDiv_add (isMinusLerayDiv_add (isMinusLerayDiv_add
    (isMinusLerayDiv_add h1 h2) h3) h4) h5
  -- `V = U_* + K_loc + Y` almost everywhere
  have hs : 0 < D.h * Real.exp τ := mul_pos hD.1.h_pos (Real.exp_pos τ)
  have hprof : heatProfile D.h u₀ τ = heatProfile D.h D.udss τ + heatTail D u₀ τ := by
    rw [heatTail, ← heatProfile_add (fun x => hD.1.heat_integrable hs x)
      (fun x => hu₀.defect_heat_integrable _ hs x)]
    congr 1
    abel
  have hV : (heatProfile D.h u₀ τ + ((simRemainder D ld w j τ).value : SpatialField))
      =ᵐ[volume] D.Ustar τ + heatTail D u₀ τ + Zval Y := by
    have hv : (simRemainder D ld w j τ).value = (D.rheat τ).value + Zclass Y := rfl
    rw [hv, hprof]
    filter_upwards [Lp.coeFn_add (D.rheat τ).value (Zclass Y),
      hD.1.Ustar_decomposition τ] with x hx1 hx2
    simp only [Pi.add_apply, hx1, hx2, Zval]
    abel
  have hfin : IsMinusLerayDiv
      (tensorColumns (heatProfile D.h u₀ τ + ((simRemainder D ld w j τ).value : SpatialField))
        (heatProfile D.h u₀ τ + ((simRemainder D ld w j τ).value : SpatialField)))
      (Nbg τ + Xclass (nm.Gstar τ) + Lclass (ld.c.B τ (ιZ Y)) + -Xclass (nm.CK τ Y) +
        Xclass (nm.N Y Y)) :=
    isMinusLerayDiv_congr hsum (fun i => by
      rw [← tensorColumns_add3]
      filter_upwards [hV] with x hx
      simp only [tensorColumns, hx])
  have hF : simForcing D ld nm Nbg w j τ = Nbg τ + Xclass (nm.Gstar τ) +
      Lclass (ld.c.B τ (ιZ Y)) + -Xclass (nm.CK τ Y) + Xclass (nm.N Y Y) := by
    simp only [simForcing, sub_eq_add_neg, hYdef]
  rw [hF]
  exact hfin

/-! ## The weak similarity equation for `R_j` (lines 501–503) -/

theorem simRemainder_weak (hev : EvolutionWeakForm) {D : BackgroundData}
    (hD : IsUnstableBackground D) {ld : LinearData} (hld : IsLinearData D ld)
    {nm : NonlinearMaps} {Nbg : ℝ → L2Space}
    (hrw : IsSimilarityWeakSolution D.h univ D.rheat Nbg)
    {τ₀ : ℝ} (hτ₀ : τ₀ ≤ 0) {cm : CorrectionMaps τ₀} (hcm : IsCorrectionMaps D ld nm τ₀ cm)
    (j : Fin 2) (w : WeightedZ τ₀) (hw : w = cm.Bq w w + cm.L j w + cm.G j) :
    IsSimilarityWeakSolution D.h (Iio τ₀) (simRemainder D ld w j)
      (simForcing D ld nm Nbg w j) := by
  obtain ⟨FB, hFB, hBq⟩ := hcm.Bq_spec w w
  obtain ⟨FL, hFL, hL⟩ := hcm.L_spec j w
  obtain ⟨FG, hFG, hG⟩ := hcm.G_spec j
  set Ftot : WeightedX τ₀ := FB + FL + FG with hFtot
  have hwR : ld.R τ₀ Ftot = w := by
    rw [hFtot, map_add, map_add, ← hBq, ← hL, ← hG, ← hw]
  -- the mode `v = e^{στ} b̂` is an `E`-solution
  have hmode := hev D ld.c ld.S ld.ev hD hld.coefficients hld.free hld.evolution τ₀
    (modeField D ld) (fun _ => 0) (continuous_modeField hld).continuousOn continuousOn_const
    (fun s τ hsτ _ => by
      refine ⟨by simp, ?_⟩
      simp only [map_zero, integral_zero, add_zero]
      have hg := hld.mode.generated s τ hsτ
      simp only [modeField, map_smul]
      rw [hg, smul_smul, ← Real.exp_add]
      ring_nf)
  -- the correction `z = e^{βτ} w` is a mild solution with the Green forcing
  have hcorr := hev D ld.c ld.S ld.ev hD hld.coefficients hld.free hld.evolution τ₀
    (unweight ld.sp.β w) (unweightX ld.sp.β Ftot) (continuousOn_unweight _ w)
    (continuousOn_unweightX _ _)
    (fun s τ hsτ hτ => by
      refine ⟨hld.green.mild_integrable τ₀ hτ₀ Ftot s τ hsτ hτ, ?_⟩
      have := hld.green.mild τ₀ hτ₀ Ftot s τ hsτ hτ
      rwa [hwR] at this)
  have hsum := (hrw.mono (subset_univ _)).add ((hmode.smul (jcoef j)).add hcorr)
  have hRfun : (fun τ => D.rheat τ + (jcoef j • (modeField D ld τ).toH2 +
      (unweight ld.sp.β w τ).toH2)) = simRemainder D ld w j := by
    funext τ
    rfl
  rw [hRfun] at hsum
  refine hsum.congr_forcing (fun τ hτ => ?_)
  have hτ' : τ ≤ τ₀ := le_of_lt hτ
  -- the forcing of the correction: `e^{βτ}(F_B + F_L + F_G) = G_* - 𝓒(K,Y) + 𝓝(Y,Y)`
  have hX : unweightX ld.sp.β Ftot τ = nm.Gstar τ - nm.CK τ (corrField D ld w j τ) +
      nm.N (corrField D ld w j τ) (corrField D ld w j τ) := by
    have hu : unweightX ld.sp.β Ftot τ =
        Real.exp (ld.sp.β * τ) • (FB ⟨τ, hτ'⟩ + FL ⟨τ, hτ'⟩ + FG ⟨τ, hτ'⟩) := by
      simp only [unweightX]
      rw [dif_pos hτ']
      rfl
    have hY : corrField D ld w j τ = jcoef j • (Real.exp (D.σ * τ) • ld.bhat τ) +
        Real.exp (ld.sp.β * τ) • w ⟨τ, hτ'⟩ := by
      simp only [corrField, modeField]
      rw [unweight_of_le _ _ hτ']
    rw [hu, hY, hFB ⟨τ, hτ'⟩, hFL ⟨τ, hτ'⟩, hFG ⟨τ, hτ'⟩]
    simp only [Subtype.coe_mk]
    have ha2 : Real.exp (2 * D.σ * τ) = Real.exp (D.σ * τ) * Real.exp (D.σ * τ) := by
      rw [← Real.exp_add]
      ring_nf
    have hee : Real.exp (ld.sp.β * τ) * Real.exp (-(ld.sp.β * τ)) = 1 := by
      rw [← Real.exp_add]
      simp
    rw [ha2, smul_add, smul_add, smul_smul (Real.exp (ld.sp.β * τ)) (Real.exp (-(ld.sp.β * τ))),
      hee, one_smul]
    rcases (show jcoef j = 0 ∨ jcoef j = 1 by fin_cases j <;> simp [jcoef]) with hj | hj <;>
      · rw [hj]
        simp only [map_add, map_smul, map_neg, map_sub, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.smul_apply, ContinuousLinearMap.neg_apply,
          ContinuousLinearMap.sub_apply, zero_smul, one_smul, zero_add, add_zero, zero_mul,
          one_mul, map_zero, ContinuousLinearMap.zero_apply, smul_zero, sub_zero, smul_add,
          smul_sub, smul_neg, smul_smul]
        module
  rw [hX]
  have hιY : ιZ (corrField D ld w j τ) =
      jcoef j • ιZ (modeField D ld τ) + ιZ (unweight ld.sp.β w τ) := by
    simp only [corrField, map_add, map_smul]
  simp only [simForcing, hιY, Lclass_eq, Xclass_eq, map_add, map_smul, map_sub, map_zero,
    add_zero, smul_add]
  abel

/-! ## The physical fields (lines 525–547) -/

theorem dil_neg_log_eq_physicalDilation {t : ℝ} (ht : 0 < t) (F : L2Space) :
    dil (-Real.log t) F = physicalDilation t F := by
  rw [dil_eq_toL2]
  unfold physicalDilation ViscosityTransport.dilationL2
  have he : Real.exp (-Real.log t / 2) = t ^ (-1 / 2 : ℝ) := by
    rw [Real.rpow_def_of_pos ht]
    ring_nf
  rw [he]

/-- `u = e^{htΔ}u₀ + ρ(t) = t^{-1/2}[H_h[u₀] + R](·/√t, log t)` (line 533). -/
theorem physicalVelocity_ae {h : ℝ} (hh : 0 < h) (u₀ : SpatialField) (R : ℝ → H2) {t : ℝ}
    (ht : 0 < t) :
    physicalVelocity h u₀ (physicalOf R) t =ᵐ[volume]
      SpatialScaling.spatialScale (Real.exp (-Real.log t / 2)) (Real.exp (-Real.log t / 2))
        (heatProfile h u₀ (Real.log t) + ((R (Real.log t)).value : SpatialField)) := by
  simp only [physicalVelocity, if_pos ht]
  rw [flow_eq_spatialScale_heatProfile hh ht]
  have h1 := coeFn_dil (-Real.log t) (R (Real.log t)).value
  have hv : (physicalOf R t).value = dil (-Real.log t) (R (Real.log t)).value := rfl
  rw [hv]
  filter_upwards [h1] with x hx
  simp only [Pi.add_apply, hx, SpatialScaling.spatialScale, smul_add]

/-- The physical remainder of one fixed point satisfies `IsPhysicalStrongRemainder`. -/
theorem isPhysicalStrongRemainder_simRemainder (hev : EvolutionWeakForm) {D : BackgroundData} (hD : IsUnstableBackground D)
    {ld : LinearData} (hld : IsLinearData D ld) {u₀ : SpatialField} (hu₀ : IsCompactDatum D u₀)
    {nm : NonlinearMaps} (hnm : IsNonlinearMaps D u₀ nm) {Nbg : ℝ → L2Space}
    (hNc : Continuous Nbg)
    (hNw : ∀ τ, IsMinusLerayDiv (tensorColumns (D.Ustar τ) (D.Ustar τ)) (Nbg τ))
    (hrw : IsSimilarityWeakSolution D.h univ D.rheat Nbg)
    {τ₀ : ℝ} (hτ₀ : τ₀ ≤ 0) {cm : CorrectionMaps τ₀} (hcm : IsCorrectionMaps D ld nm τ₀ cm)
    (j : Fin 2) (w : WeightedZ τ₀) (hw : w = cm.Bq w w + cm.L j w + cm.G j)
    (hsym : ∀ τ : Iic τ₀, IsAxisymmetricNoSwirl (Zval (w τ)))
    {M : ℝ} (hM0 : 0 ≤ M) (hM : ∀ τ, τ ≤ τ₀ → ‖simRemainder D ld w j τ‖ ≤ M) :
    IsPhysicalStrongRemainder D.h (Real.exp τ₀) u₀ (physicalOf (simRemainder D ld w j))
      (physicalForcing (simForcing D ld nm Nbg w j)) (M + M ^ 2) := by
  have hh : 0 < D.h := hD.1.h_pos
  have hRc := continuousOn_simRemainder hD hld w j
  have hY : ContinuousOn (corrField D ld w j) (Iic τ₀) := continuousOn_corrField hld w j
  have hιY : ContinuousOn (fun τ => ιZ (corrField D ld w j τ)) (Iic τ₀) :=
    ιZ.continuous.comp_continuousOn hY
  have hFc : ContinuousOn (simForcing D ld nm Nbg w j) (Iic τ₀) := by
    have hsub : Iic τ₀ ⊆ Iic 0 := Iic_subset_Iic.mpr hτ₀
    have hB : ContinuousOn (fun τ => ld.c.B τ (ιZ (corrField D ld w j τ))) (Iic τ₀) :=
      hld.coefficients.B_continuous.continuousOn.clm_apply hιY
    have hCK : ContinuousOn (fun τ => nm.CK τ (corrField D ld w j τ)) (Iic τ₀) :=
      (hnm.CK_continuous.mono hsub).clm_apply hY
    have hN : ContinuousOn (fun τ => nm.N (corrField D ld w j τ) (corrField D ld w j τ))
        (Iic τ₀) := (nm.N.continuous.comp_continuousOn hY).clm_apply hY
    have hG : ContinuousOn nm.Gstar (Iic τ₀) := hnm.Gstar_continuous.mono hsub
    exact (((hNc.continuousOn.add (XclassCLM.continuous.comp_continuousOn hG)).add
      (LclassCLM.continuous.comp_continuousOn hB)).sub
      (XclassCLM.continuous.comp_continuousOn hCK)).add
      (XclassCLM.continuous.comp_continuousOn hN)
  have hρc := continuousOn_physicalOf hτ₀ hRc
  have hNphys := continuousOn_physicalForcing hτ₀ hFc
  have hT1 : Real.exp τ₀ ≤ 1 := Real.exp_le_one_iff.mpr hτ₀
  refine ⟨hρc, ?_, ?_, ?_, ?_, hNphys, ?_, ?_⟩
  · -- solenoidal
    intro t _
    exact dil_mem_solenoidal _ (simRemainder_solenoidal hD w j _)
  · -- the `L²` rate
    intro t ht
    have h1 := norm_physicalOf_value_le (simRemainder D ld w j) ht.1
    have h2 := hM _ (log_mem_Iic ht)
    have hp : 0 ≤ t ^ (1 / 4 : ℝ) := Real.rpow_nonneg ht.1.le _
    calc ‖(physicalOf (simRemainder D ld w j) t).value‖
        ≤ t ^ (1 / 4 : ℝ) * ‖simRemainder D ld w j (Real.log t)‖ := h1
      _ ≤ t ^ (1 / 4 : ℝ) * (M + M ^ 2) := by
          gcongr
          nlinarith [sq_nonneg M]
      _ = (M + M ^ 2) * t ^ (1 / 4 : ℝ) := mul_comm _ _
  · -- the gradient rate
    intro t ht
    have h1 := sum_sq_first_physicalOf_le (simRemainder D ld w j) ht.1
    have h2 := hM _ (log_mem_Iic ht)
    have hp : 0 ≤ t ^ (-(1 / 2 : ℝ)) := Real.rpow_nonneg ht.1.le _
    have h3 : ‖simRemainder D ld w j (Real.log t)‖ ^ 2 ≤ M + M ^ 2 := by
      have := pow_le_pow_left₀ (norm_nonneg _) h2 2
      nlinarith
    calc ∑ i : Fin 3, ‖(physicalOf (simRemainder D ld w j) t).first i‖ ^ 2
        ≤ t ^ (-(1 / 2 : ℝ)) * ‖simRemainder D ld w j (Real.log t)‖ ^ 2 := h1
      _ ≤ t ^ (-(1 / 2 : ℝ)) * (M + M ^ 2) := by gcongr
      _ = (M + M ^ 2) * t ^ (-(1 / 2 : ℝ)) := mul_comm _ _
  · -- the nonlinearity
    intro t ht
    have hτ : Real.log t ≤ 0 := (log_mem_Iic ht).trans hτ₀
    have hN := simForcing_isMinusLerayDiv hD hld hu₀ hnm hNw w j hτ
    have hu := physicalVelocity_ae hh u₀ (simRemainder D ld w j) ht.1
    have := isMinusLerayDiv_scale (Real.log t) hN hu
    have hF : physicalForcing (simForcing D ld nm Nbg w j) t =
        Real.exp (-Real.log t) • dil (-Real.log t) (simForcing D ld nm Nbg w j (Real.log t)) := by
      rw [physicalForcing, Real.exp_neg, Real.exp_log ht.1]
    rw [hF]
    exact this
  · -- the strong equation
    have hRv : ContinuousOn (fun τ => (simRemainder D ld w j τ).value) (Iio τ₀) :=
      H2.valueCLM.continuous.comp_continuousOn (hRc.mono Iio_subset_Iic_self)
    have hw' := simRemainder_weak hev hD hld hrw hτ₀ hcm j w hw
    have hG : ContinuousOn (fun t => D.h • H2.laplace (physicalOf (simRemainder D ld w j) t) +
        physicalForcing (simForcing D ld nm Nbg w j) t) (Ioo 0 (Real.exp τ₀)) := by
      have h1 : ContinuousOn (fun t => H2.laplace (physicalOf (simRemainder D ld w j) t))
          (Ioc 0 (Real.exp τ₀)) := H2.laplaceCLM.continuous.comp_continuousOn hρc
      exact ((h1.const_smul D.h).add hNphys).mono Ioo_subset_Ioc_self
    exact physical_hasDerivAt_of_similarity hRv hw' hG
  · -- symmetry
    intro t _
    exact isAxisymmetricNoSwirl_dil _ (simRemainder_symmetric hD hld w hsym j _)

/-! ## The step -/

/-- **Step L13** from the two missing theorems: every pair of fixed points of the
correction maps with invariant corrections gives physical remainders
`ρ_j(t) = t^{-1/2}[r_heat + jv + z_j](·/√t, log t)` with the strong equation of the total
field, the rates of line 540 and symmetry (lines 501–503, 525–547). -/
theorem physicalRemainderStep_of (hbg : BackgroundStrongForm) (hev : EvolutionWeakForm) :
    PhysicalRemainderStep := by
  intro D hD ld hld u₀ hu₀ nm hnm τ₀ hτ₀ cm hcm w hw hsym
  obtain ⟨Nbg, hNc, hNw, hrw⟩ := hbg D hD
  obtain ⟨M, hM0, hM⟩ := simRemainder_bound hD hld hτ₀ w
  refine ⟨⟨fun j => physicalOf (simRemainder D ld (w j) j),
    fun j => physicalForcing (simForcing D ld nm Nbg (w j) j), M + M ^ 2⟩, fun j => ⟨?_, ?_⟩⟩
  · intro t ht
    change (dilH2 (-Real.log t) (simRemainder D ld (w j) j (Real.log t))).value = _
    rw [dilH2_value, simRemainder_value, dil_neg_log_eq_physicalDilation ht.1]
  · exact isPhysicalStrongRemainder_simRemainder hev hD hld hu₀ hnm hNc hNw hrw hτ₀ hcm j
      (w j) (hw j) (hsym j) hM0 (fun τ hτ => hM j τ hτ)

end UnforcedLeray.Blueprint.L13
