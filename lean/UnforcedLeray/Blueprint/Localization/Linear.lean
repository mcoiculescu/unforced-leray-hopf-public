/-! ## L1. Coefficients (lines 268–290) -/

/-- `𝓑_*(τ) f = -𝔓 div(U_*(τ) ⊗ f + f ⊗ U_*(τ))`, as maps `X → L²_div` and `Z → X`. -/
structure Coefficients where
  B : ℝ → (X →L[ℝ] L2div)
  BZ : ℝ → (Z →L[ℝ] X)

/-- `loc:eq:coefficient-maps` (lines 279–290): `U_* ∈ C_per C₀`, `∇U_* ∈ C_per L³`, and
`𝓑_* ∈ C_per 𝓛(X, L²_div) ∩ C_per 𝓛(Z, X)` with the literal weak characterization. -/
structure IsCoefficients (D : BackgroundData) (c : Coefficients) : Prop where
  Ustar_C0 : ∃ V : ℝ → ZeroAtInftyContinuousMap Space Space, Continuous V ∧
    Function.Periodic V D.period ∧ ∀ τ, (V τ : Space → Space) =ᵐ[volume] D.Ustar τ
  gradient_L3 : ∃ W : ℝ → Fin 3 → Lp Space 3 (volume : Measure Space), Continuous W ∧
    Function.Periodic W D.period ∧
    ∀ τ i, HasWeakSpatialDerivative i (D.Ustar τ) (W τ i : SpatialField)
  B_continuous : Continuous c.B
  B_periodic : Function.Periodic c.B D.period
  BZ_continuous : Continuous c.BZ
  BZ_periodic : Function.Periodic c.BZ D.period
  B_weak : ∀ τ (f : X), IsMinusLerayDiv (symTensorColumns (D.Ustar τ) (Xval f)) (Lclass (c.B τ f))
  BZ_compat : ∀ τ (g : Z), ιX (c.BZ τ g) = c.B τ (ιZ g)

/-- **Step L1** `CoefficientStep`.
* Tex: lines 268–290 (`loc:eq:coefficient-maps`).
* Units: B0709, B0710, B0711.
* Infrastructure: derivative bounds `|D^j H_h[u_dss]| ≤ C⟨y⟩^{-1-j}` for the Gaussian
  convolution of a `|x|^{-1}` field (INF04, INF22); `H² ⊂ L^∞`, `H¹ ⊂ L⁶`, the `H²` algebra
  (INF11); the compiled `Leray.h1Projection`/`h2Projection` (INF06); continuity of `r_heat`
  in `H²` (package). -/
def CoefficientStep : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D → ∃ c : Coefficients, IsCoefficients D c

/-! ## L2. The free evolution `S₀` (lines 292–298) -/

/-- `S₀(s)` on `X`, its smoothing `L²_div → X` and `X → Z`. -/
structure FreeEvolution where
  S0 : ℝ → (X →L[ℝ] X)
  S0L : ℝ → (L2div →L[ℝ] X)
  S0Z : ℝ → (X →L[ℝ] Z)

/-- `loc:eq:free-evolution`: each operator is the literal formula
`S₀(s) f (y) = e^{s/2}[e^{h(e^s-1)Δ} f](e^{s/2} y)` (the compiled
`AncientLocalization.freeEvolution`), strongly continuous, with `‖S₀(s)‖_{X→X} ≤ C e^{-s/4}`
and `‖S₀(s)‖_{L²→X}, ‖S₀(s)‖_{X→Z} ≤ C s^{-1/2}` for `0 < s ≤ 1`. -/
structure IsFreeEvolution (h : ℝ) (S : FreeEvolution) : Prop where
  rep : ∀ s, 0 ≤ s → ∀ f : X,
    Xval (S.S0 s f) =ᵐ[volume] AncientLocalization.freeEvolution h s (Xval f)
  repL : ∀ s, 0 < s → ∀ F : L2div,
    Xval (S.S0L s F) =ᵐ[volume] AncientLocalization.freeEvolution h s (Lval F)
  repZ : ∀ s, 0 < s → ∀ f : X,
    Zval (S.S0Z s f) =ᵐ[volume] AncientLocalization.freeEvolution h s (Xval f)
  strongly_continuous : ∀ f : X, ContinuousOn (fun s => S.S0 s f) (Ici 0)
  bounds : ∃ C : ℝ, 0 < C ∧ (∀ s, 0 ≤ s → ‖S.S0 s‖ ≤ C * Real.exp (-(s / 4))) ∧
    ∀ s, 0 < s → s ≤ 1 → ‖S.S0L s‖ ≤ C / Real.sqrt s ∧ ‖S.S0Z s‖ ≤ C / Real.sqrt s

/-- **Step L2** `FreeEvolutionStep`. Package-independent: only `h > 0` is used.
* Tex: lines 292–298 (`loc:eq:free-evolution`).
* Units: B0712.
* Infrastructure: heat smoothing on `L²`, `H¹`, `H²` with the `t^{-1/2}` gradient bound
  (INF04; partly compiled in `Analysis/Heat/SmoothingBounds.lean`,
  `Heat/SobolevSmoothing.lean`); dilation on Sobolev classes (`ViscosityTransport.dilationL2`,
  `SpatialScaling`); heat preserves `L²_div` (`Heat/Solenoidal.lean`). -/
def FreeEvolutionStep : Prop :=
  ∀ h : ℝ, 0 < h → ∃ S : FreeEvolution, IsFreeEvolution h S

/-! ## L3. The evolution family `E(τ,s)` (lines 299–306) -/

/-- `E(τ,s)` on `X` for `s ≤ τ`, with smoothing `L²_div → X` and `X → Z` for `s < τ`. -/
structure Evolution where
  E : ℝ → ℝ → (X →L[ℝ] X)
  EL : ℝ → ℝ → (L2div →L[ℝ] X)
  EZ : ℝ → ℝ → (X →L[ℝ] Z)

/-- The evolution generated by `∂_τ - 𝓛_*`, characterized by the Duhamel formula
`E(τ,s) = S₀(τ-s) + ∫_s^τ S₀(τ-r) 𝓑_*(r) E(r,s) dr` (line 299), with the evolution law,
double periodicity, joint strong continuity, the strip bounds and the short-time smoothing
`C(τ-s)^{-1/2}` (lines 300–306). -/
structure IsEvolution (D : BackgroundData) (c : Coefficients) (S : FreeEvolution)
    (ev : Evolution) : Prop where
  at_diag : ∀ s, ev.E s s = ContinuousLinearMap.id ℝ X
  law : ∀ s r τ, s ≤ r → r ≤ τ → (ev.E τ r).comp (ev.E r s) = ev.E τ s
  periodic : ∀ τ s, ev.E (τ + D.period) (s + D.period) = ev.E τ s
  strongly_continuous : ∀ f : X,
    ContinuousOn (fun p : ℝ × ℝ => ev.E p.1 p.2 f) {p : ℝ × ℝ | p.2 ≤ p.1}
  duhamel_integrable : ∀ s τ, s ≤ τ → ∀ f : X,
    IntegrableOn (fun r => S.S0L (τ - r) (c.B r (ev.E r s f))) (Ioo s τ)
  duhamel : ∀ s τ, s ≤ τ → ∀ f : X,
    ev.E τ s f = S.S0 (τ - s) f + ∫ r in Ioo s τ, S.S0L (τ - r) (c.B r (ev.E r s f))
  EL_compat : ∀ s τ, s < τ → (ev.EL τ s).comp ιX = ev.E τ s
  EZ_compat : ∀ s τ, s < τ → ιZ.comp (ev.EZ τ s) = ev.E τ s
  strip_bounds : ∀ L : ℝ, 0 < L → ∃ C : ℝ, ∀ s τ, s ≤ τ → τ ≤ s + L →
    ‖ev.E τ s‖ ≤ C ∧ (s < τ → ‖ev.EL τ s‖ ≤ C / Real.sqrt (τ - s) ∧
      ‖ev.EZ τ s‖ ≤ C / Real.sqrt (τ - s) ∧ ‖(ev.EZ τ s).comp ιZ‖ ≤ C)

/-- **Step L3** `EvolutionStep`.
* Tex: lines 299–306 (`unlabeled:299`).
* Units: B0713.
* Infrastructure: Volterra/Dyson construction of nonautonomous evolution families with
  weakly singular kernels (INF08, INF30); strongly measurable operator-valued Bochner
  integrals on `X` (instances fixed in `Spaces.lean`). -/
def EvolutionStep : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D →
    ∀ (c : Coefficients) (S : FreeEvolution), IsCoefficients D c → IsFreeEvolution D.h S →
      ∃ ev : Evolution, IsEvolution D c S ev

/-! ## L4. Regularity of the mode (lines 307–329) -/

/-- `loc:eq:mode-regularity` and the no-zero-phase part of `loc:eq:phase-minimum`: a
continuous periodic `H²_div` representative `b̂` of `b_*`, generated by `E` with rate `σ`
(`e^{στ} b_*` is the `E`-solution, line 318), nonzero in `L²` at every phase (line 323), and
`𝒪`-invariant at every phase. The minimum `m_* > 0` is then proved (`phase_minimum`). -/
structure IsRegularMode (D : BackgroundData) (ev : Evolution) (bhat : ℝ → Z) : Prop where
  continuous : Continuous bhat
  periodic : Function.Periodic bhat D.period
  represents : ∀ᵐ τ, Zval (bhat τ) =ᵐ[volume] D.bstar τ
  generated : ∀ s τ, s ≤ τ →
    ιZ (bhat τ) = Real.exp (-(D.σ * (τ - s))) • ev.E τ s (ιZ (bhat s))
  no_zero_phase : ∀ τ, Zclass (bhat τ) ≠ 0
  symmetric : ∀ τ, IsAxisymmetricNoSwirl (Zval (bhat τ))

/-- **Step L4** `ModeRegularityStep`.
* Tex: lines 307–329 (`loc:eq:mode-regularity`, first half of `loc:eq:phase-minimum`).
* Units: B1009, B1010, B1011 (B1012 is proved in `Compose.lean`).
* Infrastructure: Bochner–Sobolev curves and continuous representatives (`L²H²` with
  `∂_τ ∈ L²L²` gives `C L²`, INF14); the linear energy estimate with
  `‖∇U_*‖₃‖f‖₂‖∇f‖₂` (INF11); identification of the package's weak mode equation with the
  `E`-mild solution (density of tests in `L²`, the literal `𝔓`); uniqueness of mild
  solutions (INF08); `𝒪`-equivariance of `E` (INF24). -/
def ModeRegularityStep : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D →
    ∀ (c : Coefficients) (S : FreeEvolution) (ev : Evolution),
      IsCoefficients D c → IsFreeEvolution D.h S → IsEvolution D c S ev →
        ∃ bhat : ℝ → Z, IsRegularMode D ev bhat

/-! ## L5. Essential spectral radius (lines 331–347) -/

/-- `‖π(Mⁿ)‖ ≤ C e^{-n𝒯/4}` in the Calkin algebra, in real form: `Mⁿ` lies within
`C e^{-n𝒯/4}` of a compact operator. -/
def CalkinBound {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (M : E →L[ℝ] E)
    (period : ℝ) : Prop :=
  ∃ C : ℝ, ∀ n : ℕ, ∃ K : E →L[ℝ] E, IsCompactOperator K ∧
    ‖M ^ n - K‖ ≤ C * Real.exp (-((n : ℝ) * period / 4))

/-- The monodromy `𝓜 = E(𝒯, 0)` (line 331). -/
def monodromy (D : BackgroundData) (ev : Evolution) : X →L[ℝ] X := ev.E D.period 0

/-- **Step L5** `EssentialRadiusStep` (`loc:eq:essential-radius` in real, Calkin-free form).
* Tex: lines 331–347.
* Units: B0714, B0715.
* Infrastructure: Rellich compactness on balls with a uniform tail (INF11, INF28); the
  criterion "weakly null to norm null on a Hilbert space ⇒ compact" (critic §5c, absent from
  Mathlib); the `L² → X` smoothing of L2 and L3. -/
def EssentialRadiusStep : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D →
    ∀ (c : Coefficients) (S : FreeEvolution) (ev : Evolution),
      IsCoefficients D c → IsFreeEvolution D.h S → IsEvolution D c S ev →
        CalkinBound (monodromy D ev) D.period

/-! ## L6. Spectral splitting (lines 348–370) -/

/-- The weight `β`, the rates `β₋, β₊`, the exterior projection `P₊` and `N = 𝓜₊⁻¹ P₊`. -/
structure SpectralSplitting (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] where
  β : ℝ
  βminus : ℝ
  βplus : ℝ
  Pplus : E →L[ℝ] E
  MplusInv : E →L[ℝ] E

/-- `loc:eq:weight` and the Riesz splitting, in real form: `σ < β < 2σ`; `P₊ = I - P₋` is a
finite-rank projection commuting with `𝓜` and with its whole commutant (as a Riesz integral
does); `N = 𝓜₊⁻¹P₊` inverts `𝓜` on `P₊X`; the rates of line 364. These clauses determine
`P₊` (an exponential-dichotomy projection is unique). -/
structure IsSpectralSplitting {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (M : E →L[ℝ] E) (period σ : ℝ) (sp : SpectralSplitting E) : Prop where
  weight_lower : σ < sp.β
  weight_upper : sp.β < 2 * σ
  rate_lower : sp.βminus < sp.β
  rate_upper : sp.β < sp.βplus
  idempotent : sp.Pplus.comp sp.Pplus = sp.Pplus
  commutes : M.comp sp.Pplus = sp.Pplus.comp M
  finite_rank : FiniteDimensional ℝ (LinearMap.range (sp.Pplus : E →ₗ[ℝ] E))
  inverse_left : sp.MplusInv.comp (M.comp sp.Pplus) = sp.Pplus
  inverse_right : M.comp sp.MplusInv = sp.Pplus
  inverse_range : sp.Pplus.comp sp.MplusInv = sp.MplusInv
  inverse_kernel : sp.MplusInv.comp sp.Pplus = sp.MplusInv
  stable_rate : ∃ C : ℝ, ∀ n : ℕ,
    ‖M ^ n * (1 - sp.Pplus)‖ ≤ C * Real.exp (sp.βminus * ((n : ℝ) * period))
  unstable_rate : ∃ C : ℝ, ∀ n : ℕ,
    ‖sp.MplusInv ^ n‖ ≤ C * Real.exp (-(sp.βplus * ((n : ℝ) * period)))
  commutant : ∀ A : E →L[ℝ] E, A.comp M = M.comp A → A.comp sp.Pplus = sp.Pplus.comp A

/-- **Step L6** `SpectralSplittingStep`: a general lemma about one bounded operator on a
real Hilbert space, consuming only the Calkin bound, `𝒯 > 0` and `0 < σ < 1/4`.
* Tex: lines 348–370 (`loc:eq:weight`, the Riesz splitting).
* Units: B0716, B1013, B1014.
* Infrastructure: complexification of a real Hilbert space with its conjugation (critic §5b,
  absent from Mathlib); essential spectrum in the Calkin algebra and finiteness of the
  exterior spectrum (Glück, Theorems 6.2.2, 6.2.9); Riesz projections and the
  spectral-radius formula (INF09; Mathlib has `spectrum`, `spectralRadius`). -/
def SpectralSplittingStep : Prop :=
  ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (M : E →L[ℝ] E) (period σ : ℝ), 0 < period → 0 < σ → σ < 1 / 4 →
      CalkinBound M period → ∃ sp : SpectralSplitting E, IsSpectralSplitting M period σ sp

/-! ## L7. Phase projections (lines 371–404) -/

/-- `Π₊(τ) = F_θ G_θ = E(θ,0) 𝓜₊⁻¹P₊ E(𝒯,θ)` with `θ` the phase of `τ`
(`loc:eq:projections`, lines 380–384), extended periodically. -/
def exteriorProjection (period : ℝ) (ev : Evolution) (N : X →L[ℝ] X) (τ : ℝ) : X →L[ℝ] X :=
  (ev.E (phaseOf period τ) 0).comp (N.comp (ev.E period (phaseOf period τ)))

/-- `E₊(k𝒯+θ, l𝒯+φ)Π₊(φ) = F_θ 𝓜₊^{k-l} G_φ` for `τ = k𝒯+θ ≤ s = l𝒯+φ` (lines 386–389):
`E(θ,0) N^{l-k+1} E(𝒯,φ)` with `N = 𝓜₊⁻¹P₊`. -/
def backwardExterior (period : ℝ) (ev : Evolution) (N : X →L[ℝ] X) (τ s : ℝ) : X →L[ℝ] X :=
  (ev.E (phaseOf period τ) 0).comp
    ((N ^ ((periodIndex period s - periodIndex period τ).toNat + 1)).comp
      (ev.E period (phaseOf period s)))

/-- The `Z`-valued backward exterior evolution `E₊(τ,s)Π₊(s) : X → Z`, `τ ≤ s`. -/
abbrev BackwardLift : Type := ℝ → ℝ → (X →L[ℝ] Z)

/-- Lines 371–404: `Π₊` is a strongly continuous family of projections intertwined by `E`;
the backward exterior evolution maps into `Π₊(τ)X` and is inverted by `E`; it lifts to `Z`;
`loc:eq:past-bound` and `loc:eq:future-bound`. -/
structure IsPhaseProjections (D : BackgroundData) (ev : Evolution)
    (sp : SpectralSplitting X) (EplusZ : BackwardLift) : Prop where
  idempotent : ∀ θ, (exteriorProjection D.period ev sp.MplusInv θ).comp
    (exteriorProjection D.period ev sp.MplusInv θ) = exteriorProjection D.period ev sp.MplusInv θ
  strongly_continuous : ∀ f : X, Continuous (fun θ => exteriorProjection D.period ev sp.MplusInv θ f)
  intertwine : ∀ s τ, s ≤ τ → (ev.E τ s).comp (exteriorProjection D.period ev sp.MplusInv s) =
    (exteriorProjection D.period ev sp.MplusInv τ).comp (ev.E τ s)
  backward_range : ∀ τ s, τ ≤ s →
    (exteriorProjection D.period ev sp.MplusInv τ).comp (backwardExterior D.period ev sp.MplusInv τ s) =
      backwardExterior D.period ev sp.MplusInv τ s
  backward_inverse : ∀ τ s, τ ≤ s →
    (ev.E s τ).comp (backwardExterior D.period ev sp.MplusInv τ s) =
      exteriorProjection D.period ev sp.MplusInv s
  future_lift : ∀ τ s, τ ≤ s → ιZ.comp (EplusZ τ s) = backwardExterior D.period ev sp.MplusInv τ s
  past_bound : ∃ C : ℝ, ∀ s τ, s < τ →
    ‖(ev.EZ τ s).comp (1 - exteriorProjection D.period ev sp.MplusInv s)‖ ≤
      C * (1 + 1 / Real.sqrt (τ - s)) * Real.exp (sp.βminus * (τ - s))
  future_bound : ∃ C : ℝ, ∀ τ s, τ ≤ s → ‖EplusZ τ s‖ ≤ C * Real.exp (sp.βplus * (τ - s))

/-- **Step L7** `ProjectionStep`.
* Tex: lines 371–404 (`loc:eq:projections`, `loc:eq:past-bound`, `loc:eq:future-bound`).
* Units: B1015, B1016, B1017.
* Infrastructure: only the outputs of L3 and L6 and finite-dimensional linear algebra on
  `P₊X` (INF31); one-period smoothing `X → Z` from L3. -/
def ProjectionStep : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D →
    ∀ (c : Coefficients) (S : FreeEvolution) (ev : Evolution) (sp : SpectralSplitting X),
      IsCoefficients D c → IsFreeEvolution D.h S → IsEvolution D c S ev →
        IsSpectralSplitting (monodromy D ev) D.period D.σ sp →
          ∃ EplusZ : BackwardLift, IsPhaseProjections D ev sp EplusZ

/-! ## L8. The half-line Green operator (lines 406–428) -/

/-- A family `𝓡_β(τ₀) : 𝒳_β(τ₀) → 𝒵_β(τ₀)`, in weighted coordinates. -/
abbrev GreenFamily : Type := (τ₀ : ℝ) → (WeightedX τ₀ →L[ℝ] WeightedZ τ₀)

/-- `loc:eq:mixed-inverse` and `loc:eq:inverse-bound`: `z = 𝓡_β f` is a mild solution of
`(∂_τ - 𝓛_*) z = f` on `(-∞, τ₀]` with `Π₊(τ₀) z(τ₀) = 0` (line 417), and
`‖𝓡_β‖ ≤ C_β` uniformly in `τ₀ ≤ 0` (line 427). In `𝒵_β` these three properties determine
`z` (the stable part is fixed from `-∞`, the exterior part by its terminal value). -/
structure IsGreenOperator (D : BackgroundData) (ev : Evolution) (sp : SpectralSplitting X)
    (R : GreenFamily) : Prop where
  mild_integrable : ∀ τ₀, τ₀ ≤ 0 → ∀ (F : WeightedX τ₀) (s τ : ℝ), s ≤ τ → τ ≤ τ₀ →
    IntegrableOn (fun r => ev.E τ r (unweightX sp.β F r)) (Ioo s τ)
  mild : ∀ τ₀, τ₀ ≤ 0 → ∀ (F : WeightedX τ₀) (s τ : ℝ), s ≤ τ → τ ≤ τ₀ →
    ιZ (unweight sp.β (R τ₀ F) τ) =
      ev.E τ s (ιZ (unweight sp.β (R τ₀ F) s)) + ∫ r in Ioo s τ, ev.E τ r (unweightX sp.β F r)
  terminal : ∀ τ₀, τ₀ ≤ 0 → ∀ F : WeightedX τ₀,
    exteriorProjection D.period ev sp.MplusInv τ₀ (ιZ (unweight sp.β (R τ₀ F) τ₀)) = 0
  bound : ∃ C : ℝ, ∀ τ₀, τ₀ ≤ 0 → ‖R τ₀‖ ≤ C

/-- **Step L8** `GreenStep`.
* Tex: lines 406–428 (`loc:eq:mixed-inverse`, `loc:eq:inverse-bound`).
* Units: B1018, B1019, B1020.
* Infrastructure: improper Bochner integrals in `Z` with the compiled kernel integrability
  (`AncientLocalization.GreenKernel`); continuity of parameter integrals (INF26). -/
def GreenStep : Prop :=
  ∀ D : BackgroundData, IsUnstableBackground D →
    ∀ (c : Coefficients) (S : FreeEvolution) (ev : Evolution) (sp : SpectralSplitting X)
      (EplusZ : BackwardLift),
      IsCoefficients D c → IsFreeEvolution D.h S → IsEvolution D c S ev →
        IsSpectralSplitting (monodromy D ev) D.period D.σ sp →
          IsPhaseProjections D ev sp EplusZ →
            ∃ R : GreenFamily, IsGreenOperator D ev sp R

/-! ## Proved: the formula for `Π₊` gives `P₊` at phase zero (line 384) -/

theorem exteriorProjection_zero {D : BackgroundData} {c : Coefficients} {S : FreeEvolution}
    {ev : Evolution} {sp : SpectralSplitting X} (hev : IsEvolution D c S ev)
    (hsp : IsSpectralSplitting (monodromy D ev) D.period D.σ sp) :
    exteriorProjection D.period ev sp.MplusInv 0 = sp.Pplus := by
  unfold exteriorProjection
  rw [phaseOf_zero, hev.at_diag, ContinuousLinearMap.id_comp]
  calc sp.MplusInv.comp (ev.E D.period 0)
      = (sp.MplusInv.comp sp.Pplus).comp (monodromy D ev) := by rw [hsp.inverse_kernel]; rfl
    _ = sp.MplusInv.comp (sp.Pplus.comp (monodromy D ev)) := by
        rw [ContinuousLinearMap.comp_assoc]
    _ = sp.MplusInv.comp ((monodromy D ev).comp sp.Pplus) := by rw [hsp.commutes]
    _ = sp.Pplus := hsp.inverse_left

/-! ## The linear theory, bundled -/

/-- Everything the linear steps construct. -/
structure LinearData where
  c : Coefficients
  S : FreeEvolution
  ev : Evolution
  bhat : ℝ → Z
  sp : SpectralSplitting X
  EplusZ : BackwardLift
  R : GreenFamily

/-- All characterizations and bounds of steps L1–L8. -/
structure IsLinearData (D : BackgroundData) (ld : LinearData) : Prop where
  coefficients : IsCoefficients D ld.c
  free : IsFreeEvolution D.h ld.S
  evolution : IsEvolution D ld.c ld.S ld.ev
  mode : IsRegularMode D ld.ev ld.bhat
  essential : CalkinBound (monodromy D ld.ev) D.period
  splitting : IsSpectralSplitting (monodromy D ld.ev) D.period D.σ ld.sp
  projections : IsPhaseProjections D ld.ev ld.sp ld.EplusZ
  green : IsGreenOperator D ld.ev ld.sp ld.R

/-- The linear steps compose: L1–L8 produce the full linear theory of the package. -/
theorem linearData_of_steps (h1 : CoefficientStep) (h2 : FreeEvolutionStep)
    (h3 : EvolutionStep) (h4 : ModeRegularityStep) (h5 : EssentialRadiusStep)
    (h6 : SpectralSplittingStep) (h7 : ProjectionStep) (h8 : GreenStep)
    (D : BackgroundData) (hD : IsUnstableBackground D) :
    ∃ ld : LinearData, IsLinearData D ld := by
  obtain ⟨c, hc⟩ := h1 D hD
  obtain ⟨S, hS⟩ := h2 D.h hD.1.h_pos
  obtain ⟨ev, hev⟩ := h3 D hD c S hc hS
  obtain ⟨bhat, hb⟩ := h4 D hD c S ev hc hS hev
  have hess := h5 D hD c S ev hc hS hev
  obtain ⟨sp, hsp⟩ := h6 X (monodromy D ev) D.period D.σ hD.1.period_pos hD.2.σ_pos
    hD.2.σ_lt hess
  obtain ⟨EplusZ, hpp⟩ := h7 D hD c S ev sp hc hS hev hsp
  obtain ⟨R, hR⟩ := h8 D hD c S ev sp EplusZ hc hS hev hsp hpp
  exact ⟨⟨c, S, ev, bhat, sp, EplusZ, R⟩, ⟨hc, hS, hev, hb, hess, hsp, hpp, hR⟩⟩

end UnforcedLeray.Blueprint
