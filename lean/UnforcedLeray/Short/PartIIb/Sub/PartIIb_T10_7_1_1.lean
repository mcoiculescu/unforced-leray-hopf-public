import UnforcedLeray.Short.PartIIb.Sub.PartIIb_T10_7_1

/-!
# `PartII-b:T10/7/1/1` (`GradLiftRead`): decomposition

Source of record: `the November 2 reference manuscript` lines 1912-1921
(`∂_ρ(√s b) = s Q_ε b`, `∂_z(√s b) = s ∂_η b`), 1639-1668 (chart `s,q,η`).

The chart `(τ, y) ↦ (s, q, η)` of `Axi.chart` for fixed `τ` has fibres the rotation orbits about the
axis, and `(τ, ϱ, z) ↦ (s, q, η)` is a bijection (`ϱ = R s^{-1/2}`, `τ` from `q`, `z` from `η`).
Hence the only content is rotation invariance of the radial combination of `g` and of `g 2`
(`GLRotInv`: `N_v b` is `𝒪`-equivariant, the weak derivative is unique, `GLUniq`; note the vector fields are
equivariant, not invariant), after which the
angular-average machinery of `Lib/AxisymmetricB/Average.lean` (`ae_eq_angAvg`) and the chart bijection
read the profile functions (`GLBuild`).
-/

set_option autoImplicit false

noncomputable section

open Set MeasureTheory Filter Topology
open scoped ENNReal ContDiff

namespace UnforcedLeray.Short.IIb

open UnforcedLeray.PhaseSpace UnforcedLeray.Cons.C03.Concrete

/-- The radial combination `Σ_{j<2} (y_j/ϱ) g_j`. -/
def radComb (g : Fin 3 → ℝ × Space → CVec3) (x : ℝ × Space) : CVec3 :=
  (((x.2 0 / Real.sqrt (x.2 0 ^ 2 + x.2 1 ^ 2) : ℝ) : ℂ)) • g 0 x +
    (((x.2 1 / Real.sqrt (x.2 0 ^ 2 + x.2 1 ^ 2) : ℝ) : ℂ)) • g 1 x

/-- **Uniqueness of weak derivatives** (fundamental lemma on `(ℝ/Pℤ) × ℝ³`): two fields in `Y_r`
(`r > 1`) with the same pairing against every phase test (complex vector valued) agree a.e. -/
def GLUniq : Prop :=
  ∀ (P r : ℝ) (f f' : ℝ × Space → CVec3), 0 < P → 1 < r → IsInYr P r f → IsInYr P r f' →
    (∀ Φ : ℝ × Space → CVec3, IsPhaseTest P Φ → pairF P Φ f = pairF P Φ f') →
    f =ᵐ[volume] f'

/-- Real part of a complex vector, as a vector of `Space`. -/
def reS (v : CVec3) : Space := WithLp.toLp 2 fun i => (v i).re

/-- Imaginary part of a complex vector, as a vector of `Space`. -/
def imS (v : CVec3) : Space := WithLp.toLp 2 fun i => (v i).im

/-- `W` is a.e. *equivariant* under the group `𝒪` (generated by the rotations `R_θ` about `e₃` and
the reflection `y₁ ↦ -y₁` in a meridian plane): `W(τ, g y) = g W(τ, y)` a.e., for each `g`. -/
def GLEquivar (W : ℝ × Space → Space) : Prop :=
  (∀ θ : ℝ, ∀ᵐ x : ℝ × Space ∂volume, W (x.1, Axi.rotZ θ x.2) = Axi.rotZ θ (W x)) ∧
    ∀ᵐ x : ℝ × Space ∂volume, W (x.1, Axi.reflY x.2) = Axi.reflY (W x)

/-- **Equivariance of the weak gradient** (SP 1912-1921).  `N_v b(τ, ·) = √s (b_r e_r + b_z e_3)` is
`𝒪`-equivariant (`N_v b(τ, g y) = g N_v b(τ, y)` off the axis: `Axi.eR_map`, `Axi.chart` is
`𝒪`-invariant, `Axi.mer_map`; for the reflection also `g e_3 = e_3`).  Testing `HasPtwOp` against
`Φ ∘ g` (rotated/reflected phase tests, `Axi.rotZ`/`Axi.reflY` measure preserving, `dy j` commutes
with `g` up to the matrix of `g`) and applying `GLUniq` shows that the radial combination
`radComb g = Σ_{j<2} (y_j/ϱ) g_j = ∂_ϱ N_v b` and `g 2 = ∂_z N_v b` are a.e. `𝒪`-equivariant
(real and imaginary parts separately; the *vector* fields rotate with the frame, they are not
invariant).  The reflection equivariance kills the `e_φ` component later. -/
def GLRotInv : Prop :=
  ∀ (c ε r : ℝ) (b : CProf) (g : Fin 3 → ℝ × Space → CVec3), 0 < c → 0 < ε → 1 < r → r < 3 →
    InHr c r b → (∀ j, IsInYr (2 * ε * c) r (g j)) →
    (∀ j, HasPtwOp (2 * ε * c) (fun Φ => -(dy j Φ)) (NvC ε⁻¹ b) (g j)) →
    ∀ P : CVec3 → Space, (P = reS ∨ P = imS) →
      GLEquivar (fun x => P (radComb g x)) ∧ GLEquivar (fun x => P (g 2 x))

/-- **Reading the profile** (SP 1912-1921): if the real and imaginary parts of `radComb g` and
`g 2` are a.e. `𝒪`-equivariant and `g_j ∈ Y_r`, then `g` read through the chart gives `Qb, Eb` with
the `√s`-lift properties.  Proof: `GLAvgLift` (Sub/PartII-b_T10_7_1_1_avg.lean) gives
`W = A_r e_r + A_z e_3` (no `e_φ` component) for `W` the real/imaginary parts; the angular averages
are functions of `(τ, ϱ, z)`; compose with the inverse chart
`(s,q,η) ↦ (τ = ..., ϱ = R s^{-1/2}, z = η ϱ/R)`; periodicity in `q` from the `2εc`-periodicity of
`g` in `τ` and measurability by change of variables (`hMeas`, `Axi.ageμ`). -/
def GLBuild : Prop :=
  ∀ (c ε r : ℝ) (g : Fin 3 → ℝ × Space → CVec3), 0 < c → 0 < ε → 1 < r → r < 3 →
    (∀ j, IsInYr (2 * ε * c) r (g j)) →
    (∀ P : CVec3 → Space, (P = reS ∨ P = imS) →
      GLEquivar (fun x => P (radComb g x)) ∧ GLEquivar (fun x => P (g 2 x))) →
    ∃ Qb Eb : CProf,
      QPeriodic c (sqrtS Qb) ∧ AEStronglyMeasurable (sqrtS Qb) (hMeas c r) ∧
      QPeriodic c (sqrtS Eb) ∧ AEStronglyMeasurable (sqrtS Eb) (hMeas c r) ∧
      (NvC ε⁻¹ (sqrtS Eb) =ᵐ[volume] g 2) ∧
      (NvC ε⁻¹ (sqrtS Qb) =ᵐ[volume] radComb g)

theorem gradLiftRead_of (h1 : GLRotInv) (h2 : GLBuild) : GradLiftRead := by
  intro c ε r b g hc hε hr1 hr3 hb hgY hgp
  exact h2 c ε r g hc hε hr1 hr3 hgY (h1 c ε r b g hc hε hr1 hr3 hb hgY hgp)

end UnforcedLeray.Short.IIb

#print axioms UnforcedLeray.Short.IIb.gradLiftRead_of
