import UnforcedLeray.Short.PartIIb.Sub.PartIIb_T22_2_3_1_7.ClassP
import UnforcedLeray.Short.PartIIb.Sub.PartIIb_T22_2_3_1_7.Mixed

/-!


Source of record: `the November 2 reference manuscript` lines 2100-2105 (the regular
backward problem must be `C^∞` jointly: `BwdSol.smooth`, `CylEtaTest` of `Sub/T22_2.lean`).  With a
jointly smooth drift, a spatially smooth solution of the forward equation is jointly `C^∞` on
`[0, T] × ℝ²`.  Pure calculus, no heat kernel:

* (a) `TimeSpaceCommute` (`Sub/PartIIb_T22_2_3_1_7/Commute.lean`): `∂_σ ∂_j = ∂_j ∂_σ` in `SpSmooth`;
* (b) `ClassTower` (`Sub/PartIIb_T22_2_3_1_7/ClassP.lean`): the class generated by `u` under spatial
  partials, sums and jointly smooth coefficients is closed under `∂_σ`, so `u` heads a tower;
* (c) `MixedSmooth` (`Sub/PartIIb_T22_2_3_1_7/Mixed.lean`): the head of a tower is jointly `C^∞`
  (`T > 0`; the case `T = 0` is a single slice, treated here).

All three parts are proved (namespace `BwdRoute.Joint`), so `fwdJointSmooth_proved` is
unconditional.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set Filter Topology

namespace UnforcedLeray.Short.IIb.BwdRoute

open CylPDE

/-- `FwdJointSmooth` from parts (b) and (c); part (a) enters through them. -/
theorem fwdJointSmooth_of (hb : Joint.ClassTower) (hc : Joint.MixedSmooth) : FwdJointSmooth := by
  intro ν T w u hT0 hw hu hpde
  rcases hT0.eq_or_lt with rfl | hT
  · have h0 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun z : ℝ × Pl => u 0 z.2) :=
      (hu.slice 0 ⟨le_rfl, le_rfl⟩).comp contDiff_snd
    refine h0.contDiffOn.congr ?_
    rintro z ⟨hz, -⟩
    have hz0 : z.1 = 0 := le_antisymm hz.2 hz.1
    simp only [hz0]
  · obtain ⟨D, hD, rfl⟩ := hb ν T w u hT hw hu hpde
    exact hc T D hT hD

/-- **`FwdJointSmooth`**, unconditional. -/
theorem fwdJointSmooth_proved : FwdJointSmooth :=
  fwdJointSmooth_of Joint.classTower Joint.mixedSmooth

end UnforcedLeray.Short.IIb.BwdRoute
