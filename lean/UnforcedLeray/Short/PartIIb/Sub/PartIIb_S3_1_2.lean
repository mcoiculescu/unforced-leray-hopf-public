/-! ## 1. Concrete spatial operators and 1D phase-jet relation -/

/-- Spatial partial derivative `∂_{y_j} F` along the `j`-th standard basis vector. -/
def spatialPartial (j : Fin 3) (F : SpatialField) : SpatialField :=
  dirSpatialJet F [EuclideanSpace.single j 1]

/-- Spatial Laplacian `ΔF = ∑_{j=0}^2 ∂_{y_j}^2 F` on `SpatialField`. -/
def spatialLaplacian (F : SpatialField) : SpatialField :=
  fun y => ∑ j : Fin 3,
    dirSpatialJet F [EuclideanSpace.single j 1, EuclideanSpace.single j 1] y

/-- Constant-coefficient diffusion-reaction part `ν ΔF + (1/2) F` of the projected operator. -/
def spatialDiffReact (ν : ℝ) (F : SpatialField) : SpatialField :=
  ν • spatialLaplacian F + (1 / 2 : ℝ) • F

/-- Spatial radial drift `(y · ∇)F(y) = fderiv ℝ F y y`. -/
def spatialRadialDrift (F : SpatialField) : SpatialField :=
  fun y => fderiv ℝ F y y

/-- Full linear spatial operator `(1/2)(y · ∇)F + ν ΔF + (1/2)F` of the projected evolution. -/
def spatialProjectedLin (ν : ℝ) (F : SpatialField) : SpatialField :=
  (1 / 2 : ℝ) • spatialRadialDrift F + spatialDiffReact ν F

/-- Bilinear spatial convection `(F · ∇)G(y) = fderiv ℝ G y (F y)`. -/
def spatialConvect (F G : SpatialField) : SpatialField :=
  fun y => fderiv ℝ G y (F y)

/-- `W : ℝ → SpatialField` is the 1D phase derivative of `V : ℝ → SpatialField` along all iterated
spatial directional jets `ws : List Space`. -/
def HasPhaseJetDeriv (V W : ℝ → SpatialField) : Prop :=
  ∀ (ws : List Space) (τ : ℝ) (y : Space),
    HasDerivAt (fun τ' : ℝ => dirSpatialJet (V τ') ws y) (dirSpatialJet (W τ) ws y) τ

/-- `F : SpatialField` has smooth `L⁴(ℝ³)` Leray projection `G : SpatialField` if `F ∈ L⁴(ℝ³)`,
`G` is `C^∞` on `Space`, and `G` agrees almost everywhere with `RieszLp.lerayLp 4 (hF.toLp F)`. -/
def IsSmoothLerayRep (F G : SpatialField) : Prop :=
  ∃ hF : MemLp F 4 volume, ContDiff ℝ ∞ G ∧
    G =ᵐ[volume]
      (UnforcedLeray.RieszLp.lerayLp 4 (by norm_num) (by norm_num) (hF.toLp F) : SpatialField)

open Classical in
/-- Concrete smooth 3D Cartesian Leray projection on `SpatialField`: returns the unique `C^∞`
representative of `RieszLp.lerayLp 4 (hF.toLp F)` when `∃ G, IsSmoothLerayRep F G`, and `0`
otherwise. -/
def smoothLerayProj (F : SpatialField) : SpatialField :=
  if h : ∃ G : SpatialField, IsSmoothLerayRep F G then h.choose else 0

/-- Slice-wise smooth 3D Cartesian Leray projection `(smoothLeraySlice V) τ = smoothLerayProj (V τ)`. -/
def smoothLeraySlice (V : ℝ → SpatialField) : ℝ → SpatialField :=
  fun τ => smoothLerayProj (V τ)

/-- Concrete bilinear Leray-projected convective operator `𝔓(V · ∇W)` on spatial slice families. -/
def smoothConvectiveLeray (V W : ℝ → SpatialField) : ℝ → SpatialField :=
  smoothLeraySlice (fun τ => spatialConvect (V τ) (W τ))

/-- Binomial Leibniz sum `∑_{j=0}^m (m.choose j) • B (U j) (U (m - j))` of a bilinear slice
operator `B` along a tower `U : ℕ → ℝ → SpatialField`. -/
def leibnizBilinearSum
    (B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField))
    (U : ℕ → ℝ → SpatialField) (m : ℕ) : ℝ → SpatialField :=
  fun τ y => ∑ j ∈ Finset.range (m + 1), (Nat.choose m j : ℝ) • B (U j) (U (m - j)) τ y

/-- Auxiliary finite-stage builder for the strong-recursion Leibniz tower. -/
def leibnizTowerStage
    (L : (ℝ → SpatialField) → (ℝ → SpatialField))
    (B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField))
    (U₀ : ℝ → SpatialField) : ℕ → ℕ → ℝ → SpatialField
  | 0 => fun _ => U₀
  | n + 1 =>
      let prev := leibnizTowerStage L B U₀ n
      fun k => if k ≤ n then prev k else L (prev n) - leibnizBilinearSum B prev n

/-- Strong-recursion tower `U : ℕ → ℝ → SpatialField` generated by `U 0 = U₀` and
`U (m + 1) = L (U m) - leibnizBilinearSum B U m`. -/
def leibnizTower
    (L : (ℝ → SpatialField) → (ℝ → SpatialField))
    (B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField))
    (U₀ : ℝ → SpatialField) (m : ℕ) : ℝ → SpatialField :=
  leibnizTowerStage L B U₀ m m

/-- Concrete higher-order phase-derivative tower `U : ℕ → ℝ → SpatialField` generated from `U₀` by
inductively differentiating `∂_τ U = (1/2)(y · ∇)U + ν ΔU + (1/2)U - 𝔓(U · ∇U)` in `τ`. -/
def bgPhaseDerivTower (ν : ℝ) (U₀ : ℝ → SpatialField) : ℕ → ℝ → SpatialField :=
  leibnizTower (fun V τ => spatialProjectedLin ν (V τ)) smoothConvectiveLeray U₀

namespace HigherPhaseSub

/-! ## 2. Directional spatial jet linearity and composition -/

theorem dirSpatialJet_append (F : SpatialField) :
    ∀ (ws₁ ws₂ : List Space),
      dirSpatialJet (dirSpatialJet F ws₂) ws₁ = dirSpatialJet F (ws₁ ++ ws₂)
  | [], _ => rfl
  | w :: ws₁, ws₂ => by
      funext y
      simp only [dirSpatialJet, List.cons_append, dirSpatialJet_append F ws₁ ws₂]

@[simp]
theorem dirSpatialJet_zero : ∀ (ws : List Space), dirSpatialJet 0 ws = 0
  | [] => rfl
  | w :: ws => by
      funext y
      simp [dirSpatialJet, dirSpatialJet_zero ws]

theorem dirSpatialJet_add {F G : SpatialField}
    (hF : ContDiff ℝ ∞ F) (hG : ContDiff ℝ ∞ G) :
    ∀ (ws : List Space), dirSpatialJet (F + G) ws = dirSpatialJet F ws + dirSpatialJet G ws
  | [] => rfl
  | w :: ws => by
      funext y
      have hdF : DifferentiableAt ℝ (dirSpatialJet F ws) y :=
        JointSmoothSub.differentiable_dirSpatialJet hF ws y
      have hdG : DifferentiableAt ℝ (dirSpatialJet G ws) y :=
        JointSmoothSub.differentiable_dirSpatialJet hG ws y
      simp only [dirSpatialJet, dirSpatialJet_add hF hG ws, Pi.add_apply]
      rw [fderiv_add hdF hdG, add_apply]

theorem dirSpatialJet_smul (c : ℝ) {F : SpatialField} (hF : ContDiff ℝ ∞ F) :
    ∀ (ws : List Space), dirSpatialJet (c • F) ws = c • dirSpatialJet F ws
  | [] => rfl
  | w :: ws => by
      funext y
      have hdF : DifferentiableAt ℝ (dirSpatialJet F ws) y :=
        JointSmoothSub.differentiable_dirSpatialJet hF ws y
      simp only [dirSpatialJet, dirSpatialJet_smul c hF ws, Pi.smul_apply]
      rw [fderiv_const_smul hdF, smul_apply]

theorem dirSpatialJet_neg {F : SpatialField} (hF : ContDiff ℝ ∞ F) (ws : List Space) :
    dirSpatialJet (-F) ws = -dirSpatialJet F ws := by
  have h1 := dirSpatialJet_smul (-1 : ℝ) hF ws
  simpa [neg_one_smul] using h1

theorem dirSpatialJet_sub {F G : SpatialField}
    (hF : ContDiff ℝ ∞ F) (hG : ContDiff ℝ ∞ G) (ws : List Space) :
    dirSpatialJet (F - G) ws = dirSpatialJet F ws - dirSpatialJet G ws := by
  have hnegG : ContDiff ℝ ∞ (-G) := hG.neg
  rw [sub_eq_add_neg, dirSpatialJet_add hF hnegG ws, dirSpatialJet_neg hG ws, ← sub_eq_add_neg]

theorem dirSpatialJet_sum {ι : Type*} (s : Finset ι) {F : ι → SpatialField}
    (hF : ∀ i ∈ s, ContDiff ℝ ∞ (F i)) (ws : List Space) :
    dirSpatialJet (fun y => ∑ i ∈ s, F i y) ws = fun y => ∑ i ∈ s, dirSpatialJet (F i) ws y := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      have h0 : (fun _ : Space => (0 : Space)) = (0 : SpatialField) := rfl
      simp [h0, dirSpatialJet_zero]
  | @insert a s ha ih =>
      have haF : ContDiff ℝ ∞ (F a) := hF a (Finset.mem_insert_self a s)
      have hsF : ∀ i ∈ s, ContDiff ℝ ∞ (F i) :=
        fun i hi => hF i (Finset.mem_insert_of_mem hi)
      have hsumF : ContDiff ℝ ∞ (fun y => ∑ i ∈ s, F i y) :=
        ContDiff.sum fun i hi => hsF i hi
      funext y
      have hsplit : (fun y' => ∑ i ∈ insert a s, F i y') =
          F a + (fun y' => ∑ i ∈ s, F i y') := by
        funext y'
        simp [Finset.sum_insert ha]
      rw [hsplit]
      have hadd := congrFun (dirSpatialJet_add haF hsumF ws) y
      rw [Pi.add_apply, ih hsF] at hadd
      simpa [Finset.sum_insert ha] using hadd

/-! ## 3. Closure of `IsUniformSmoothL4SliceFamily` -/

theorem sliceFamily_contDiff_infty {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (τ : ℝ) :
    ContDiff ℝ ∞ (V τ) :=
  contDiff_infty.2 fun k => hV.slice_contDiff k τ

theorem sliceFamily_aestronglyMeasurable_iteratedFDeriv {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (k : ℕ) (τ : ℝ) :
    AEStronglyMeasurable (fun y => iteratedFDeriv ℝ k (V τ) y) volume :=
  ((sliceFamily_contDiff_infty hV τ).continuous_iteratedFDeriv
    (by exact_mod_cast le_top)).aestronglyMeasurable

theorem sliceFamily_zero :
    IsUniformSmoothL4SliceFamily 0 where
  slice_contDiff _ _ := contDiff_const
  iteratedFDeriv_bounded k := ⟨0, fun _ y => by simp⟩
  l4_bounded k := ⟨0, fun _ => by simp⟩

theorem sliceFamily_add {V W : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (hW : IsUniformSmoothL4SliceFamily W) :
    IsUniformSmoothL4SliceFamily (V + W) where
  slice_contDiff k τ := (hV.slice_contDiff k τ).add (hW.slice_contDiff k τ)
  iteratedFDeriv_bounded k := by
    obtain ⟨MV, hMV⟩ := hV.iteratedFDeriv_bounded k
    obtain ⟨MW, hMW⟩ := hW.iteratedFDeriv_bounded k
    refine ⟨MV + MW, fun τ y => ?_⟩
    have hadd : iteratedFDeriv ℝ k ((V + W) τ) y =
        iteratedFDeriv ℝ k (V τ) y + iteratedFDeriv ℝ k (W τ) y :=
      iteratedFDeriv_add_apply (hV.slice_contDiff k τ).contDiffAt
        (hW.slice_contDiff k τ).contDiffAt
    rw [hadd]
    exact (norm_add_le _ _).trans (add_le_add (hMV τ y) (hMW τ y))
  l4_bounded k := by
    obtain ⟨MV, hMV⟩ := hV.l4_bounded k
    obtain ⟨MW, hMW⟩ := hW.l4_bounded k
    refine ⟨max MV 0 + max MW 0, fun τ => ?_⟩
    have hfun : (fun y => iteratedFDeriv ℝ k ((V + W) τ) y) =
        (fun y => iteratedFDeriv ℝ k (V τ) y) + (fun y => iteratedFDeriv ℝ k (W τ) y) := by
      funext y
      exact iteratedFDeriv_add_apply (hV.slice_contDiff k τ).contDiffAt
        (hW.slice_contDiff k τ).contDiffAt
    rw [hfun]
    calc eLpNorm ((fun y => iteratedFDeriv ℝ k (V τ) y) +
            (fun y => iteratedFDeriv ℝ k (W τ) y)) 4 volume
        ≤ eLpNorm (fun y => iteratedFDeriv ℝ k (V τ) y) 4 volume +
          eLpNorm (fun y => iteratedFDeriv ℝ k (W τ) y) 4 volume :=
          eLpNorm_add_le (sliceFamily_aestronglyMeasurable_iteratedFDeriv hV k τ)
            (sliceFamily_aestronglyMeasurable_iteratedFDeriv hW k τ) (by norm_num)
      _ ≤ ENNReal.ofReal (max MV 0) + ENNReal.ofReal (max MW 0) :=
          add_le_add ((hMV τ).trans (ENNReal.ofReal_le_ofReal (le_max_left MV 0)))
            ((hMW τ).trans (ENNReal.ofReal_le_ofReal (le_max_left MW 0)))
      _ = ENNReal.ofReal (max MV 0 + max MW 0) :=
          (ENNReal.ofReal_add (le_max_right MV 0) (le_max_right MW 0)).symm

theorem sliceFamily_smul (c : ℝ) {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) :
    IsUniformSmoothL4SliceFamily (c • V) where
  slice_contDiff k τ := (hV.slice_contDiff k τ).const_smul c
  iteratedFDeriv_bounded k := by
    obtain ⟨MV, hMV⟩ := hV.iteratedFDeriv_bounded k
    refine ⟨|c| * max MV 0, fun τ y => ?_⟩
    have hsmul : iteratedFDeriv ℝ k (c • V τ) y = c • iteratedFDeriv ℝ k (V τ) y :=
      iteratedFDeriv_const_smul_apply (a := c) (hV.slice_contDiff k τ).contDiffAt
    change ‖iteratedFDeriv ℝ k (c • V τ) y‖ ≤ |c| * max MV 0
    rw [hsmul, norm_smul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left ((hMV τ y).trans (le_max_left MV 0)) (abs_nonneg c)
  l4_bounded k := by
    obtain ⟨MV, hMV⟩ := hV.l4_bounded k
    refine ⟨|c| * max MV 0, fun τ => ?_⟩
    have hfun : (fun y => iteratedFDeriv ℝ k ((c • V) τ) y) =
        c • (fun y => iteratedFDeriv ℝ k (V τ) y) := by
      funext y
      exact iteratedFDeriv_const_smul_apply (a := c) (hV.slice_contDiff k τ).contDiffAt
    rw [hfun, eLpNorm_const_smul, Real.enorm_eq_ofReal_abs,
      ENNReal.ofReal_mul (abs_nonneg c)]
    have hle := (hMV τ).trans (ENNReal.ofReal_le_ofReal (le_max_left MV 0))
    gcongr

theorem sliceFamily_neg {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) :
    IsUniformSmoothL4SliceFamily (-V) := by
  simpa [neg_one_smul] using sliceFamily_smul (-1 : ℝ) hV

theorem sliceFamily_sub {V W : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (hW : IsUniformSmoothL4SliceFamily W) :
    IsUniformSmoothL4SliceFamily (V - W) := by
  rw [sub_eq_add_neg]
  exact sliceFamily_add hV (sliceFamily_neg hW)

theorem sliceFamily_sum {ι : Type*} (s : Finset ι) {F : ι → ℝ → SpatialField}
    (hF : ∀ i ∈ s, IsUniformSmoothL4SliceFamily (F i)) :
    IsUniformSmoothL4SliceFamily (fun τ y => ∑ i ∈ s, F i τ y) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      exact sliceFamily_zero
  | @insert a s ha ih =>
      have haF := hF a (Finset.mem_insert_self a s)
      have hsF := ih fun i hi => hF i (Finset.mem_insert_of_mem hi)
      have hsplit : (fun τ y => ∑ i ∈ insert a s, F i τ y) =
          F a + (fun τ y => ∑ i ∈ s, F i τ y) := by
        funext τ y
        simp [Finset.sum_insert ha]
      rw [hsplit]
      exact sliceFamily_add haF hsF

theorem sliceFamily_dirSpatialJet {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (ws₀ : List Space) :
    IsUniformSmoothL4SliceFamily (fun τ => dirSpatialJet (V τ) ws₀) where
  slice_contDiff k τ :=
    (JointSmoothSub.contDiff_infty_dirSpatialJet (sliceFamily_contDiff_infty hV τ) ws₀).of_le
      (by exact_mod_cast le_top)
  iteratedFDeriv_bounded k := by
    obtain ⟨M, hM⟩ := hV.iteratedFDeriv_bounded (k + ws₀.length)
    have hprod : 0 ≤ (ws₀.map norm).prod :=
      List.prod_nonneg fun r hr => by
        obtain ⟨w, _, rfl⟩ := List.mem_map.1 hr
        exact norm_nonneg w
    refine ⟨max M 0 * (ws₀.map norm).prod, fun τ y => ?_⟩
    exact (JointSmoothSub.norm_iteratedFDeriv_dirSpatialJet_le
      (sliceFamily_contDiff_infty hV τ) ws₀ k y).trans
      (mul_le_mul_of_nonneg_right ((hM τ y).trans (le_max_left M 0)) hprod)
  l4_bounded k := by
    obtain ⟨M, hM⟩ := hV.l4_bounded (k + ws₀.length)
    set P : ℝ := (ws₀.map norm).prod
    have hP : 0 ≤ P :=
      List.prod_nonneg fun r hr => by
        obtain ⟨w, _, rfl⟩ := List.mem_map.1 hr
        exact norm_nonneg w
    refine ⟨P * max M 0, fun τ => ?_⟩
    have hpt : ∀ y : Space,
        ‖iteratedFDeriv ℝ k (dirSpatialJet (V τ) ws₀) y‖ ≤
          ‖(P • fun y' => iteratedFDeriv ℝ (k + ws₀.length) (V τ) y') y‖ := by
      intro y
      rw [Pi.smul_apply, norm_smul, Real.norm_of_nonneg hP, mul_comm]
      exact JointSmoothSub.norm_iteratedFDeriv_dirSpatialJet_le
        (sliceFamily_contDiff_infty hV τ) ws₀ k y
    have hle := (hM τ).trans (ENNReal.ofReal_le_ofReal (le_max_left M 0))
    calc eLpNorm (fun y => iteratedFDeriv ℝ k (dirSpatialJet (V τ) ws₀) y) 4 volume
        ≤ eLpNorm (P • fun y => iteratedFDeriv ℝ (k + ws₀.length) (V τ) y) 4 volume :=
          eLpNorm_mono hpt
      _ = ENNReal.ofReal P *
            eLpNorm (fun y => iteratedFDeriv ℝ (k + ws₀.length) (V τ) y) 4 volume := by
          rw [eLpNorm_const_smul, Real.enorm_of_nonneg hP]
      _ ≤ ENNReal.ofReal P * ENNReal.ofReal (max M 0) := by gcongr
      _ = ENNReal.ofReal (P * max M 0) :=
          (ENNReal.ofReal_mul hP).symm

theorem sliceFamily_spatialPartial {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (j : Fin 3) :
    IsUniformSmoothL4SliceFamily (fun τ => spatialPartial j (V τ)) :=
  sliceFamily_dirSpatialJet hV [EuclideanSpace.single j 1]

theorem sliceFamily_spatialLaplacian {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) :
    IsUniformSmoothL4SliceFamily (fun τ => spatialLaplacian (V τ)) :=
  sliceFamily_sum Finset.univ fun j _ =>
    sliceFamily_dirSpatialJet hV [EuclideanSpace.single j 1, EuclideanSpace.single j 1]

theorem sliceFamily_spatialDiffReact (ν : ℝ) {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) :
    IsUniformSmoothL4SliceFamily (fun τ => spatialDiffReact ν (V τ)) :=
  sliceFamily_add (sliceFamily_smul ν (sliceFamily_spatialLaplacian hV))
    (sliceFamily_smul (1 / 2 : ℝ) hV)

/-! ### Bilinear convective product `(V · ∇)W` in `IsUniformSmoothL4SliceFamily` -/

/-- Coordinate projection `y ↦ y j` on `Space` has operator norm at most `1`. -/
private theorem norm_proj_le_one (j : Fin 3) :
    ‖(EuclideanSpace.proj j : Space →L[ℝ] ℝ)‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun v => ?_
  rw [one_mul]
  exact PiLp.norm_apply_le v j

/-- Iterated derivative bound for a scalar coordinate component `y ↦ F y j` of `F : SpatialField`. -/
private theorem norm_iteratedFDeriv_coord_le {F : SpatialField} (hF : ContDiff ℝ ∞ F)
    (j : Fin 3) (i : ℕ) (y : Space) :
    ‖iteratedFDeriv ℝ i (fun y' : Space => F y' j) y‖ ≤ ‖iteratedFDeriv ℝ i F y‖ := by
  have hcomp : (fun y' : Space => F y' j) = (EuclideanSpace.proj j : Space →L[ℝ] ℝ) ∘ F := rfl
  rw [hcomp]
  calc ‖iteratedFDeriv ℝ i ((EuclideanSpace.proj j : Space →L[ℝ] ℝ) ∘ F) y‖
      ≤ ‖(EuclideanSpace.proj j : Space →L[ℝ] ℝ)‖ * ‖iteratedFDeriv ℝ i F y‖ :=
        ContinuousLinearMap.norm_iteratedFDeriv_comp_left _ hF.contDiffAt (by exact_mod_cast le_top)
    _ ≤ 1 * ‖iteratedFDeriv ℝ i F y‖ :=
        mul_le_mul_of_nonneg_right (norm_proj_le_one j) (norm_nonneg _)
    _ = ‖iteratedFDeriv ℝ i F y‖ := one_mul _

/-- Triangle inequality for `eLpNorm · 4 volume` over a `Finset.sum` of nonnegatively-weighted
functions. -/
private theorem eLpNorm_sum_le {ι : Type*} (s : Finset ι) {f : ι → Space → ℝ}
    (hf : ∀ i ∈ s, AEStronglyMeasurable (f i) volume) :
    eLpNorm (fun y => ∑ i ∈ s, f i y) 4 volume ≤
      ∑ i ∈ s, eLpNorm (f i) 4 volume := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp
  | @insert a s ha ih =>
      have ha_m := hf a (Finset.mem_insert_self a s)
      have hs_m : ∀ i ∈ s, AEStronglyMeasurable (f i) volume :=
        fun i hi => hf i (Finset.mem_insert_of_mem hi)
      have hsum_m : AEStronglyMeasurable (fun y => ∑ i ∈ s, f i y) volume :=
        Finset.aestronglyMeasurable_fun_sum s hs_m
      have hsplit : (fun y => ∑ i ∈ insert a s, f i y) =
          f a + (fun y => ∑ i ∈ s, f i y) := by
        funext y
        simp [Finset.sum_insert ha]
      rw [hsplit, Finset.sum_insert ha]
      exact (eLpNorm_add_le ha_m hsum_m (by norm_num)).trans (add_le_add_right (ih hs_m) _)

/-- Scalar-vector product `(V τ y j) • H τ y` of two families in `IsUniformSmoothL4SliceFamily`
lies in `IsUniformSmoothL4SliceFamily`. -/
theorem sliceFamily_coord_smul (j : Fin 3) {V H : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (hH : IsUniformSmoothL4SliceFamily H) :
    IsUniformSmoothL4SliceFamily (fun τ y => (V τ y j) • H τ y) where
  slice_contDiff k τ := by
    have hVj : ContDiff ℝ k (fun y : Space => V τ y j) :=
      (EuclideanSpace.proj j : Space →L[ℝ] ℝ).contDiff.comp (hV.slice_contDiff k τ)
    exact hVj.smul (hH.slice_contDiff k τ)
  iteratedFDeriv_bounded k := by
    choose MV hMV using fun i => hV.iteratedFDeriv_bounded i
    choose MH hMH using fun i => hH.iteratedFDeriv_bounded i
    refine ⟨∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * max (MV i) 0 * max (MH (k - i)) 0, fun τ y => ?_⟩
    have hVi : ContDiff ℝ ∞ (fun y' : Space => V τ y' j) :=
      (EuclideanSpace.proj j : Space →L[ℝ] ℝ).contDiff.comp (sliceFamily_contDiff_infty hV τ)
    have hHi : ContDiff ℝ ∞ (H τ) := sliceFamily_contDiff_infty hH τ
    calc ‖iteratedFDeriv ℝ k (fun y' : Space => (V τ y' j) • H τ y') y‖
        ≤ ∑ i ∈ Finset.range (k + 1),
            (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i (fun y' : Space => V τ y' j) y‖ *
              ‖iteratedFDeriv ℝ (k - i) (H τ) y‖ :=
          norm_iteratedFDeriv_smul_le hVi hHi y (by exact_mod_cast le_top)
      _ ≤ ∑ i ∈ Finset.range (k + 1),
            (k.choose i : ℝ) * max (MV i) 0 * max (MH (k - i)) 0 := by
          refine Finset.sum_le_sum fun i _ => ?_
          have h1 : ‖iteratedFDeriv ℝ i (fun y' : Space => V τ y' j) y‖ ≤ max (MV i) 0 :=
            (norm_iteratedFDeriv_coord_le (sliceFamily_contDiff_infty hV τ) j i y).trans
              ((hMV i τ y).trans (le_max_left _ _))
          have h2 : ‖iteratedFDeriv ℝ (k - i) (H τ) y‖ ≤ max (MH (k - i)) 0 :=
            (hMH (k - i) τ y).trans (le_max_left _ _)
          gcongr
  l4_bounded k := by
    choose MV hMV using fun i => hV.iteratedFDeriv_bounded i
    choose MH hMH using fun i => hH.l4_bounded i
    set c : ℕ → ℝ := fun i => (k.choose i : ℝ) * max (MV i) 0
    have hc : ∀ i, 0 ≤ c i := fun i => by positivity
    refine ⟨∑ i ∈ Finset.range (k + 1), c i * max (MH (k - i)) 0, fun τ => ?_⟩
    have hVi : ContDiff ℝ ∞ (fun y' : Space => V τ y' j) :=
      (EuclideanSpace.proj j : Space →L[ℝ] ℝ).contDiff.comp (sliceFamily_contDiff_infty hV τ)
    have hHi : ContDiff ℝ ∞ (H τ) := sliceFamily_contDiff_infty hH τ
    have hpt : ∀ y : Space,
        ‖iteratedFDeriv ℝ k (fun y' : Space => (V τ y' j) • H τ y') y‖ ≤
          ‖∑ i ∈ Finset.range (k + 1),
            c i * ‖iteratedFDeriv ℝ (k - i) (H τ) y‖‖ := by
      intro y
      have hsum_nonneg : 0 ≤ ∑ i ∈ Finset.range (k + 1),
          c i * ‖iteratedFDeriv ℝ (k - i) (H τ) y‖ :=
        Finset.sum_nonneg fun i _ => mul_nonneg (hc i) (norm_nonneg _)
      rw [Real.norm_of_nonneg hsum_nonneg]
      refine (norm_iteratedFDeriv_smul_le hVi hHi y (by exact_mod_cast le_top)).trans ?_
      refine Finset.sum_le_sum fun i _ => ?_
      have h1 : ‖iteratedFDeriv ℝ i (fun y' : Space => V τ y' j) y‖ ≤ max (MV i) 0 :=
        (norm_iteratedFDeriv_coord_le (sliceFamily_contDiff_infty hV τ) j i y).trans
          ((hMV i τ y).trans (le_max_left _ _))
      dsimp [c]
      gcongr
    have hmeas : ∀ i ∈ Finset.range (k + 1),
        AEStronglyMeasurable (fun y : Space => c i * ‖iteratedFDeriv ℝ (k - i) (H τ) y‖) volume :=
      fun i _ => (sliceFamily_aestronglyMeasurable_iteratedFDeriv hH (k - i) τ).norm.const_mul (c i)
    calc eLpNorm (fun y => iteratedFDeriv ℝ k (fun y' : Space => (V τ y' j) • H τ y') y) 4 volume
        ≤ eLpNorm (fun y => ∑ i ∈ Finset.range (k + 1),
            c i * ‖iteratedFDeriv ℝ (k - i) (H τ) y‖) 4 volume :=
          eLpNorm_mono hpt
      _ ≤ ∑ i ∈ Finset.range (k + 1),
            eLpNorm (fun y => c i * ‖iteratedFDeriv ℝ (k - i) (H τ) y‖) 4 volume :=
          eLpNorm_sum_le (Finset.range (k + 1)) hmeas
      _ ≤ ∑ i ∈ Finset.range (k + 1), ENNReal.ofReal (c i * max (MH (k - i)) 0) := by
          refine Finset.sum_le_sum fun i _ => ?_
          have hsm : (fun y : Space => c i * ‖iteratedFDeriv ℝ (k - i) (H τ) y‖) =
              c i • (fun y : Space => ‖iteratedFDeriv ℝ (k - i) (H τ) y‖) := rfl
          rw [hsm, eLpNorm_const_smul, Real.enorm_of_nonneg (hc i), eLpNorm_norm,
            ENNReal.ofReal_mul (hc i)]
          have hle : eLpNorm (fun y => iteratedFDeriv ℝ (k - i) (H τ) y) 4 volume ≤
              ENNReal.ofReal (max (MH (k - i)) 0) :=
            (hMH (k - i) τ).trans (ENNReal.ofReal_le_ofReal (le_max_left (MH (k - i)) 0))
          gcongr
      _ = ENNReal.ofReal (∑ i ∈ Finset.range (k + 1), c i * max (MH (k - i)) 0) := by
          rw [ENNReal.ofReal_sum_of_nonneg]
          intro i _
          exact mul_nonneg (hc i) (le_max_right _ _)

/-- Coordinate decomposition of `spatialConvect`:
`spatialConvect F G y = ∑ j : Fin 3, (F y j) • spatialPartial j G y`. -/
theorem spatialConvect_eq_sum (F G : SpatialField) (y : Space) :
    spatialConvect F G y = ∑ j : Fin 3, (F y j) • spatialPartial j G y := by
  dsimp [spatialConvect, spatialPartial, dirSpatialJet]
  have hv : F y = ∑ j : Fin 3, (F y j) • EuclideanSpace.single j (1 : ℝ) := by
    ext k
    simp [Finset.sum_apply, Pi.single_apply]
  conv_lhs => rw [hv]
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_smul]

/-- If `V, W : ℝ → SpatialField` lie in `IsUniformSmoothL4SliceFamily`, then their convective
product `fun τ => spatialConvect (V τ) (W τ)` lies in `IsUniformSmoothL4SliceFamily`. -/
theorem sliceFamily_spatialConvect {V W : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) (hW : IsUniformSmoothL4SliceFamily W) :
    IsUniformSmoothL4SliceFamily (fun τ => spatialConvect (V τ) (W τ)) := by
  have hfun : (fun τ => spatialConvect (V τ) (W τ)) =
      fun τ y => ∑ j : Fin 3, (V τ y j) • spatialPartial j (W τ) y := by
    funext τ y
    exact spatialConvect_eq_sum (V τ) (W τ) y
  rw [hfun]
  exact sliceFamily_sum Finset.univ fun j _ =>
    sliceFamily_coord_smul j hV (sliceFamily_spatialPartial hW j)

/-! ## 4. 1D phase-jet calculus (`HasPhaseJetDeriv`) -/

theorem hasPhaseJetDeriv_unique {V W₁ W₂ : ℝ → SpatialField}
    (h₁ : HasPhaseJetDeriv V W₁) (h₂ : HasPhaseJetDeriv V W₂) :
    W₁ = W₂ := by
  funext τ y
  exact (h₁ [] τ y).unique (h₂ [] τ y)

theorem hasPhaseJetDeriv_const (F : SpatialField) :
    HasPhaseJetDeriv (fun _ => F) 0 := by
  intro ws τ y
  simpa [dirSpatialJet_zero] using hasDerivAt_const τ (dirSpatialJet F ws y)

theorem hasPhaseJetDeriv_zero :
    HasPhaseJetDeriv 0 0 :=
  hasPhaseJetDeriv_const 0

theorem hasPhaseJetDeriv_add {V V' W W' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (hW : ∀ τ, ContDiff ℝ ∞ (W τ)) (hW' : ∀ τ, ContDiff ℝ ∞ (W' τ))
    (dV : HasPhaseJetDeriv V V') (dW : HasPhaseJetDeriv W W') :
    HasPhaseJetDeriv (V + W) (V' + W') := by
  intro ws τ y
  have hfun : (fun τ' => dirSpatialJet ((V + W) τ') ws y) =
      (fun τ' => dirSpatialJet (V τ') ws y + dirSpatialJet (W τ') ws y) := by
    funext τ'
    exact congrFun (dirSpatialJet_add (hV τ') (hW τ') ws) y
  have hval : dirSpatialJet ((V' + W') τ) ws y =
      dirSpatialJet (V' τ) ws y + dirSpatialJet (W' τ) ws y :=
    congrFun (dirSpatialJet_add (hV' τ) (hW' τ) ws) y
  rw [hfun, hval]
  exact (dV ws τ y).add (dW ws τ y)

theorem hasPhaseJetDeriv_smul (c : ℝ) {V V' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (dV : HasPhaseJetDeriv V V') :
    HasPhaseJetDeriv (c • V) (c • V') := by
  intro ws τ y
  have hfun : (fun τ' => dirSpatialJet ((c • V) τ') ws y) =
      (fun τ' => c • dirSpatialJet (V τ') ws y) := by
    funext τ'
    exact congrFun (dirSpatialJet_smul c (hV τ') ws) y
  have hval : dirSpatialJet ((c • V') τ) ws y = c • dirSpatialJet (V' τ) ws y :=
    congrFun (dirSpatialJet_smul c (hV' τ) ws) y
  rw [hfun, hval]
  exact (dV ws τ y).const_smul c

theorem hasPhaseJetDeriv_neg {V V' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (dV : HasPhaseJetDeriv V V') :
    HasPhaseJetDeriv (-V) (-V') := by
  simpa [neg_one_smul] using hasPhaseJetDeriv_smul (-1 : ℝ) hV hV' dV

theorem hasPhaseJetDeriv_sub {V V' W W' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (hW : ∀ τ, ContDiff ℝ ∞ (W τ)) (hW' : ∀ τ, ContDiff ℝ ∞ (W' τ))
    (dV : HasPhaseJetDeriv V V') (dW : HasPhaseJetDeriv W W') :
    HasPhaseJetDeriv (V - W) (V' - W') := by
  rw [sub_eq_add_neg, sub_eq_add_neg]
  exact hasPhaseJetDeriv_add hV hV' (fun τ => (hW τ).neg) (fun τ => (hW' τ).neg)
    dV (hasPhaseJetDeriv_neg hW hW' dW)

theorem hasPhaseJetDeriv_sum {ι : Type*} (s : Finset ι) {F F' : ι → ℝ → SpatialField}
    (hF : ∀ i ∈ s, ∀ τ, ContDiff ℝ ∞ (F i τ))
    (hF' : ∀ i ∈ s, ∀ τ, ContDiff ℝ ∞ (F' i τ))
    (dF : ∀ i ∈ s, HasPhaseJetDeriv (F i) (F' i)) :
    HasPhaseJetDeriv (fun τ y => ∑ i ∈ s, F i τ y) (fun τ y => ∑ i ∈ s, F' i τ y) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      exact hasPhaseJetDeriv_zero
  | @insert a s ha ih =>
      have haF := hF a (Finset.mem_insert_self a s)
      have haF' := hF' a (Finset.mem_insert_self a s)
      have hsF : ∀ i ∈ s, ∀ τ, ContDiff ℝ ∞ (F i τ) :=
        fun i hi => hF i (Finset.mem_insert_of_mem hi)
      have hsF' : ∀ i ∈ s, ∀ τ, ContDiff ℝ ∞ (F' i τ) :=
        fun i hi => hF' i (Finset.mem_insert_of_mem hi)
      have hsumF : ∀ τ, ContDiff ℝ ∞ (fun y => ∑ i ∈ s, F i τ y) :=
        fun τ => ContDiff.sum fun i hi => hsF i hi τ
      have hsumF' : ∀ τ, ContDiff ℝ ∞ (fun y => ∑ i ∈ s, F' i τ y) :=
        fun τ => ContDiff.sum fun i hi => hsF' i hi τ
      have hsplit1 : (fun τ y => ∑ i ∈ insert a s, F i τ y) =
          F a + (fun τ y => ∑ i ∈ s, F i τ y) := by
        funext τ y
        simp [Finset.sum_insert ha]
      have hsplit2 : (fun τ y => ∑ i ∈ insert a s, F' i τ y) =
          F' a + (fun τ y => ∑ i ∈ s, F' i τ y) := by
        funext τ y
        simp [Finset.sum_insert ha]
      rw [hsplit1, hsplit2]
      exact hasPhaseJetDeriv_add haF haF' hsumF hsumF'
        (dF a (Finset.mem_insert_self a s))
        (ih hsF hsF' fun i hi => dF i (Finset.mem_insert_of_mem hi))

theorem hasPhaseJetDeriv_dirSpatialJet {V V' : ℝ → SpatialField}
    (dV : HasPhaseJetDeriv V V') (ws₀ : List Space) :
    HasPhaseJetDeriv (fun τ => dirSpatialJet (V τ) ws₀) (fun τ => dirSpatialJet (V' τ) ws₀) := by
  intro ws τ y
  have hfun : (fun τ' => dirSpatialJet (dirSpatialJet (V τ') ws₀) ws y) =
      (fun τ' => dirSpatialJet (V τ') (ws ++ ws₀) y) := by
    funext τ'
    exact congrFun (dirSpatialJet_append (V τ') ws ws₀) y
  have hval : dirSpatialJet (dirSpatialJet (V' τ) ws₀) ws y =
      dirSpatialJet (V' τ) (ws ++ ws₀) y :=
    congrFun (dirSpatialJet_append (V' τ) ws ws₀) y
  rw [hfun, hval]
  exact dV (ws ++ ws₀) τ y

theorem hasPhaseJetDeriv_spatialPartial {V V' : ℝ → SpatialField}
    (dV : HasPhaseJetDeriv V V') (j : Fin 3) :
    HasPhaseJetDeriv (fun τ => spatialPartial j (V τ)) (fun τ => spatialPartial j (V' τ)) :=
  hasPhaseJetDeriv_dirSpatialJet dV [EuclideanSpace.single j 1]

theorem hasPhaseJetDeriv_spatialLaplacian {V V' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (dV : HasPhaseJetDeriv V V') :
    HasPhaseJetDeriv (fun τ => spatialLaplacian (V τ)) (fun τ => spatialLaplacian (V' τ)) :=
  hasPhaseJetDeriv_sum Finset.univ
    (fun j _ τ => JointSmoothSub.contDiff_infty_dirSpatialJet (hV τ)
      [EuclideanSpace.single j 1, EuclideanSpace.single j 1])
    (fun j _ τ => JointSmoothSub.contDiff_infty_dirSpatialJet (hV' τ)
      [EuclideanSpace.single j 1, EuclideanSpace.single j 1])
    (fun j _ => hasPhaseJetDeriv_dirSpatialJet dV
      [EuclideanSpace.single j 1, EuclideanSpace.single j 1])

theorem hasPhaseJetDeriv_spatialDiffReact (ν : ℝ) {V V' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (dV : HasPhaseJetDeriv V V') :
    HasPhaseJetDeriv (fun τ => spatialDiffReact ν (V τ)) (fun τ => spatialDiffReact ν (V' τ)) := by
  have hL : ∀ τ, ContDiff ℝ ∞ (spatialLaplacian (V τ)) :=
    fun τ => ContDiff.sum fun j _ =>
      JointSmoothSub.contDiff_infty_dirSpatialJet (hV τ)
        [EuclideanSpace.single j 1, EuclideanSpace.single j 1]
  have hL' : ∀ τ, ContDiff ℝ ∞ (spatialLaplacian (V' τ)) :=
    fun τ => ContDiff.sum fun j _ =>
      JointSmoothSub.contDiff_infty_dirSpatialJet (hV' τ)
        [EuclideanSpace.single j 1, EuclideanSpace.single j 1]
  exact hasPhaseJetDeriv_add
    (fun τ => (hL τ).const_smul ν) (fun τ => (hL' τ).const_smul ν)
    (fun τ => (hV τ).const_smul (1 / 2 : ℝ)) (fun τ => (hV' τ).const_smul (1 / 2 : ℝ))
    (hasPhaseJetDeriv_smul ν hL hL' (hasPhaseJetDeriv_spatialLaplacian hV hV' dV))
    (hasPhaseJetDeriv_smul (1 / 2 : ℝ) hV hV' dV)

/-- Single-direction product rule for `dirSpatialJet (fun y => (F y j) • H y) [w]`. -/
private theorem dirSpatialJet_coord_smul_singleton (j : Fin 3) {F H : SpatialField}
    (hF : ContDiff ℝ ∞ F) (hH : ContDiff ℝ ∞ H) (w : Space) :
    dirSpatialJet (fun y => (F y j) • H y) [w] =
      (fun y => (dirSpatialJet F [w] y j) • H y) +
        (fun y => (F y j) • dirSpatialJet H [w] y) := by
  funext y
  change fderiv ℝ (fun y' : Space => ((EuclideanSpace.proj j : Space →L[ℝ] ℝ) (F y')) • H y') y w =
    (fderiv ℝ F y w j) • H y + (F y j) • fderiv ℝ H y w
  have hdF : HasFDerivAt F (fderiv ℝ F y) y :=
    (hF.differentiable (by simp) y).hasFDerivAt
  have hdFj : HasFDerivAt (fun y' : Space => (EuclideanSpace.proj j : Space →L[ℝ] ℝ) (F y'))
      ((EuclideanSpace.proj j : Space →L[ℝ] ℝ).comp (fderiv ℝ F y)) y :=
    (EuclideanSpace.proj j : Space →L[ℝ] ℝ).hasFDerivAt.comp y hdF
  have hdH : HasFDerivAt H (fderiv ℝ H y) y :=
    (hH.differentiable (by simp) y).hasFDerivAt
  have hdf := (hdFj.smul hdH).fderiv
  change fderiv ℝ ((fun y' : Space => (EuclideanSpace.proj j : Space →L[ℝ] ℝ) (F y')) • H) y w = _
  rw [hdf]
  simp [add_comm]

/-- Smoothness of `fun y => (F y j) • H y` for smooth `F, H : SpatialField`. -/
private theorem contDiff_infty_coord_smul (j : Fin 3) {F H : SpatialField}
    (hF : ContDiff ℝ ∞ F) (hH : ContDiff ℝ ∞ H) :
    ContDiff ℝ ∞ (fun y : Space => (F y j) • H y) :=
  ((EuclideanSpace.proj j : Space →L[ℝ] ℝ).contDiff.comp hF).smul hH

/-- Product rule for `HasPhaseJetDeriv` on `(fun τ y => (V τ y j) • H τ y)`, proved by reverse list
induction (`List.reverseRecOn`) on the spatial direction list `ws : List Space`. -/
theorem hasPhaseJetDeriv_coord_smul (j : Fin 3) {V V' H H' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (hH : ∀ τ, ContDiff ℝ ∞ (H τ)) (hH' : ∀ τ, ContDiff ℝ ∞ (H' τ))
    (dV : HasPhaseJetDeriv V V') (dH : HasPhaseJetDeriv H H') :
    HasPhaseJetDeriv (fun τ y => (V τ y j) • H τ y)
      (fun τ y => (V' τ y j) • H τ y + (V τ y j) • H' τ y) := by
  intro ws
  induction ws using List.reverseRecOn generalizing V V' H H' with
  | nil =>
      intro τ y
      simp only [dirSpatialJet]
      have hdVj : HasDerivAt (fun τ' : ℝ => (EuclideanSpace.proj j : Space →L[ℝ] ℝ) (V τ' y))
          ((EuclideanSpace.proj j : Space →L[ℝ] ℝ) (V' τ y)) τ :=
        (EuclideanSpace.proj j : Space →L[ℝ] ℝ).hasFDerivAt.comp_hasDerivAt τ (dV [] τ y)
      exact (hdVj.smul (dH [] τ y)).congr_deriv (add_comm _ _)
  | append_singleton ws w ih =>
      intro τ y
      have hfun : (fun τ' : ℝ => dirSpatialJet (fun y' => (V τ' y' j) • H τ' y') (ws ++ [w]) y) =
          (fun τ' : ℝ =>
            dirSpatialJet (fun y' => (dirSpatialJet (V τ') [w] y' j) • H τ' y') ws y +
            dirSpatialJet (fun y' => (V τ' y' j) • dirSpatialJet (H τ') [w] y') ws y) := by
        funext τ'
        have h1 := (congrFun (dirSpatialJet_append
          (fun y' => (V τ' y' j) • H τ' y') ws [w]) y).symm
        rw [h1, dirSpatialJet_coord_smul_singleton j (hV τ') (hH τ') w]
        exact congrFun (dirSpatialJet_add
          (contDiff_infty_coord_smul j
            (JointSmoothSub.contDiff_infty_dirSpatialJet (hV τ') [w]) (hH τ'))
          (contDiff_infty_coord_smul j
            (hV τ') (JointSmoothSub.contDiff_infty_dirSpatialJet (hH τ') [w])) ws) y
      have hval :
          dirSpatialJet (fun y' => (V' τ y' j) • H τ y' + (V τ y' j) • H' τ y') (ws ++ [w]) y =
          (dirSpatialJet (fun y' =>
              (dirSpatialJet (V' τ) [w] y' j) • H τ y' +
              (dirSpatialJet (V τ) [w] y' j) • H' τ y') ws y) +
          (dirSpatialJet (fun y' =>
              (V' τ y' j) • dirSpatialJet (H τ) [w] y' +
              (V τ y' j) • dirSpatialJet (H' τ) [w] y') ws y) := by
        have h1 := (congrFun (dirSpatialJet_append
          (fun y' => (V' τ y' j) • H τ y' + (V τ y' j) • H' τ y') ws [w]) y).symm
        rw [h1]
        have hadd1 := dirSpatialJet_add
          (contDiff_infty_coord_smul j (hV' τ) (hH τ))
          (contDiff_infty_coord_smul j (hV τ) (hH' τ)) [w]
        change dirSpatialJet
          (dirSpatialJet ((fun y' => (V' τ y' j) • H τ y') + (fun y' => (V τ y' j) • H' τ y')) [w])
          ws y = _
        rw [hadd1,
          dirSpatialJet_coord_smul_singleton j (hV' τ) (hH τ) w,
          dirSpatialJet_coord_smul_singleton j (hV τ) (hH' τ) w]
        have hrearr :
            ((fun y' => (dirSpatialJet (V' τ) [w] y' j) • H τ y') +
              (fun y' => (V' τ y' j) • dirSpatialJet (H τ) [w] y')) +
            ((fun y' => (dirSpatialJet (V τ) [w] y' j) • H' τ y') +
              (fun y' => (V τ y' j) • dirSpatialJet (H' τ) [w] y')) =
            (fun y' =>
              (dirSpatialJet (V' τ) [w] y' j) • H τ y' +
              (dirSpatialJet (V τ) [w] y' j) • H' τ y') +
            (fun y' =>
              (V' τ y' j) • dirSpatialJet (H τ) [w] y' +
              (V τ y' j) • dirSpatialJet (H' τ) [w] y') := by
          funext y'
          simp only [Pi.add_apply]
          abel
        rw [hrearr]
        exact congrFun (dirSpatialJet_add
          ((contDiff_infty_coord_smul j
            (JointSmoothSub.contDiff_infty_dirSpatialJet (hV' τ) [w]) (hH τ)).add
            (contDiff_infty_coord_smul j
              (JointSmoothSub.contDiff_infty_dirSpatialJet (hV τ) [w]) (hH' τ)))
          ((contDiff_infty_coord_smul j
            (hV' τ) (JointSmoothSub.contDiff_infty_dirSpatialJet (hH τ) [w])).add
            (contDiff_infty_coord_smul j
              (hV τ) (JointSmoothSub.contDiff_infty_dirSpatialJet (hH' τ) [w]))) ws) y
      rw [hfun, hval]
      have hd1 := ih
        (fun τ' => JointSmoothSub.contDiff_infty_dirSpatialJet (hV τ') [w])
        (fun τ' => JointSmoothSub.contDiff_infty_dirSpatialJet (hV' τ') [w])
        hH hH' (hasPhaseJetDeriv_dirSpatialJet dV [w]) dH τ y
      have hd2 := ih hV hV'
        (fun τ' => JointSmoothSub.contDiff_infty_dirSpatialJet (hH τ') [w])
        (fun τ' => JointSmoothSub.contDiff_infty_dirSpatialJet (hH' τ') [w])
        dV (hasPhaseJetDeriv_dirSpatialJet dH [w]) τ y
      exact hd1.add hd2

/-- Smoothness of `spatialConvect F G` for smooth `F, G : SpatialField`. -/
theorem contDiff_infty_spatialConvect {F G : SpatialField}
    (hF : ContDiff ℝ ∞ F) (hG : ContDiff ℝ ∞ G) :
    ContDiff ℝ ∞ (spatialConvect F G) := by
  have hfun : spatialConvect F G = fun y => ∑ j : Fin 3, (F y j) • spatialPartial j G y :=
    funext (spatialConvect_eq_sum F G)
  rw [hfun]
  exact ContDiff.sum fun j _ =>
    contDiff_infty_coord_smul j hF
      (JointSmoothSub.contDiff_infty_dirSpatialJet hG [EuclideanSpace.single j 1])

/-- Bilinear product rule for `HasPhaseJetDeriv` on `spatialConvect`:
`∂_τ(V · ∇W) = (∂_τ V) · ∇W + V · ∇(∂_τ W)` along all iterated spatial directional jets. -/
theorem hasPhaseJetDeriv_spatialConvect {V V' W W' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (hW : ∀ τ, ContDiff ℝ ∞ (W τ)) (hW' : ∀ τ, ContDiff ℝ ∞ (W' τ))
    (dV : HasPhaseJetDeriv V V') (dW : HasPhaseJetDeriv W W') :
    HasPhaseJetDeriv (fun τ => spatialConvect (V τ) (W τ))
      (fun τ => spatialConvect (V' τ) (W τ) + spatialConvect (V τ) (W' τ)) := by
  have hfun1 : (fun τ => spatialConvect (V τ) (W τ)) =
      fun τ y => ∑ j : Fin 3, (V τ y j) • spatialPartial j (W τ) y := by
    funext τ y
    exact spatialConvect_eq_sum (V τ) (W τ) y
  have hfun2 : (fun τ => spatialConvect (V' τ) (W τ) + spatialConvect (V τ) (W' τ)) =
      fun τ y => ∑ j : Fin 3,
        ((V' τ y j) • spatialPartial j (W τ) y + (V τ y j) • spatialPartial j (W' τ) y) := by
    funext τ y
    simp only [Pi.add_apply, spatialConvect_eq_sum, Finset.sum_add_distrib]
  rw [hfun1, hfun2]
  refine hasPhaseJetDeriv_sum Finset.univ
    (fun j _ τ => contDiff_infty_coord_smul j (hV τ)
      (JointSmoothSub.contDiff_infty_dirSpatialJet (hW τ) [EuclideanSpace.single j 1]))
    (fun j _ τ => (contDiff_infty_coord_smul j (hV' τ)
      (JointSmoothSub.contDiff_infty_dirSpatialJet (hW τ) [EuclideanSpace.single j 1])).add
      (contDiff_infty_coord_smul j (hV τ)
        (JointSmoothSub.contDiff_infty_dirSpatialJet (hW' τ) [EuclideanSpace.single j 1])))
    fun j _ => hasPhaseJetDeriv_coord_smul j hV hV'
      (fun τ => JointSmoothSub.contDiff_infty_dirSpatialJet (hW τ) [EuclideanSpace.single j 1])
      (fun τ => JointSmoothSub.contDiff_infty_dirSpatialJet (hW' τ) [EuclideanSpace.single j 1])
      dV (hasPhaseJetDeriv_spatialPartial dW j)

/-- Smoothness of `spatialRadialDrift F` for smooth `F : SpatialField`. -/
theorem contDiff_infty_spatialRadialDrift {F : SpatialField} (hF : ContDiff ℝ ∞ F) :
    ContDiff ℝ ∞ (spatialRadialDrift F) :=
  contDiff_infty_spatialConvect contDiff_id hF

/-- Smoothness of `spatialProjectedLin ν F` for smooth `F : SpatialField`. -/
theorem contDiff_infty_spatialProjectedLin (ν : ℝ) {F : SpatialField} (hF : ContDiff ℝ ∞ F) :
    ContDiff ℝ ∞ (spatialProjectedLin ν F) := by
  have hL : ContDiff ℝ ∞ (spatialLaplacian F) :=
    ContDiff.sum fun j _ =>
      JointSmoothSub.contDiff_infty_dirSpatialJet hF
        [EuclideanSpace.single j 1, EuclideanSpace.single j 1]
  exact ((contDiff_infty_spatialRadialDrift hF).const_smul (1 / 2 : ℝ)).add
    ((hL.const_smul ν).add (hF.const_smul (1 / 2 : ℝ)))

/-- `spatialRadialDrift` commutes with `HasPhaseJetDeriv` on smooth-slice families (corollary of
`hasPhaseJetDeriv_spatialConvect` with `V τ = id`, `V' = 0`). -/
theorem hasPhaseJetDeriv_spatialRadialDrift {W W' : ℝ → SpatialField}
    (hW : ∀ τ, ContDiff ℝ ∞ (W τ)) (hW' : ∀ τ, ContDiff ℝ ∞ (W' τ))
    (dW : HasPhaseJetDeriv W W') :
    HasPhaseJetDeriv (fun τ => spatialRadialDrift (W τ)) (fun τ => spatialRadialDrift (W' τ)) := by
  have h := hasPhaseJetDeriv_spatialConvect
    (V := fun _ => (id : SpatialField)) (V' := 0)
    (fun _ => contDiff_id) (fun _ => contDiff_const) hW hW'
    (hasPhaseJetDeriv_const id) dW
  have h0 : (fun τ => spatialConvect ((0 : ℝ → SpatialField) τ) (W τ) +
      spatialConvect id (W' τ)) = fun τ => spatialRadialDrift (W' τ) := by
    funext τ y
    simp [spatialConvect, spatialRadialDrift]
  have h1 : (fun τ => spatialConvect id (W τ)) = fun τ => spatialRadialDrift (W τ) := rfl
  rwa [h1, h0] at h

/-- `spatialProjectedLin ν` commutes with `HasPhaseJetDeriv` on smooth-slice families. -/
theorem hasPhaseJetDeriv_spatialProjectedLin (ν : ℝ) {W W' : ℝ → SpatialField}
    (hW : ∀ τ, ContDiff ℝ ∞ (W τ)) (hW' : ∀ τ, ContDiff ℝ ∞ (W' τ))
    (dW : HasPhaseJetDeriv W W') :
    HasPhaseJetDeriv (fun τ => spatialProjectedLin ν (W τ))
      (fun τ => spatialProjectedLin ν (W' τ)) := by
  have hDR : ∀ τ, ContDiff ℝ ∞ (spatialDiffReact ν (W τ)) := by
    intro τ
    have hL : ContDiff ℝ ∞ (spatialLaplacian (W τ)) :=
      ContDiff.sum fun j _ =>
        JointSmoothSub.contDiff_infty_dirSpatialJet (hW τ)
          [EuclideanSpace.single j 1, EuclideanSpace.single j 1]
    exact (hL.const_smul ν).add ((hW τ).const_smul (1 / 2 : ℝ))
  have hDR' : ∀ τ, ContDiff ℝ ∞ (spatialDiffReact ν (W' τ)) := by
    intro τ
    have hL' : ContDiff ℝ ∞ (spatialLaplacian (W' τ)) :=
      ContDiff.sum fun j _ =>
        JointSmoothSub.contDiff_infty_dirSpatialJet (hW' τ)
          [EuclideanSpace.single j 1, EuclideanSpace.single j 1]
    exact (hL'.const_smul ν).add ((hW' τ).const_smul (1 / 2 : ℝ))
  exact hasPhaseJetDeriv_add
    (fun τ => (contDiff_infty_spatialRadialDrift (hW τ)).const_smul (1 / 2 : ℝ))
    (fun τ => (contDiff_infty_spatialRadialDrift (hW' τ)).const_smul (1 / 2 : ℝ))
    hDR hDR'
    (hasPhaseJetDeriv_smul (1 / 2 : ℝ)
      (fun τ => contDiff_infty_spatialRadialDrift (hW τ))
      (fun τ => contDiff_infty_spatialRadialDrift (hW' τ))
      (hasPhaseJetDeriv_spatialRadialDrift hW hW' dW))
    (hasPhaseJetDeriv_spatialDiffReact ν hW hW' dW)

/-! ## 5. Smooth `L⁴` Leray representative and linearity -/

theorem isSmoothLerayRep_unique {F G₁ G₂ : SpatialField}
    (h₁ : IsSmoothLerayRep F G₁) (h₂ : IsSmoothLerayRep F G₂) :
    G₁ = G₂ := by
  obtain ⟨hF₁, hG₁, heq₁⟩ := h₁
  obtain ⟨hF₂, hG₂, heq₂⟩ := h₂
  have htoLp : hF₁.toLp F = hF₂.toLp F := rfl
  have hae : G₁ =ᵐ[volume] G₂ := by
    refine heq₁.trans ?_
    rw [htoLp]
    exact heq₂.symm
  exact (Continuous.ae_eq_iff_eq volume hG₁.continuous hG₂.continuous).1 hae

theorem smoothLerayProj_eq_of_isSmoothLerayRep {F G : SpatialField}
    (h : IsSmoothLerayRep F G) :
    smoothLerayProj F = G := by
  classical
  have hex : ∃ G' : SpatialField, IsSmoothLerayRep F G' := ⟨G, h⟩
  have hchoose : IsSmoothLerayRep F (smoothLerayProj F) := by
    dsimp [smoothLerayProj]
    rw [dite_eq_left hex]
    exact hex.choose_spec
  exact isSmoothLerayRep_unique hchoose h

theorem isSmoothLerayRep_add {F₁ F₂ G₁ G₂ : SpatialField}
    (h₁ : IsSmoothLerayRep F₁ G₁) (h₂ : IsSmoothLerayRep F₂ G₂) :
    IsSmoothLerayRep (F₁ + F₂) (G₁ + G₂) := by
  obtain ⟨hF₁, hG₁, heq₁⟩ := h₁
  obtain ⟨hF₂, hG₂, heq₂⟩ := h₂
  refine ⟨hF₁.add hF₂, hG₁.add hG₂, ?_⟩
  set P := UnforcedLeray.RieszLp.lerayLp 4 (by norm_num) (by norm_num)
  have htoLp : (hF₁.add hF₂).toLp (F₁ + F₂) = hF₁.toLp F₁ + hF₂.toLp F₂ :=
    MemLp.toLp_add hF₁ hF₂
  have hmap : P ((hF₁.add hF₂).toLp (F₁ + F₂)) = P (hF₁.toLp F₁) + P (hF₂.toLp F₂) := by
    rw [htoLp, map_add]
  have hcoe := Lp.coeFn_add (P (hF₁.toLp F₁)) (P (hF₂.toLp F₂))
  refine (heq₁.add heq₂).trans ?_
  rw [hmap]
  exact hcoe.symm

theorem smoothLerayProj_add {F₁ F₂ : SpatialField}
    (h₁ : IsSmoothLerayRep F₁ (smoothLerayProj F₁))
    (h₂ : IsSmoothLerayRep F₂ (smoothLerayProj F₂)) :
    smoothLerayProj (F₁ + F₂) = smoothLerayProj F₁ + smoothLerayProj F₂ :=
  smoothLerayProj_eq_of_isSmoothLerayRep (isSmoothLerayRep_add h₁ h₂)

/-! ## 6. Binomial Pascal/Leibniz sum and strong-recursion tower -/

/-- Pascal's identity for the binomial Leibniz derivative of a bilinear sum. -/
theorem sum_choose_leibniz {M : Type*} [AddCommGroup M] [Module ℝ M]
    (T : ℕ → ℕ → M) (m : ℕ) :
    (∑ j ∈ Finset.range (m + 1),
      ((Nat.choose m j : ℝ) • T (j + 1) (m - j) +
        (Nat.choose m j : ℝ) • T j (m + 1 - j))) =
    ∑ j ∈ Finset.range (m + 2), (Nat.choose (m + 1) j : ℝ) • T j (m + 1 - j) := by
  rw [Finset.sum_add_distrib]
  rw [Finset.sum_range_succ (fun j => (Nat.choose m j : ℝ) • T (j + 1) (m - j)) m]
  rw [Finset.sum_range_succ' (fun j => (Nat.choose m j : ℝ) • T j (m + 1 - j)) m]
  rw [Finset.sum_range_succ' (fun j => (Nat.choose (m + 1) j : ℝ) • T j (m + 1 - j)) (m + 1)]
  rw [Finset.sum_range_succ (fun j => (Nat.choose (m + 1) (j + 1) : ℝ) • T (j + 1) (m + 1 - (j + 1))) m]
  have hcomb :
      (∑ j ∈ Finset.range m, (Nat.choose m j : ℝ) • T (j + 1) (m - j)) +
      (∑ j ∈ Finset.range m, (Nat.choose m (j + 1) : ℝ) • T (j + 1) (m + 1 - (j + 1))) =
      ∑ j ∈ Finset.range m,
        (Nat.choose (m + 1) (j + 1) : ℝ) • T (j + 1) (m + 1 - (j + 1)) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hsub : m + 1 - (j + 1) = m - j := Nat.succ_sub_succ_eq_sub m j
    rw [hsub, ← add_smul]
    congr 1
    exact_mod_cast (Nat.choose_succ_succ m j).symm
  simp only [Nat.choose_self, Nat.choose_zero_right, Nat.sub_self, Nat.sub_zero,
    Nat.succ_sub_succ_eq_sub, Nat.cast_one, one_smul] at hcomb ⊢
  calc (∑ j ∈ Finset.range m, (Nat.choose m j : ℝ) • T (j + 1) (m - j) + T (m + 1) 0) +
        (∑ j ∈ Finset.range m, (Nat.choose m (j + 1) : ℝ) • T (j + 1) (m - j) + T 0 (m + 1))
      = ((∑ j ∈ Finset.range m, (Nat.choose m j : ℝ) • T (j + 1) (m - j)) +
          (∑ j ∈ Finset.range m, (Nat.choose m (j + 1) : ℝ) • T (j + 1) (m - j))) +
          T (m + 1) 0 + T 0 (m + 1) := by abel
    _ = (∑ j ∈ Finset.range m, (Nat.choose (m + 1) (j + 1) : ℝ) • T (j + 1) (m - j)) +
          T (m + 1) 0 + T 0 (m + 1) := by rw [hcomb]

/-- If `B` preserves `IsUniformSmoothL4SliceFamily`, then `leibnizBilinearSum B U m` lies in
`IsUniformSmoothL4SliceFamily` whenever `U j` (`j ≤ m`) do. -/
theorem sliceFamily_leibnizBilinearSum
    {B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField)}
    (hB : ∀ V W, IsUniformSmoothL4SliceFamily V → IsUniformSmoothL4SliceFamily W →
      IsUniformSmoothL4SliceFamily (B V W))
    {U : ℕ → ℝ → SpatialField} {m : ℕ}
    (hU : ∀ j ≤ m, IsUniformSmoothL4SliceFamily (U j)) :
    IsUniformSmoothL4SliceFamily (leibnizBilinearSum B U m) := by
  refine sliceFamily_sum (Finset.range (m + 1))
    (F := fun j => (Nat.choose m j : ℝ) • B (U j) (U (m - j))) fun j hj => ?_
  have hjle : j ≤ m := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
  exact sliceFamily_smul (Nat.choose m j : ℝ)
    (hB (U j) (U (m - j)) (hU j hjle) (hU (m - j) (Nat.sub_le m j)))

/-- Binomial Leibniz differentiation of `leibnizBilinearSum B U m` along all iterated spatial
directional jets: if `B` preserves `IsUniformSmoothL4SliceFamily` and satisfies the bilinear
product rule for `HasPhaseJetDeriv`, then `leibnizBilinearSum B U m` has phase-jet derivative
`leibnizBilinearSum B U (m + 1)`. -/
theorem hasPhaseJetDeriv_leibnizBilinearSum
    {B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField)}
    (hBSmooth : ∀ V W, IsUniformSmoothL4SliceFamily V → IsUniformSmoothL4SliceFamily W →
      IsUniformSmoothL4SliceFamily (B V W))
    (hBDeriv : ∀ V V' W W',
      IsUniformSmoothL4SliceFamily V → IsUniformSmoothL4SliceFamily V' →
      IsUniformSmoothL4SliceFamily W → IsUniformSmoothL4SliceFamily W' →
      HasPhaseJetDeriv V V' → HasPhaseJetDeriv W W' →
      HasPhaseJetDeriv (B V W) (B V' W + B V W'))
    {U : ℕ → ℝ → SpatialField} {m : ℕ}
    (hUSmooth : ∀ j ≤ m + 1, IsUniformSmoothL4SliceFamily (U j))
    (hUDeriv : ∀ j ≤ m, HasPhaseJetDeriv (U j) (U (j + 1))) :
    HasPhaseJetDeriv (leibnizBilinearSum B U m) (leibnizBilinearSum B U (m + 1)) := by
  have hsum := hasPhaseJetDeriv_sum (Finset.range (m + 1))
    (F := fun j => (Nat.choose m j : ℝ) • B (U j) (U (m - j)))
    (F' := fun j => (Nat.choose m j : ℝ) •
      (B (U (j + 1)) (U (m - j)) + B (U j) (U (m + 1 - j))))
    (fun j hj τ => by
      have hjle : j ≤ m := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
      have hB0 := hBSmooth (U j) (U (m - j))
        (hUSmooth j (hjle.trans (Nat.le_succ m)))
        (hUSmooth (m - j) ((Nat.sub_le m j).trans (Nat.le_succ m)))
      exact sliceFamily_contDiff_infty (sliceFamily_smul (Nat.choose m j : ℝ) hB0) τ)
    (fun j hj τ => by
      have hjle : j ≤ m := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
      have hB1 := sliceFamily_add
        (hBSmooth (U (j + 1)) (U (m - j))
          (hUSmooth (j + 1) (Nat.succ_le_succ hjle))
          (hUSmooth (m - j) ((Nat.sub_le m j).trans (Nat.le_succ m))))
        (hBSmooth (U j) (U (m + 1 - j))
          (hUSmooth j (hjle.trans (Nat.le_succ m)))
          (hUSmooth (m + 1 - j) (Nat.sub_le (m + 1) j)))
      exact sliceFamily_contDiff_infty (sliceFamily_smul (Nat.choose m j : ℝ) hB1) τ)
    (fun j hj => by
      have hjle : j ≤ m := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
      have hsub : m - j + 1 = m + 1 - j := by omega
      have hB0 := hBSmooth (U j) (U (m - j))
        (hUSmooth j (hjle.trans (Nat.le_succ m)))
        (hUSmooth (m - j) ((Nat.sub_le m j).trans (Nat.le_succ m)))
      have hB1 := sliceFamily_add
        (hBSmooth (U (j + 1)) (U (m - j))
          (hUSmooth (j + 1) (Nat.succ_le_succ hjle))
          (hUSmooth (m - j) ((Nat.sub_le m j).trans (Nat.le_succ m))))
        (hBSmooth (U j) (U (m + 1 - j))
          (hUSmooth j (hjle.trans (Nat.le_succ m)))
          (hUSmooth (m + 1 - j) (Nat.sub_le (m + 1) j)))
      refine hasPhaseJetDeriv_smul (Nat.choose m j : ℝ)
        (sliceFamily_contDiff_infty hB0) (sliceFamily_contDiff_infty hB1) ?_
      have hdW : HasPhaseJetDeriv (U (m - j)) (U (m + 1 - j)) := by
        rw [← hsub]
        exact hUDeriv (m - j) (Nat.sub_le m j)
      exact hBDeriv (U j) (U (j + 1)) (U (m - j)) (U (m + 1 - j))
        (hUSmooth j (hjle.trans (Nat.le_succ m)))
        (hUSmooth (j + 1) (Nat.succ_le_succ hjle))
        (hUSmooth (m - j) ((Nat.sub_le m j).trans (Nat.le_succ m)))
        (hUSmooth (m + 1 - j) (Nat.sub_le (m + 1) j))
        (hUDeriv j hjle) hdW)
  have heq : (fun τ y => ∑ j ∈ Finset.range (m + 1),
      ((Nat.choose m j : ℝ) •
        (B (U (j + 1)) (U (m - j)) + B (U j) (U (m + 1 - j)))) τ y) =
      leibnizBilinearSum B U (m + 1) := by
    funext τ y
    have hpt := sum_choose_leibniz (fun j k => B (U j) (U k) τ y) m
    simpa [leibnizBilinearSum, smul_add] using hpt
  rwa [heq] at hsum

/-! ### Strong-recursion tower identities (`leibnizTower` and `bgPhaseDerivTower`) -/

theorem leibnizTowerStage_eq_of_le
    (L : (ℝ → SpatialField) → (ℝ → SpatialField))
    (B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField))
    (U₀ : ℝ → SpatialField) :
    ∀ {m n : ℕ}, m ≤ n → leibnizTowerStage L B U₀ n m = leibnizTower L B U₀ m := by
  intro m n hmn
  induction n with
  | zero =>
      have hm0 : m = 0 := Nat.le_zero.1 hmn
      subst hm0
      rfl
  | succ n ih =>
      rcases Nat.of_le_succ hmn with hle | rfl
      · dsimp [leibnizTowerStage]
        rw [ite_eq_left hle]
        exact ih hle
      · rfl

@[simp]
theorem leibnizTower_zero
    (L : (ℝ → SpatialField) → (ℝ → SpatialField))
    (B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField))
    (U₀ : ℝ → SpatialField) :
    leibnizTower L B U₀ 0 = U₀ := rfl

theorem leibnizTower_succ
    (L : (ℝ → SpatialField) → (ℝ → SpatialField))
    (B : (ℝ → SpatialField) → (ℝ → SpatialField) → (ℝ → SpatialField))
    (U₀ : ℝ → SpatialField) (m : ℕ) :
    leibnizTower L B U₀ (m + 1) =
      L (leibnizTower L B U₀ m) - leibnizBilinearSum B (leibnizTower L B U₀) m := by
  change (if m + 1 ≤ m then leibnizTowerStage L B U₀ m (m + 1)
    else L (leibnizTowerStage L B U₀ m m) -
      leibnizBilinearSum B (leibnizTowerStage L B U₀ m) m) = _
  rw [ite_eq_right (Nat.not_succ_le_self m)]
  congr 1
  funext τ y
  dsimp [leibnizBilinearSum]
  refine Finset.sum_congr rfl fun j hj => ?_
  have hjle : j ≤ m := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
  rw [leibnizTowerStage_eq_of_le L B U₀ hjle,
    leibnizTowerStage_eq_of_le L B U₀ (Nat.sub_le m j)]

@[simp]
theorem bgPhaseDerivTower_zero (ν : ℝ) (U₀ : ℝ → SpatialField) :
    bgPhaseDerivTower ν U₀ 0 = U₀ := rfl

theorem bgPhaseDerivTower_succ (ν : ℝ) (U₀ : ℝ → SpatialField) (m : ℕ) :
    bgPhaseDerivTower ν U₀ (m + 1) =
      (fun τ => spatialProjectedLin ν (bgPhaseDerivTower ν U₀ m τ)) -
        leibnizBilinearSum smoothConvectiveLeray (bgPhaseDerivTower ν U₀) m :=
  leibnizTower_succ (fun V τ => spatialProjectedLin ν (V τ)) smoothConvectiveLeray U₀ m

end HigherPhaseSub

/-! ## 7. Decomposition of `BgHigherOrderPhaseDerivTower` (`PartII-b:S3/1/2`) -/

/-- **`PartII-b:S3/1/2/1` (`SmoothLeraySliceRegularity`)**
(`the November 2 reference manuscript`,
lines 2552 and 2559-2562: "These estimates are uniform in phase; the bounded Cartesian Leray map
preserves them in $W^{k,p}$. ... On positive physical-time compact intervals the resulting
$C_\tau W^{k,4}$ regularity and the projected equation give all time derivatives"):
1. For every `F : ℝ → SpatialField` in `IsUniformSmoothL4SliceFamily`, every slice `F τ` has a
   smooth `L⁴(ℝ³)` Leray representative (`IsSmoothLerayRep (F τ) (smoothLeraySlice F τ)`) and
   `smoothLeraySlice F` lies in `IsUniformSmoothL4SliceFamily`;
2. If `F, F' : ℝ → SpatialField` lie in `IsUniformSmoothL4SliceFamily` and `HasPhaseJetDeriv F F'`,
   then `HasPhaseJetDeriv (smoothLeraySlice F) (smoothLeraySlice F')`.
Composed by task `PartII-b:S3/1/2` via `bgHigherOrderPhaseDerivTower_of_comoving`
(`Sub/PartII-b_S3_1_comoving.lean`). -/
def SmoothLeraySliceRegularity : Prop :=
  (∀ F : ℝ → SpatialField, IsUniformSmoothL4SliceFamily F →
    (∀ τ : ℝ, IsSmoothLerayRep (F τ) (smoothLeraySlice F τ)) ∧
      IsUniformSmoothL4SliceFamily (smoothLeraySlice F)) ∧
  (∀ F F' : ℝ → SpatialField,
    IsUniformSmoothL4SliceFamily F → IsUniformSmoothL4SliceFamily F' →
    HasPhaseJetDeriv F F' → HasPhaseJetDeriv (smoothLeraySlice F) (smoothLeraySlice F'))

/-- **`PartII-b:S3/1/2/2` (`BgProjectedEvolutionTowerSlice`)**
(`the November 2 reference manuscript`,
lines 2519-2523 and 2559-2562: "The projected equation is $A_0 U + \mathbb{P}(U \cdot \nabla U) = 0$
with zero residual. ... On positive physical-time compact intervals the resulting $C_\tau W^{k,4}$
regularity and the projected equation give all time derivatives"):
under the regime and all-order spatial regularity hypotheses of `BgHigherOrderPhaseDerivTower`:
1. The first-order phase derivative `U₁` of `bgField p z` satisfies the projected evolution
   identity `U₁ = bgPhaseDerivTower p.ν (bgField p z) 1`
   (i.e. `∂_τ U = (1/2)(y · ∇)U + ν ΔU + (1/2)U - 𝔓(U · ∇U)`);
2. Along the concrete phase-derivative tower `bgPhaseDerivTower p.ν (bgField p z)`, each radial
   drift family `fun τ => spatialRadialDrift (bgPhaseDerivTower p.ν (bgField p z) m_ord τ)` lies
   in `IsUniformSmoothL4SliceFamily`.
Retired fixed-`y` leaf (it needs `L⁴` bounds on radial drifts, which the maximal graph does not
give): `BgHigherOrderPhaseDerivTower` is now assembled along comoving rays by
`bgHigherOrderPhaseDerivTower_of_comoving` (`Sub/PartII-b_S3_1_comoving.lean`). -/
def BgProjectedEvolutionTowerSlice : Prop :=
  ∀ (Sig : ℝ) (lam : ℂ) (q : Blueprint.Planar.Profile), 0 < Sig →
    Blueprint.Planar.IsGrowingEigenpair lam q →
  ∀ m : ℝ, 0 < m → ∀ dm dp : ℝ, 0 < dm → 2 * m < 3 * dm / 11 → ∀ (C₁ : ℝ) (k₁ : ℕ), 0 < C₁ →
    ∃ ν₀ : ℝ, 0 < ν₀ ∧
    ∀ (p : Params) (d : ℝ), BgRegime p d dm dp → p.ν ≤ ν₀ → p.ageCut = Sig → p.mode = q →
      ∀ z : p.Z, ProjectedEquation p z →
      ‖z‖ ≤ C₁ * (p.ν ^ k₁)⁻¹ * Real.exp (m / p.ν) * p.ε ^ (3 / 11 : ℝ) →
      (∀ k : ℕ, ∃ g : (Fin k → Fin 3) → B0411.D p.period p.ν q0E,
        IsIteratedPhaseGrad p.period q0E k (p.wOf z) (fun α => (g α : Yq p.period q0E))) →
      (∀ k : ℕ, ∃ M : ℝ, ∀ τ : ℝ, ContDiff ℝ k (bgField p z τ) ∧
        (∀ y : Space, ‖iteratedFDeriv ℝ k (p.corr z τ) y‖ ≤ M) ∧
        eLpNorm (fun y => iteratedFDeriv ℝ k (bgField p z τ) y) 4 volume ≤ ENNReal.ofReal M) →
      (IsBoundedBackground p.raw ∧ ∀ τ, IsSolenoidal (p.raw τ)) →
      (∀ i : Fin 2, IsBoundedBackground (p.inlet i) ∧ ∀ τ, IsSolenoidal (p.inlet i τ)) →
      IsUniformSmoothL4SliceFamily (bgField p z) →
      ∀ U₁ : ℝ → SpatialField,
        IsUniformSmoothL4SliceFamily U₁ →
        HasPhaseJetDeriv (bgField p z) U₁ →
        U₁ = bgPhaseDerivTower p.ν (bgField p z) 1 ∧
        ∀ m_ord : ℕ,
          IsUniformSmoothL4SliceFamily
            (fun τ => spatialRadialDrift (bgPhaseDerivTower p.ν (bgField p z) m_ord τ))

namespace HigherPhaseSub

/-- From `SmoothLeraySliceRegularity`, `smoothConvectiveLeray` preserves
`IsUniformSmoothL4SliceFamily`. -/
theorem sliceFamily_smoothConvectiveLeray (hLeray : SmoothLeraySliceRegularity)
    (V W : ℝ → SpatialField)
    (hV : IsUniformSmoothL4SliceFamily V) (hW : IsUniformSmoothL4SliceFamily W) :
    IsUniformSmoothL4SliceFamily (smoothConvectiveLeray V W) :=
  (hLeray.1 (fun τ => spatialConvect (V τ) (W τ)) (sliceFamily_spatialConvect hV hW)).2

/-- From `SmoothLeraySliceRegularity`, `smoothConvectiveLeray` satisfies the bilinear product rule
for `HasPhaseJetDeriv`. -/
theorem hasPhaseJetDeriv_smoothConvectiveLeray (hLeray : SmoothLeraySliceRegularity)
    (V V' W W' : ℝ → SpatialField)
    (hV : IsUniformSmoothL4SliceFamily V) (hV' : IsUniformSmoothL4SliceFamily V')
    (hW : IsUniformSmoothL4SliceFamily W) (hW' : IsUniformSmoothL4SliceFamily W')
    (dV : HasPhaseJetDeriv V V') (dW : HasPhaseJetDeriv W W') :
    HasPhaseJetDeriv (smoothConvectiveLeray V W)
      (smoothConvectiveLeray V' W + smoothConvectiveLeray V W') := by
  have hC0 : IsUniformSmoothL4SliceFamily (fun τ => spatialConvect (V τ) (W τ)) :=
    sliceFamily_spatialConvect hV hW
  have hC1 : IsUniformSmoothL4SliceFamily (fun τ => spatialConvect (V' τ) (W τ)) :=
    sliceFamily_spatialConvect hV' hW
  have hC2 : IsUniformSmoothL4SliceFamily (fun τ => spatialConvect (V τ) (W' τ)) :=
    sliceFamily_spatialConvect hV hW'
  have hdC := hasPhaseJetDeriv_spatialConvect
    (sliceFamily_contDiff_infty hV) (sliceFamily_contDiff_infty hV')
    (sliceFamily_contDiff_infty hW) (sliceFamily_contDiff_infty hW') dV dW
  have hdL := hLeray.2
    (fun τ => spatialConvect (V τ) (W τ))
    (fun τ => spatialConvect (V' τ) (W τ) + spatialConvect (V τ) (W' τ))
    hC0 (sliceFamily_add hC1 hC2) hdC
  have hlin : smoothLeraySlice
      (fun τ => spatialConvect (V' τ) (W τ) + spatialConvect (V τ) (W' τ)) =
      smoothConvectiveLeray V' W + smoothConvectiveLeray V W' := by
    funext τ
    exact smoothLerayProj_add ((hLeray.1 _ hC1).1 τ) ((hLeray.1 _ hC2).1 τ)
  rwa [hlin] at hdL

/-- Strong induction on `m_ord : ℕ`: if `U₀ ∈ IsUniformSmoothL4SliceFamily`,
`SmoothLeraySliceRegularity` holds, and `spatialRadialDrift` of every stage of
`bgPhaseDerivTower ν U₀` lies in `IsUniformSmoothL4SliceFamily`, then every stage
`bgPhaseDerivTower ν U₀ m_ord` lies in `IsUniformSmoothL4SliceFamily`. -/
theorem sliceFamily_bgPhaseDerivTower (hLeray : SmoothLeraySliceRegularity)
    (ν : ℝ) {U₀ : ℝ → SpatialField}
    (hU₀ : IsUniformSmoothL4SliceFamily U₀)
    (hRad : ∀ m_ord : ℕ,
      IsUniformSmoothL4SliceFamily
        (fun τ => spatialRadialDrift (bgPhaseDerivTower ν U₀ m_ord τ))) :
    ∀ m_ord : ℕ, IsUniformSmoothL4SliceFamily (bgPhaseDerivTower ν U₀ m_ord) := by
  have hstrong : ∀ n : ℕ, ∀ k ≤ n,
      IsUniformSmoothL4SliceFamily (bgPhaseDerivTower ν U₀ k) := by
    intro n
    induction n with
    | zero =>
        intro k hk
        have hk0 : k = 0 := Nat.le_zero.1 hk
        subst hk0
        exact hU₀
    | succ n ih =>
        intro k hk
        rcases Nat.of_le_succ hk with hle | rfl
        · exact ih k hle
        · rw [bgPhaseDerivTower_succ]
          have hLin : IsUniformSmoothL4SliceFamily
              (fun τ => spatialProjectedLin ν (bgPhaseDerivTower ν U₀ n τ)) :=
            sliceFamily_add
              (sliceFamily_smul (1 / 2 : ℝ) (hRad n))
              (sliceFamily_spatialDiffReact ν (ih n (le_refl n)))
          have hConv : IsUniformSmoothL4SliceFamily
              (leibnizBilinearSum smoothConvectiveLeray (bgPhaseDerivTower ν U₀) n) :=
            sliceFamily_leibnizBilinearSum (sliceFamily_smoothConvectiveLeray hLeray) ih
          exact sliceFamily_sub hLin hConv
  exact fun m_ord => hstrong m_ord m_ord (le_refl m_ord)

/-- Strong induction on `m_ord : ℕ`: once every stage of `bgPhaseDerivTower ν U₀` lies in
`IsUniformSmoothL4SliceFamily` and `HasPhaseJetDeriv U₀ (bgPhaseDerivTower ν U₀ 1)` holds at
`m_ord = 0`, `HasPhaseJetDeriv (bgPhaseDerivTower ν U₀ m_ord) (bgPhaseDerivTower ν U₀ (m_ord + 1))`
holds for all `m_ord : ℕ`. -/
theorem hasPhaseJetDeriv_bgPhaseDerivTower (hLeray : SmoothLeraySliceRegularity)
    (ν : ℝ) {U₀ : ℝ → SpatialField}
    (hSmooth : ∀ m_ord : ℕ, IsUniformSmoothL4SliceFamily (bgPhaseDerivTower ν U₀ m_ord))
    (hBase : HasPhaseJetDeriv U₀ (bgPhaseDerivTower ν U₀ 1)) :
    ∀ m_ord : ℕ,
      HasPhaseJetDeriv (bgPhaseDerivTower ν U₀ m_ord)
        (bgPhaseDerivTower ν U₀ (m_ord + 1)) := by
  have hstrong : ∀ n : ℕ, ∀ k ≤ n,
      HasPhaseJetDeriv (bgPhaseDerivTower ν U₀ k) (bgPhaseDerivTower ν U₀ (k + 1)) := by
    intro n
    induction n with
    | zero =>
        intro k hk
        have hk0 : k = 0 := Nat.le_zero.1 hk
        subst hk0
        exact hBase
    | succ n ih =>
        intro k hk
        rcases Nat.of_le_succ hk with hle | rfl
        · exact ih k hle
        · rw [bgPhaseDerivTower_succ ν U₀ n, bgPhaseDerivTower_succ ν U₀ (n + 1)]
          have hdLin : HasPhaseJetDeriv
              (fun τ => spatialProjectedLin ν (bgPhaseDerivTower ν U₀ n τ))
              (fun τ => spatialProjectedLin ν (bgPhaseDerivTower ν U₀ (n + 1) τ)) :=
            hasPhaseJetDeriv_spatialProjectedLin ν
              (sliceFamily_contDiff_infty (hSmooth n))
              (sliceFamily_contDiff_infty (hSmooth (n + 1)))
              (ih n (le_refl n))
          have hdConv : HasPhaseJetDeriv
              (leibnizBilinearSum smoothConvectiveLeray (bgPhaseDerivTower ν U₀) n)
              (leibnizBilinearSum smoothConvectiveLeray (bgPhaseDerivTower ν U₀) (n + 1)) :=
            hasPhaseJetDeriv_leibnizBilinearSum
              (sliceFamily_smoothConvectiveLeray hLeray)
              (hasPhaseJetDeriv_smoothConvectiveLeray hLeray)
              (fun j _ => hSmooth j) ih
          have hConv0 := sliceFamily_leibnizBilinearSum
            (sliceFamily_smoothConvectiveLeray hLeray) (m := n) (fun j _ => hSmooth j)
          have hConv1 := sliceFamily_leibnizBilinearSum
            (sliceFamily_smoothConvectiveLeray hLeray) (m := n + 1) (fun j _ => hSmooth j)
          exact hasPhaseJetDeriv_sub
            (fun τ => contDiff_infty_spatialProjectedLin ν
              (sliceFamily_contDiff_infty (hSmooth n) τ))
            (fun τ => contDiff_infty_spatialProjectedLin ν
              (sliceFamily_contDiff_infty (hSmooth (n + 1)) τ))
            (sliceFamily_contDiff_infty hConv0)
            (sliceFamily_contDiff_infty hConv1)
            hdLin hdConv
  exact fun m_ord => hstrong m_ord m_ord (le_refl m_ord)

end HigherPhaseSub

