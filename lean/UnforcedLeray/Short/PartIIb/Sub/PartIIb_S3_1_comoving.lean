/-! ## 1. The comoving right side and the classical comoving partial -/

/-- **Comoving projected evolution field** (SP 2519-2523): `T₀V = νΔV + ½V - 𝔓(V·∇V)`, the value
of `T₀ = ∂_τ - ½ y·∇_y` on a solution of `A₀V + 𝔓(V·∇V) = 0`, `A₀ = T₀ - νΔ - ½`. -/
def comovingEvolRHS (ν : ℝ) (V : ℝ → SpatialField) : ℝ → SpatialField :=
  fun τ => spatialDiffReact ν (V τ) - smoothConvectiveLeray V V τ

/-- Classical comoving derivative `T₀F = ∂_τF - ½(y·∇)F` of a jointly smooth phase field `F`. -/
def comovingPartial (F : ℝ → SpatialField) : ℝ → SpatialField :=
  fun τ => PhaseDerivStepSub.phasePartial F τ - (1 / 2 : ℝ) • spatialRadialDrift (F τ)

/-! ## 2. Calculus leaves of the comoving tower (`PartII-b:S3/1/2/3`, `/4`, `/5`) -/

/-- **`PartII-b:S3/1/2/3` (`SmoothLerayComovingComm`)** (SP 2552: "the bounded Cartesian Leray map
preserves them in $W^{k,p}$"; SP 2559-2562): the smooth Cartesian Leray projection commutes with
the comoving derivative `T₀`: if `F, F'` lie in `IsUniformSmoothL4SliceFamily` and
`HasComovingJetDeriv F F'`, then `HasComovingJetDeriv (smoothLeraySlice F) (smoothLeraySlice F')`
(`𝔓` commutes with spatial derivatives and with the dilations `y ↦ e^{-t/2} y`).
Composed by task `PartII-b:S3/1/2` via `bgHigherOrderPhaseDerivTower_of_comoving`. -/
def SmoothLerayComovingComm : Prop :=
  ∀ F F' : ℝ → SpatialField,
    IsUniformSmoothL4SliceFamily F → IsUniformSmoothL4SliceFamily F' →
    HasComovingJetDeriv F F' →
    HasComovingJetDeriv (smoothLeraySlice F) (smoothLeraySlice F')

/-- **`PartII-b:S3/1/2/4` (`ComovingLaplacianRule`)** (SP 2559-2562): `T₀(ΔV) = Δ(T₀V) + ΔV` along
comoving rays, for slice-smooth `V, V'` with `HasComovingJetDeriv V V'`.
Composed by task `PartII-b:S3/1/2` via `bgHigherOrderPhaseDerivTower_of_comoving`. -/
def ComovingLaplacianRule : Prop :=
  ∀ V V' : ℝ → SpatialField,
    (∀ τ, ContDiff ℝ ∞ (V τ)) → (∀ τ, ContDiff ℝ ∞ (V' τ)) →
    HasComovingJetDeriv V V' →
    HasComovingJetDeriv (fun τ => spatialLaplacian (V τ))
      (fun τ => spatialLaplacian (V' τ) + spatialLaplacian (V τ))

/-- **`PartII-b:S3/1/2/5` (`ComovingConvectRule`)** (SP 2559-2562): the comoving product rule
`T₀(V·∇W) = (T₀V)·∇W + V·∇(T₀W) + ½ V·∇W` for slice-smooth `V, V', W, W'` with
`HasComovingJetDeriv V V'` and `HasComovingJetDeriv W W'`.
Composed by task `PartII-b:S3/1/2` via `bgHigherOrderPhaseDerivTower_of_comoving`. -/
def ComovingConvectRule : Prop :=
  ∀ V V' W W' : ℝ → SpatialField,
    (∀ τ, ContDiff ℝ ∞ (V τ)) → (∀ τ, ContDiff ℝ ∞ (V' τ)) →
    (∀ τ, ContDiff ℝ ∞ (W τ)) → (∀ τ, ContDiff ℝ ∞ (W' τ)) →
    HasComovingJetDeriv V V' → HasComovingJetDeriv W W' →
    HasComovingJetDeriv (fun τ => spatialConvect (V τ) (W τ))
      (fun τ => spatialConvect (V' τ) (W τ) + spatialConvect (V τ) (W' τ) +
        (1 / 2 : ℝ) • spatialConvect (V τ) (W τ))

namespace ComovingTowerSub

/-! ## 3. Linear calculus and uniqueness of `HasComovingJetDeriv` -/

/-- The ray derivative `d/dt|₀ V(τ + t, e^{-t/2} y)`: the unique comoving derivative. -/
def comovingDerivOf (V : ℝ → SpatialField) : ℝ → SpatialField :=
  fun τ y => deriv (fun t : ℝ => V (τ + t) (Real.exp (-t / 2) • y)) 0

theorem eq_comovingDerivOf {V V' : ℝ → SpatialField} (h : HasComovingJetDeriv V V') :
    V' = comovingDerivOf V := by
  funext τ y
  have h0 := h [] τ y
  simp only [dirSpatialJet_nil, List.length_nil, Nat.cast_zero, zero_div, zero_smul,
    add_zero] at h0
  exact h0.deriv.symm

theorem hasComovingJetDeriv_add {V V' W W' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (hW : ∀ τ, ContDiff ℝ ∞ (W τ)) (hW' : ∀ τ, ContDiff ℝ ∞ (W' τ))
    (dV : HasComovingJetDeriv V V') (dW : HasComovingJetDeriv W W') :
    HasComovingJetDeriv (V + W) (V' + W') := by
  intro ws τ y
  have h := (dV ws τ y).add (dW ws τ y)
  have hfun : (fun t : ℝ => dirSpatialJet ((V + W) (τ + t)) ws (Real.exp (-t / 2) • y)) =
      fun t => dirSpatialJet (V (τ + t)) ws (Real.exp (-t / 2) • y) +
        dirSpatialJet (W (τ + t)) ws (Real.exp (-t / 2) • y) := by
    funext t
    rw [Pi.add_apply, HigherPhaseSub.dirSpatialJet_add (hV _) (hW _) ws]
    rfl
  have hval : dirSpatialJet ((V' + W') τ) ws y +
      ((ws.length : ℝ) / 2) • dirSpatialJet ((V + W) τ) ws y =
      (dirSpatialJet (V' τ) ws y + ((ws.length : ℝ) / 2) • dirSpatialJet (V τ) ws y) +
        (dirSpatialJet (W' τ) ws y + ((ws.length : ℝ) / 2) • dirSpatialJet (W τ) ws y) := by
    rw [Pi.add_apply, Pi.add_apply, HigherPhaseSub.dirSpatialJet_add (hV' τ) (hW' τ) ws,
      HigherPhaseSub.dirSpatialJet_add (hV τ) (hW τ) ws, Pi.add_apply, Pi.add_apply, smul_add]
    abel
  rw [hfun, hval]
  exact h

theorem hasComovingJetDeriv_smul (c : ℝ) {V V' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (dV : HasComovingJetDeriv V V') :
    HasComovingJetDeriv (c • V) (c • V') := by
  intro ws τ y
  have h := (dV ws τ y).const_smul c
  have hfun : (fun t : ℝ => dirSpatialJet ((c • V) (τ + t)) ws (Real.exp (-t / 2) • y)) =
      fun t => c • dirSpatialJet (V (τ + t)) ws (Real.exp (-t / 2) • y) := by
    funext t
    rw [Pi.smul_apply, HigherPhaseSub.dirSpatialJet_smul c (hV _) ws]
    rfl
  have hval : dirSpatialJet ((c • V') τ) ws y +
      ((ws.length : ℝ) / 2) • dirSpatialJet ((c • V) τ) ws y =
      c • (dirSpatialJet (V' τ) ws y + ((ws.length : ℝ) / 2) • dirSpatialJet (V τ) ws y) := by
    rw [Pi.smul_apply, Pi.smul_apply, HigherPhaseSub.dirSpatialJet_smul c (hV' τ) ws,
      HigherPhaseSub.dirSpatialJet_smul c (hV τ) ws, Pi.smul_apply, Pi.smul_apply, smul_add,
      smul_comm c ((ws.length : ℝ) / 2)]
  rw [hfun, hval]
  exact h

theorem hasComovingJetDeriv_sub {V V' W W' : ℝ → SpatialField}
    (hV : ∀ τ, ContDiff ℝ ∞ (V τ)) (hV' : ∀ τ, ContDiff ℝ ∞ (V' τ))
    (hW : ∀ τ, ContDiff ℝ ∞ (W τ)) (hW' : ∀ τ, ContDiff ℝ ∞ (W' τ))
    (dV : HasComovingJetDeriv V V') (dW : HasComovingJetDeriv W W') :
    HasComovingJetDeriv (V - W) (V' - W') := by
  intro ws τ y
  have h := (dV ws τ y).sub (dW ws τ y)
  have hfun : (fun t : ℝ => dirSpatialJet ((V - W) (τ + t)) ws (Real.exp (-t / 2) • y)) =
      fun t => dirSpatialJet (V (τ + t)) ws (Real.exp (-t / 2) • y) -
        dirSpatialJet (W (τ + t)) ws (Real.exp (-t / 2) • y) := by
    funext t
    rw [Pi.sub_apply, HigherPhaseSub.dirSpatialJet_sub (hV _) (hW _) ws]
    rfl
  have hval : dirSpatialJet ((V' - W') τ) ws y +
      ((ws.length : ℝ) / 2) • dirSpatialJet ((V - W) τ) ws y =
      (dirSpatialJet (V' τ) ws y + ((ws.length : ℝ) / 2) • dirSpatialJet (V τ) ws y) -
        (dirSpatialJet (W' τ) ws y + ((ws.length : ℝ) / 2) • dirSpatialJet (W τ) ws y) := by
    rw [Pi.sub_apply, Pi.sub_apply, HigherPhaseSub.dirSpatialJet_sub (hV' τ) (hW' τ) ws,
      HigherPhaseSub.dirSpatialJet_sub (hV τ) (hW τ) ws, Pi.sub_apply, Pi.sub_apply, smul_sub]
    abel
  rw [hfun, hval]
  exact h

theorem hasComovingJetDeriv_sum {ι : Type*} (s : Finset ι) {F F' : ι → ℝ → SpatialField}
    (hF : ∀ i ∈ s, ∀ τ, ContDiff ℝ ∞ (F i τ)) (hF' : ∀ i ∈ s, ∀ τ, ContDiff ℝ ∞ (F' i τ))
    (dF : ∀ i ∈ s, HasComovingJetDeriv (F i) (F' i)) :
    HasComovingJetDeriv (fun τ y => ∑ i ∈ s, F i τ y) (fun τ y => ∑ i ∈ s, F' i τ y) := by
  intro ws τ y
  have h := HasDerivAt.sum (u := s) (fun i hi => dF i hi ws τ y)
  have hfun : (fun t : ℝ => dirSpatialJet ((fun τ y => ∑ i ∈ s, F i τ y) (τ + t)) ws
      (Real.exp (-t / 2) • y)) =
      fun t => ∑ i ∈ s, dirSpatialJet (F i (τ + t)) ws (Real.exp (-t / 2) • y) := by
    funext t
    exact congrFun (HigherPhaseSub.dirSpatialJet_sum s (fun i hi => hF i hi (τ + t)) ws) _
  have hval : dirSpatialJet ((fun τ y => ∑ i ∈ s, F' i τ y) τ) ws y +
      ((ws.length : ℝ) / 2) • dirSpatialJet ((fun τ y => ∑ i ∈ s, F i τ y) τ) ws y =
      ∑ i ∈ s, (dirSpatialJet (F' i τ) ws y +
        ((ws.length : ℝ) / 2) • dirSpatialJet (F i τ) ws y) := by
    rw [congrFun (HigherPhaseSub.dirSpatialJet_sum s (fun i hi => hF' i hi τ) ws) y,
      congrFun (HigherPhaseSub.dirSpatialJet_sum s (fun i hi => hF i hi τ) ws) y,
      Finset.smul_sum, ← Finset.sum_add_distrib]
  rw [hfun, hval]
  have hs : (fun t : ℝ => ∑ i ∈ s, dirSpatialJet (F i (τ + t)) ws (Real.exp (-t / 2) • y)) =
      ∑ i ∈ s, fun t : ℝ => dirSpatialJet (F i (τ + t)) ws (Real.exp (-t / 2) • y) := by
    funext t; simp [Finset.sum_apply]
  rw [hs]
  exact h

/-! ## 4. The order-`n` comoving class and the tower -/

/-- `ComovingOrder n V`: `V` and its comoving derivatives through order `n` lie in
`IsUniformSmoothL4SliceFamily`. -/
def ComovingOrder : ℕ → (ℝ → SpatialField) → Prop
  | 0, V => IsUniformSmoothL4SliceFamily V
  | n + 1, V => IsUniformSmoothL4SliceFamily V ∧
      ∃ V' : ℝ → SpatialField, HasComovingJetDeriv V V' ∧ ComovingOrder n V'

theorem ComovingOrder.family {n : ℕ} {V : ℝ → SpatialField} (h : ComovingOrder n V) :
    IsUniformSmoothL4SliceFamily V := by
  cases n with
  | zero => exact h
  | succ n => exact h.1

theorem ComovingOrder.smooth {n : ℕ} {V : ℝ → SpatialField} (h : ComovingOrder n V) (τ : ℝ) :
    ContDiff ℝ ∞ (V τ) :=
  HigherPhaseSub.sliceFamily_contDiff_infty h.family τ

theorem ComovingOrder.mono : ∀ {n : ℕ} {V : ℝ → SpatialField}, ComovingOrder (n + 1) V → ComovingOrder n V
  | 0, _, h => h.1
  | n + 1, _, h => by
      obtain ⟨hV, V', dV, hV'⟩ := h
      exact ⟨hV, V', dV, ComovingOrder.mono hV'⟩

theorem ComovingOrder.add : ∀ {n : ℕ} {V W : ℝ → SpatialField}, ComovingOrder n V → ComovingOrder n W → ComovingOrder n (V + W)
  | 0, _, _, hV, hW => HigherPhaseSub.sliceFamily_add hV hW
  | n + 1, _, _, hV, hW => by
      obtain ⟨hV0, V', dV, hV'⟩ := hV
      obtain ⟨hW0, W', dW, hW'⟩ := hW
      exact ⟨HigherPhaseSub.sliceFamily_add hV0 hW0, V' + W',
        hasComovingJetDeriv_add (HigherPhaseSub.sliceFamily_contDiff_infty hV0) hV'.smooth
          (HigherPhaseSub.sliceFamily_contDiff_infty hW0) hW'.smooth dV dW,
        ComovingOrder.add hV' hW'⟩

theorem ComovingOrder.sub : ∀ {n : ℕ} {V W : ℝ → SpatialField}, ComovingOrder n V → ComovingOrder n W → ComovingOrder n (V - W)
  | 0, _, _, hV, hW => HigherPhaseSub.sliceFamily_sub hV hW
  | n + 1, _, _, hV, hW => by
      obtain ⟨hV0, V', dV, hV'⟩ := hV
      obtain ⟨hW0, W', dW, hW'⟩ := hW
      exact ⟨HigherPhaseSub.sliceFamily_sub hV0 hW0, V' - W',
        hasComovingJetDeriv_sub (HigherPhaseSub.sliceFamily_contDiff_infty hV0) hV'.smooth
          (HigherPhaseSub.sliceFamily_contDiff_infty hW0) hW'.smooth dV dW,
        ComovingOrder.sub hV' hW'⟩

theorem ComovingOrder.smul (c : ℝ) : ∀ {n : ℕ} {V : ℝ → SpatialField}, ComovingOrder n V → ComovingOrder n (c • V)
  | 0, _, hV => HigherPhaseSub.sliceFamily_smul c hV
  | n + 1, _, hV => by
      obtain ⟨hV0, V', dV, hV'⟩ := hV
      exact ⟨HigherPhaseSub.sliceFamily_smul c hV0, c • V',
        hasComovingJetDeriv_smul c (HigherPhaseSub.sliceFamily_contDiff_infty hV0) hV'.smooth dV,
        ComovingOrder.smul c hV'⟩

theorem ComovingOrder.laplacian (hLap : ComovingLaplacianRule) :
    ∀ {n : ℕ} {V : ℝ → SpatialField}, ComovingOrder n V → ComovingOrder n (fun τ => spatialLaplacian (V τ))
  | 0, _, hV => HigherPhaseSub.sliceFamily_spatialLaplacian hV
  | n + 1, V, hV => by
      have hVn : ComovingOrder n V := ComovingOrder.mono hV
      obtain ⟨hV0, V', dV, hV'⟩ := hV
      exact ⟨HigherPhaseSub.sliceFamily_spatialLaplacian hV0, _,
        hLap V V' (HigherPhaseSub.sliceFamily_contDiff_infty hV0) hV'.smooth dV,
        ComovingOrder.add (ComovingOrder.laplacian hLap hV') (ComovingOrder.laplacian hLap hVn)⟩

theorem ComovingOrder.convect (hConv : ComovingConvectRule) :
    ∀ {n : ℕ} {V W : ℝ → SpatialField}, ComovingOrder n V → ComovingOrder n W →
      ComovingOrder n (fun τ => spatialConvect (V τ) (W τ))
  | 0, _, _, hV, hW => HigherPhaseSub.sliceFamily_spatialConvect hV hW
  | n + 1, V, W, hV, hW => by
      have hVn : ComovingOrder n V := ComovingOrder.mono hV
      have hWn : ComovingOrder n W := ComovingOrder.mono hW
      obtain ⟨hV0, V', dV, hV'⟩ := hV
      obtain ⟨hW0, W', dW, hW'⟩ := hW
      exact ⟨HigherPhaseSub.sliceFamily_spatialConvect hV0 hW0, _,
        hConv V V' W W' (HigherPhaseSub.sliceFamily_contDiff_infty hV0) hV'.smooth
          (HigherPhaseSub.sliceFamily_contDiff_infty hW0) hW'.smooth dV dW,
        ComovingOrder.add (ComovingOrder.add (ComovingOrder.convect hConv hV' hWn) (ComovingOrder.convect hConv hVn hW'))
          (ComovingOrder.smul (1 / 2 : ℝ) (ComovingOrder.convect hConv hVn hWn))⟩

theorem ComovingOrder.leray (hLeray : SmoothLeraySliceRegularity) (hComm : SmoothLerayComovingComm) :
    ∀ {n : ℕ} {F : ℝ → SpatialField}, ComovingOrder n F → ComovingOrder n (smoothLeraySlice F)
  | 0, F, hF => (hLeray.1 F hF).2
  | n + 1, F, hF => by
      obtain ⟨hF0, F', dF, hF'⟩ := hF
      exact ⟨(hLeray.1 F hF0).2, smoothLeraySlice F', hComm F F' hF0 hF'.family dF,
        ComovingOrder.leray hLeray hComm hF'⟩

theorem ComovingOrder.rhs (hLeray : SmoothLeraySliceRegularity) (hComm : SmoothLerayComovingComm)
    (hLap : ComovingLaplacianRule) (hConv : ComovingConvectRule) (ν : ℝ)
    {n : ℕ} {V : ℝ → SpatialField} (hV : ComovingOrder n V) : ComovingOrder n (comovingEvolRHS ν V) :=
  ComovingOrder.sub (ComovingOrder.add (ComovingOrder.smul ν (ComovingOrder.laplacian hLap hV)) (ComovingOrder.smul (1 / 2 : ℝ) hV))
    (ComovingOrder.leray hLeray hComm (ComovingOrder.convect hConv hV hV))

theorem order_of_evol (hLeray : SmoothLeraySliceRegularity) (hComm : SmoothLerayComovingComm)
    (hLap : ComovingLaplacianRule) (hConv : ComovingConvectRule) (ν : ℝ)
    {V : ℝ → SpatialField} (hV : IsUniformSmoothL4SliceFamily V)
    (hEvol : HasComovingJetDeriv V (comovingEvolRHS ν V)) : ∀ n : ℕ, ComovingOrder n V
  | 0 => hV
  | n + 1 => ⟨hV, comovingEvolRHS ν V, hEvol,
      ComovingOrder.rhs hLeray hComm hLap hConv ν (order_of_evol hLeray hComm hLap hConv ν hV hEvol n)⟩

theorem order_comovingDerivOf {V : ℝ → SpatialField} (h : ∀ n, ComovingOrder n V) :
    ∀ n, ComovingOrder n (comovingDerivOf V) := by
  intro n
  obtain ⟨_, V', dV, hV'⟩ := h (n + 1)
  rw [← eq_comovingDerivOf dV]
  exact hV'

theorem order_iterate : ∀ (m : ℕ) {V : ℝ → SpatialField}, (∀ n, ComovingOrder n V) →
    ∀ n, ComovingOrder n (comovingDerivOf^[m] V)
  | 0, _, h => h
  | m + 1, V, h => by
      rw [Function.iterate_succ_apply]
      exact order_iterate m (order_comovingDerivOf h)

theorem hasComovingJetDeriv_iterate {V : ℝ → SpatialField} (h : ∀ n, ComovingOrder n V) (m : ℕ) :
    HasComovingJetDeriv (comovingDerivOf^[m] V) (comovingDerivOf^[m + 1] V) := by
  obtain ⟨_, V', dV, _⟩ := order_iterate m h 1
  rw [Function.iterate_succ_apply', ← eq_comovingDerivOf dV]
  exact dV

/-- **Comoving tower**: if `V ∈ IsUniformSmoothL4SliceFamily` satisfies the comoving projected
evolution `HasComovingJetDeriv V (comovingEvolRHS ν V)`, then `m ↦ comovingDerivOf^[m] V` is a
comoving tower in `IsUniformSmoothL4SliceFamily` starting at `V`, whose first stage is every
comoving derivative `U₁` of `V`. -/
theorem exists_comovingTower (hLeray : SmoothLeraySliceRegularity)
    (hComm : SmoothLerayComovingComm) (hLap : ComovingLaplacianRule)
    (hConv : ComovingConvectRule) (ν : ℝ) {V U₁ : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V)
    (hEvol : HasComovingJetDeriv V (comovingEvolRHS ν V))
    (hU₁ : HasComovingJetDeriv V U₁) :
    ∃ U : ℕ → ℝ → SpatialField, U 0 = V ∧ U 1 = U₁ ∧
      (∀ m : ℕ, IsUniformSmoothL4SliceFamily (U m)) ∧
      ∀ m : ℕ, HasComovingJetDeriv (U m) (U (m + 1)) := by
  have h := order_of_evol hLeray hComm hLap hConv ν hV hEvol
  refine ⟨fun m => comovingDerivOf^[m] V, rfl, ?_, fun m => (order_iterate m h 0),
    fun m => hasComovingJetDeriv_iterate h m⟩
  exact (eq_comovingDerivOf hU₁).symm

/-! ## 5. Splitting `bgField p z = U_raw + E_εα + w` along comoving rays -/

theorem contDiff_comovingPartial {F : ℝ → SpatialField}
    (hF : ContDiff ℝ ∞ (fun x : ℝ × Space => F x.1 x.2)) (τ : ℝ) :
    ContDiff ℝ ∞ (comovingPartial F τ) :=
  (PhaseDerivStepSub.contDiff_slice_phasePartial hF τ).sub
    (show ContDiff ℝ ∞ (fun y => (1 / 2 : ℝ) • spatialRadialDrift (F τ) y) from
      (HigherPhaseSub.contDiff_infty_spatialRadialDrift
        (PhaseDerivStepSub.contDiff_slice_of_joint hF τ)).const_smul _)

/-- If the raw field and the inlet modes are jointly smooth with comoving derivatives
`comovingPartial`, and the correction `p.corr z` has comoving derivative
`R - (T₀U_raw + E_ε T₀α)`, then `bgField p z` has comoving derivative `R`. -/
theorem hasComovingJetDeriv_bgField_of_corr (p : Params) (z : p.Z)
    (hPartial : ∀ F : ℝ → SpatialField, ContDiff ℝ ∞ (fun x : ℝ × Space => F x.1 x.2) →
      HasComovingJetDeriv F (comovingPartial F))
    (hRawCD : ContDiff ℝ ∞ (fun x : ℝ × Space => p.raw x.1 x.2))
    (hInCD : ∀ i : Fin 2, ContDiff ℝ ∞ (fun x : ℝ × Space => p.inlet i x.1 x.2))
    (hBg : ∀ τ, ContDiff ℝ ∞ (bgField p z τ))
    {R : ℝ → SpatialField} (hR : ∀ τ, ContDiff ℝ ∞ (R τ))
    (dCorr : HasComovingJetDeriv (p.corr z)
      (R - (comovingPartial p.raw +
        fun τ y => ∑ i : Fin 2, p.coord z i • comovingPartial (p.inlet i) τ y))) :
    HasComovingJetDeriv (bgField p z) R := by
  set S : ℝ → SpatialField := fun τ y => ∑ i : Fin 2, p.coord z i • p.inlet i τ y with hS
  set S' : ℝ → SpatialField :=
    fun τ y => ∑ i : Fin 2, p.coord z i • comovingPartial (p.inlet i) τ y with hS'
  have hRawSl : ∀ τ, ContDiff ℝ ∞ (p.raw τ) := PhaseDerivStepSub.contDiff_slice_of_joint hRawCD
  have hInSl : ∀ (i : Fin 2) τ, ContDiff ℝ ∞ (p.inlet i τ) := fun i =>
    PhaseDerivStepSub.contDiff_slice_of_joint (hInCD i)
  have hASl : ∀ τ, ContDiff ℝ ∞ (comovingPartial p.raw τ) := contDiff_comovingPartial hRawCD
  have hSSl : ∀ τ, ContDiff ℝ ∞ (S τ) := fun τ =>
    ContDiff.sum fun i _ => (hInSl i τ).const_smul (p.coord z i)
  have hS'Sl : ∀ τ, ContDiff ℝ ∞ (S' τ) := fun τ =>
    ContDiff.sum fun i _ => (contDiff_comovingPartial (hInCD i) τ).const_smul (p.coord z i)
  have hCorrEq : ∀ τ, p.corr z τ = bgField p z τ - p.raw τ - S τ := by
    intro τ
    funext y
    simp only [bgField, hS, Pi.sub_apply]
    abel
  have hCorrSl : ∀ τ, ContDiff ℝ ∞ (p.corr z τ) := fun τ => by
    rw [hCorrEq τ]
    exact ((hBg τ).sub (hRawSl τ)).sub (hSSl τ)
  have dS : HasComovingJetDeriv S S' :=
    hasComovingJetDeriv_sum Finset.univ
      (F := fun i τ y => p.coord z i • p.inlet i τ y)
      (F' := fun i τ y => p.coord z i • comovingPartial (p.inlet i) τ y)
      (fun i _ τ => (hInSl i τ).const_smul (p.coord z i))
      (fun i _ τ => (contDiff_comovingPartial (hInCD i) τ).const_smul (p.coord z i))
      (fun i _ => hasComovingJetDeriv_smul (p.coord z i) (hInSl i)
        (contDiff_comovingPartial (hInCD i)) (hPartial _ (hInCD i)))
  have dRS : HasComovingJetDeriv (p.raw + S) (comovingPartial p.raw + S') :=
    hasComovingJetDeriv_add hRawSl hASl hSSl hS'Sl (hPartial _ hRawCD) dS
  have hWSl : ∀ τ, ContDiff ℝ ∞ ((R - (comovingPartial p.raw + S')) τ) := fun τ =>
    (hR τ).sub ((hASl τ).add (hS'Sl τ))
  have dAll := hasComovingJetDeriv_add (fun τ => (hRawSl τ).add (hSSl τ))
    (fun τ => (hASl τ).add (hS'Sl τ)) hCorrSl hWSl dRS dCorr
  have e1 : bgField p z = p.raw + S + p.corr z := by
    funext τ y
    rfl
  have e2 : comovingPartial p.raw + S' + (R - (comovingPartial p.raw + S')) = R := by
    abel
  rw [e1]
  have e3 : ((fun τ x => comovingPartial p.raw τ x + S' τ x) +
      (R - (comovingPartial p.raw + S'))) = R := by
    funext τ x
    simp [Pi.add_apply, Pi.sub_apply]
  rw [e3] at dAll
  exact dAll

end ComovingTowerSub

/-! ## 6. PDE leaves along comoving rays (`PartII-b:S3/1/1/2/1`, `/1/2`, `/1/3`) -/

/-- **`PartII-b:S3/1/1/2/1/3` (`JointSmoothComovingPartial`)** (SP 2559-2562): a jointly smooth
phase field `F` (such as `p.raw` and `p.inlet i`, `RawJointSmooth`, `InletJointSmooth`) has the
classical comoving derivative `comovingPartial F = ∂_τF - ½(y·∇)F` on every spatial jet:
`HasComovingJetDeriv F (comovingPartial F)` (chain rule along `t ↦ (τ + t, e^{-t/2} y)`, Schwarz
commutation `PhaseDerivStepSub.phasePartial_dirSpatialJet`, and the radial-drift commutator
`PhaseDerivStepSub.dirSpatialJet_spatialRadialDrift`).
Composed by task `PartII-b:S3/1/1/2/1` via `bgComovingFirstEquation_of`. -/
def JointSmoothComovingPartial : Prop :=
  ∀ F : ℝ → SpatialField, ContDiff ℝ ∞ (fun x : ℝ × Space => F x.1 x.2) →
    HasComovingJetDeriv F (comovingPartial F)

/-- **`PartII-b:S3/1/1/2/1/2` (`BgCorrComovingJetDeriv`)** (SP 2519-2523 and 2559-2562: "The
projected equation is $A_0U+\mathbb P(U\cdot\nabla U)=0$ with zero residual. ... On positive
physical-time compact intervals the resulting $C_\tau W^{k,4}$ regularity and the projected
equation give all time derivatives"): under the regime, graph and slice hypotheses of
`BgFirstPhaseDerivStep` (with `p.raw`, `p.inlet i` jointly smooth), the correction
`w = p.corr z` has, along every comoving ray `t ↦ (τ + t, e^{-t/2} y)` and on every spatial jet,
the classical comoving derivative `T₀w = T₀U - T₀U_raw - E_ε T₀α`, where
`T₀U = comovingEvolRHS p.ν (bgField p z) = νΔU + ½U - 𝔓(U·∇U)` is given by the projected equation.
The graph `B0411.D p.period p.ν q0E` supplies `T₀(∂^α w) ∈ Y_q` for every multi-index `α`.
Composed by task `PartII-b:S3/1/1/2/1` via `bgComovingFirstEquation_of`. -/
def BgCorrComovingJetDeriv : Prop :=
  ∀ (Sig : ℝ) (lam : ℂ) (q : Blueprint.Planar.Profile), 0 < Sig →
    Blueprint.Planar.IsGrowingEigenpair lam q →
  ∀ m : ℝ, 0 < m → ∀ dm dp : ℝ, 0 < dm → 2 * m < 3 * dm / 11 →
  ∀ (C₁ : ℝ) (k₁ : ℕ), 0 < C₁ →
    ∃ ν₀ : ℝ, 0 < ν₀ ∧
    ∀ (p : Params) (d : ℝ), BgRegime p d dm dp → p.ν ≤ ν₀ → p.ageCut = Sig → p.mode = q →
      ContDiff ℝ ∞ (fun x : ℝ × Space => p.raw x.1 x.2) →
      (∀ i : Fin 2, ContDiff ℝ ∞ (fun x : ℝ × Space => p.inlet i x.1 x.2)) →
      ∀ z : p.Z, ProjectedEquation p z →
      ‖z‖ ≤ C₁ * (p.ν ^ k₁)⁻¹ * Real.exp (m / p.ν) * p.ε ^ (3 / 11 : ℝ) →
      (∀ k : ℕ, ∃ g : (Fin k → Fin 3) → B0411.D p.period p.ν q0E,
        IsIteratedPhaseGrad p.period q0E k (p.wOf z) (fun α => (g α : Yq p.period q0E))) →
      (∀ k : ℕ, ∃ M : ℝ, ∀ τ : ℝ, ContDiff ℝ k (bgField p z τ) ∧
        (∀ y : Space, ‖iteratedFDeriv ℝ k (p.corr z τ) y‖ ≤ M) ∧
        eLpNorm (fun y => iteratedFDeriv ℝ k (bgField p z τ) y) 4 volume ≤ ENNReal.ofReal M) →
      IsUniformSmoothL4SliceFamily (bgField p z) →
      (Blueprint.IsBoundedBackground p.raw ∧ ∀ τ, IsSolenoidal (p.raw τ)) →
      (∀ i : Fin 2, Blueprint.IsBoundedBackground (p.inlet i) ∧
        ∀ τ, IsSolenoidal (p.inlet i τ)) →
      HasComovingJetDeriv (p.corr z)
        (comovingEvolRHS p.ν (bgField p z) -
          (comovingPartial p.raw +
            fun τ y => ∑ i : Fin 2, p.coord z i • comovingPartial (p.inlet i) τ y))

/-- **`PartII-b:S3/1/1/2/1` (`BgComovingFirstEquation`)** (SP 2519-2523, 2559-2562): under the
regime, graph and slice hypotheses of `BgFirstPhaseDerivStep`, the background `U = bgField p z`
satisfies the projected equation classically along comoving rays:
`HasComovingJetDeriv U (comovingEvolRHS p.ν U)`, i.e. `T₀U = νΔU + ½U - 𝔓(U·∇U)` on every spatial
jet. Composed by task `PartII-b:S3/1/1/2` via `bgFirstPhaseDerivStep_of_comoving` and by task
`PartII-b:S3/1/2` via `bgHigherOrderPhaseDerivTower_of_comoving`. -/
def BgComovingFirstEquation : Prop :=
  ∀ (Sig : ℝ) (lam : ℂ) (q : Blueprint.Planar.Profile), 0 < Sig →
    Blueprint.Planar.IsGrowingEigenpair lam q →
  ∀ m : ℝ, 0 < m → ∀ dm dp : ℝ, 0 < dm → 2 * m < 3 * dm / 11 →
  ∀ (C₁ : ℝ) (k₁ : ℕ), 0 < C₁ →
    ∃ ν₀ : ℝ, 0 < ν₀ ∧
    ∀ (p : Params) (d : ℝ), BgRegime p d dm dp → p.ν ≤ ν₀ → p.ageCut = Sig → p.mode = q →
      ∀ z : p.Z, ProjectedEquation p z →
      ‖z‖ ≤ C₁ * (p.ν ^ k₁)⁻¹ * Real.exp (m / p.ν) * p.ε ^ (3 / 11 : ℝ) →
      (∀ k : ℕ, ∃ g : (Fin k → Fin 3) → B0411.D p.period p.ν q0E,
        IsIteratedPhaseGrad p.period q0E k (p.wOf z) (fun α => (g α : Yq p.period q0E))) →
      (∀ k : ℕ, ∃ M : ℝ, ∀ τ : ℝ, ContDiff ℝ k (bgField p z τ) ∧
        (∀ y : Space, ‖iteratedFDeriv ℝ k (p.corr z τ) y‖ ≤ M) ∧
        eLpNorm (fun y => iteratedFDeriv ℝ k (bgField p z τ) y) 4 volume ≤ ENNReal.ofReal M) →
      IsUniformSmoothL4SliceFamily (bgField p z) →
      (Blueprint.IsBoundedBackground p.raw ∧ ∀ τ, IsSolenoidal (p.raw τ)) →
      (∀ i : Fin 2, Blueprint.IsBoundedBackground (p.inlet i) ∧
        ∀ τ, IsSolenoidal (p.inlet i τ)) →
      HasComovingJetDeriv (bgField p z) (comovingEvolRHS p.ν (bgField p z))

/-! ## 7. Conditional assemblies -/

/-- `comovingEvolRHS ν V` lies in `IsUniformSmoothL4SliceFamily` for `V` in it. -/
theorem sliceFamily_comovingEvolRHS (ν : ℝ) {V : ℝ → SpatialField}
    (hV : IsUniformSmoothL4SliceFamily V) :
    IsUniformSmoothL4SliceFamily (comovingEvolRHS ν V) :=
  HigherPhaseSub.sliceFamily_sub (HigherPhaseSub.sliceFamily_spatialDiffReact ν hV)
    (HigherPhaseSub.sliceFamily_smoothConvectiveLeray smoothLeraySliceRegularity_proof V V hV hV)

/-- Conditional assembly of `BgComovingFirstEquation` (`PartII-b:S3/1/1/2/1`) from
`RawJointSmooth` (`PartII-b:G4/4/1/1/2`, accepted), `JointSmoothComovingPartial`
(`PartII-b:S3/1/1/2/1/3`) and `BgCorrComovingJetDeriv` (`PartII-b:S3/1/1/2/1/2`), with
`inletJointSmooth` (accepted). -/
theorem bgComovingFirstEquation_of (hRawSmooth : RawJointSmooth)
    (hPartial : JointSmoothComovingPartial) (hCorr : BgCorrComovingJetDeriv) :
    BgComovingFirstEquation := by
  intro Sig lam q hSig hlam m hm dm dp hdm h2m C₁ k₁ hC₁
  obtain ⟨ν₁, hν₁, hC⟩ := hCorr Sig lam q hSig hlam m hm dm dp hdm h2m C₁ k₁ hC₁
  obtain ⟨ν₂, hν₂, hRawS⟩ := hRawSmooth Sig lam q hSig hlam dm dp hdm
  obtain ⟨ν₃, hν₃, hInS⟩ := inletJointSmooth Sig lam q hSig hlam dm dp hdm
  refine ⟨min ν₁ (min ν₂ ν₃), lt_min hν₁ (lt_min hν₂ hν₃), ?_⟩
  intro p d hReg hν hAge hMode z hProj hz hGraph hSlice hBg hRaw hInlet
  have hν₁' : p.ν ≤ ν₁ := hν.trans (min_le_left _ _)
  have hν₂' : p.ν ≤ ν₂ := hν.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hν₃' : p.ν ≤ ν₃ := hν.trans ((min_le_right _ _).trans (min_le_right _ _))
  have hRawCD : ContDiff ℝ ∞ (fun x : ℝ × Space => p.raw x.1 x.2) :=
    hRawS p d hReg hν₂' hAge hMode 0
  have hInCD : ∀ i : Fin 2, ContDiff ℝ ∞ (fun x : ℝ × Space => p.inlet i x.1 x.2) :=
    hInS p d hReg hν₃' hAge hMode
  exact ComovingTowerSub.hasComovingJetDeriv_bgField_of_corr p z hPartial hRawCD hInCD
    (HigherPhaseSub.sliceFamily_contDiff_infty hBg)
    (HigherPhaseSub.sliceFamily_contDiff_infty (sliceFamily_comovingEvolRHS p.ν hBg))
    (hC p d hReg hν₁' hAge hMode hRawCD hInCD z hProj hz hGraph hSlice hBg hRaw hInlet)

/-- Conditional assembly of `BgFirstPhaseDerivStep` (`PartII-b:S3/1/1/2`) from
`BgComovingFirstEquation` (`PartII-b:S3/1/1/2/1`): the first comoving derivative is
`U₁ = comovingEvolRHS p.ν (bgField p z)`. -/
theorem bgFirstPhaseDerivStep_of_comoving (hEq : BgComovingFirstEquation) :
    BgFirstPhaseDerivStep := by
  intro Sig lam q hSig hlam m hm dm dp hdm h2m C₁ k₁ hC₁
  obtain ⟨ν₀, hν₀, hE⟩ := hEq Sig lam q hSig hlam m hm dm dp hdm h2m C₁ k₁ hC₁
  refine ⟨ν₀, hν₀, fun p d hReg hν hAge hMode z hProj hz hGraph hSlice hBg hRaw hInlet => ?_⟩
  have hU₁ := sliceFamily_comovingEvolRHS p.ν hBg
  exact ⟨comovingEvolRHS p.ν (bgField p z), hU₁.slice_contDiff, hU₁.l4_bounded,
    hE p d hReg hν hAge hMode z hProj hz hGraph hSlice hBg hRaw hInlet⟩

/-- Conditional assembly of `BgHigherOrderPhaseDerivTower` (`PartII-b:S3/1/2`) from
`SmoothLerayComovingComm` (`PartII-b:S3/1/2/3`), `ComovingLaplacianRule` (`PartII-b:S3/1/2/4`),
`ComovingConvectRule` (`PartII-b:S3/1/2/5`) and `BgComovingFirstEquation`
(`PartII-b:S3/1/1/2/1`), with the accepted `smoothLeraySliceRegularity_proof`
(`PartII-b:S3/1/2/1`). -/
theorem bgHigherOrderPhaseDerivTower_of_comoving (hComm : SmoothLerayComovingComm)
    (hLap : ComovingLaplacianRule) (hConv : ComovingConvectRule)
    (hEq : BgComovingFirstEquation) :
    BgHigherOrderPhaseDerivTower := by
  intro Sig lam q hSig hlam m hm dm dp hdm h2m C₁ k₁ hC₁
  obtain ⟨ν₀, hν₀, hE⟩ := hEq Sig lam q hSig hlam m hm dm dp hdm h2m C₁ k₁ hC₁
  refine ⟨ν₀, hν₀, fun p d hReg hν hAge hMode z hProj hz hGraph hSlice hRaw hInlet hBg U₁ _
    hU₁Deriv => ?_⟩
  exact ComovingTowerSub.exists_comovingTower smoothLeraySliceRegularity_proof hComm hLap hConv
    p.ν hBg (hE p d hReg hν hAge hMode z hProj hz hGraph hSlice hBg hRaw hInlet) hU₁Deriv

end UnforcedLeray.Short.IIb

