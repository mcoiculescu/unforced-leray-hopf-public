import UnforcedLeray.Short.PartIIb.Sub.PartIIb_T22_2_3_1_7.Commute

/-!


Source: `the November 2 reference manuscript` lines 2100-2105.  The class `InP`
generated by `u` under spatial partials, sums and products with jointly smooth coefficients lies in
`SpSmooth` and is closed under the time derivative: `u_σ = νΔu - w·∇u` by the equation,
`(∂_j p)_σ = ∂_j p_σ` by part (a), `(a p)_σ = a_σ p + a p_σ`.  Iterating gives the tower of
successive time derivatives of `u` (`ClassTower`).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set Filter Topology

namespace UnforcedLeray.Short.IIb.BwdRoute.Joint

open CylPDE

/-- **Part (b)**: a spatially smooth solution of the forward equation with a jointly smooth drift
is the head of a tower. -/
def ClassTower : Prop :=
  ∀ (ν T : ℝ) (w : ℝ → Pl → UnforcedLeray.Train.Vec) (u : ℝ → Pl → ℝ), 0 < T →
    ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun z : ℝ × Pl => w z.1 z.2) (Icc 0 T ×ˢ univ) →
    SpSmooth T u → FwdPde ν T w u → ∃ D : ℕ → ℝ → Pl → ℝ, Tower T D ∧ D 0 = u

/-- The class generated by `u` under spatial partials, sums and jointly smooth coefficients. -/
inductive InP (T : ℝ) (u : ℝ → Pl → ℝ) : (ℝ → Pl → ℝ) → Prop
  | base : InP T u u
  | pd (j : Fin 2) {p : ℝ → Pl → ℝ} : InP T u p → InP T u (fun s => B0579.pd j (p s))
  | add {p q : ℝ → Pl → ℝ} : InP T u p → InP T u q → InP T u (fun s x => p s x + q s x)
  | mul {a p : ℝ → Pl → ℝ} : JSmooth T a → InP T u p → InP T u (fun s x => a s x * p s x)

theorem InP.spSmooth {T : ℝ} {u p : ℝ → Pl → ℝ} (hT : 0 < T) (hu : SpSmooth T u)
    (h : InP T u p) : SpSmooth T p := by
  induction h with
  | base => exact hu
  | pd j _ ih => exact spSmooth_pd ih j
  | add _ _ ih1 ih2 => exact spSmooth_add ih1 ih2
  | mul ha _ ih => exact spSmooth_mul hT ha ih

/-- The class is closed under the time derivative once the generator is. -/
theorem InP.timeDeriv {T : ℝ} {u u' p : ℝ → Pl → ℝ} (hT : 0 < T) (hu : SpSmooth T u)
    (hc : InP T u u') (hd : HasTimeDeriv T u u') (h : InP T u p) :
    ∃ p', InP T u p' ∧ HasTimeDeriv T p p' := by
  induction h with
  | base => exact ⟨u', hc, hd⟩
  | pd j hp ih =>
    obtain ⟨p', hp', hdp⟩ := ih
    exact ⟨_, .pd j hp',
      timeSpaceCommute T _ _ hT (hp.spSmooth hT hu) (hp'.spSmooth hT hu) hdp j⟩
  | add _ _ ih1 ih2 =>
    obtain ⟨p', hp', hdp⟩ := ih1
    obtain ⟨q', hq', hdq⟩ := ih2
    exact ⟨_, .add hp' hq', fun s hs x => (hdp s hs x).fun_add (hdq s hs x)⟩
  | mul ha hp ih =>
    obtain ⟨p', hp', hdp⟩ := ih
    exact ⟨_, .add (.mul (ha.dtJ_smooth hT) hp) (.mul ha hp'),
      fun s hs x => (ha.hasTimeDeriv s hs x).fun_mul (hdp s hs x)⟩

/-- **Part (b)** proved. -/
theorem classTower : ClassTower := by
  intro ν T w u hT hw hu hpde
  have hc : InP T u (fun s x =>
      ν * (B0579.pd 0 (B0579.pd 0 (u s)) x + B0579.pd 1 (B0579.pd 1 (u s)) x) +
        (-w s x 0 * B0579.pd 0 (u s) x + -w s x 1 * B0579.pd 1 (u s) x)) :=
    .add (.mul (jSmooth_const T ν) (.add (.pd 0 (.pd 0 .base)) (.pd 1 (.pd 1 .base))))
      (.add (.mul (jSmooth_comp hw 0).neg (.pd 0 .base))
        (.mul (jSmooth_comp hw 1).neg (.pd 1 .base)))
  have hd : HasTimeDeriv T u (fun s x =>
      ν * (B0579.pd 0 (B0579.pd 0 (u s)) x + B0579.pd 1 (B0579.pd 1 (u s)) x) +
        (-w s x 0 * B0579.pd 0 (u s) x + -w s x 1 * B0579.pd 1 (u s) x)) := fun s hs x =>
    (hpde s hs x).congr_deriv (by simp only [lapP]; ring)
  have step : ∀ p : {p // InP T u p}, ∃ q : {p // InP T u p}, HasTimeDeriv T p.1 q.1 := fun p => by
    obtain ⟨p', hp', hdp⟩ := InP.timeDeriv hT hu hc hd p.2
    exact ⟨⟨p', hp'⟩, hdp⟩
  choose next hnext using step
  let seq : ℕ → {p // InP T u p} := fun n => Nat.rec ⟨u, .base⟩ (fun _ p => next p) n
  exact ⟨fun n => (seq n).1, ⟨fun n => (seq n).2.spSmooth hT hu, fun n => hnext (seq n)⟩, rfl⟩

end UnforcedLeray.Short.IIb.BwdRoute.Joint
