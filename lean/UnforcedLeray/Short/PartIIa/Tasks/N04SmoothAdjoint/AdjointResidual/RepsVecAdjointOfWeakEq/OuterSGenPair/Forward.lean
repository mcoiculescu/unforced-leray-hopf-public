import UnforcedLeray.Short.PartIIa.Tasks.N04SmoothAdjoint.AdjointResidual.RepsVecAdjointOfWeakEq.OuterSGenPair.Trans
import UnforcedLeray.Short.PartIIa.Tasks.N04SmoothAdjoint.AdjointResidual.RepsVecAdjointOfWeakEq.OuterSGenPair.Dil
import UnforcedLeray.Short.PartIIa.Tasks.N04SmoothAdjoint.AdjointResidual.RepsVecAdjointOfWeakEq.OuterSGenPair.Heat
import UnforcedLeray.Short.PartIIa.Tasks.N04SmoothAdjoint.AdjointResidual.RepsVecAdjointOfWeakEq.OuterSGenPair.TwoSided
import UnforcedLeray.Short.PartIIIb.NearInst.Link.Pins.Proofs.OuterGen.Transp.Deriv.OdProdRule

/-!
# The forward outer semigroup on `C²` phase tests (helper for `PartII-a:N04/3/3/1`)

Source of record: `the November 2 reference manuscript`,
lines 3343–3352: `S_ε(t) = e^{-t/4} dilN(e^{t/2}) e^{νε²(e^t-1)Δ_x} transC t` (`B0223.Sop`) is
generated by `G = νε²Δ_x + x·∇/2 + 1/2 - ∂_τ`.

On a `C²` phase test `ψ` the three factor derivatives at `r = 0` (`transDeriv2`, `dilDeriv2`,
`heatDeriv2`) are glued by the product rule `odProdRule` (uniformly bounded, strongly continuous
families) and the scalar `e^{-r/4}`: `d/dr|_{0+} S(r)Ψ = hΨΔ + ½Ψx + ½Ψ - Ψτ`, `h = νε²`.
`isGenPair_of_rightDeriv` upgrades the right derivative at `0` to `B0223.IsGenPair`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set Filter Topology

namespace UnforcedLeray.Short.PartIIa.OuterSGen

open UnforcedLeray.Short.PartIIIb.NearInst (XC cellFn odProdRule)
open UnforcedLeray.PhaseSpace
open UnforcedLeray.B0223 (PSpace SpaceC)

/-- The forward outer operator `hΔ + x·∇/2 + 1/2 - ∂_τ` on phase functions `ψ(τ, x)`
(source 3343–3352, `h = νε²`). -/
def fwdGen (h : ℝ) (ψ : ℝ × Space → CVec3) : ℝ × Space → CVec3 := fun q =>
  h • lapT ψ q + (1 / 2 : ℝ) • radialT ψ q + (1 / 2 : ℝ) • ψ q - dτ ψ q

section F

variable {P : ℝ} [Fact (0 < P)]

/-- Forward phase translation: `d/dr|₀ transC r Ψ = -Ψτ`. -/
theorem transDerivFwd (ψ : ℝ × Space → CVec3) (hψ : IsPhaseTest2 P ψ) (Ψ Ψτ : XC P)
    (hΨ : (Ψ : PSpace P → SpaceC) =ᵐ[volume] cellFn ψ)
    (hΨτ : (Ψτ : PSpace P → SpaceC) =ᵐ[volume] cellFn (dτ ψ)) :
    HasDerivAt (fun r : ℝ => UnforcedLeray.B0223.transC (E := SpaceC) r Ψ) (-Ψτ) 0 := by
  have h1 := transDeriv2 ψ hψ Ψ Ψτ hΨ hΨτ
  have h2 : HasDerivAt (fun r : ℝ => -r) (-1) 0 := (hasDerivAt_id (0 : ℝ)).neg
  have h3 := h1.scomp_of_eq 0 h2 (by simp)
  have hf : ((fun r : ℝ => UnforcedLeray.B0223.transC (E := SpaceC) (P := P) (-r) Ψ) ∘
      fun r : ℝ => -r) = fun r => UnforcedLeray.B0223.transC (E := SpaceC) r Ψ := by
    funext r
    simp
  rw [hf] at h3
  simpa using h3

/-- Forward normalized dilation: `d/dr|₀ dilN(e^{r/2}) Ψ = ¾Ψ + ½Ψx`. -/
theorem dilDerivFwd (ψ : ℝ × Space → CVec3) (hψ : IsPhaseTest2 P ψ) (Ψ Ψx : XC P)
    (hΨ : (Ψ : PSpace P → SpaceC) =ᵐ[volume] cellFn ψ)
    (hΨx : (Ψx : PSpace P → SpaceC) =ᵐ[volume] cellFn (radialT ψ)) :
    HasDerivAt (fun r : ℝ => UnforcedLeray.B0223.dilN (E := SpaceC) (Real.exp (r / 2)) Ψ)
      (-(-(((3 / 4 : ℝ)) : ℂ) • Ψ - ((1 / 2 : ℝ) : ℂ) • Ψx)) 0 := by
  have h1 := dilDeriv2 ψ hψ Ψ Ψx hΨ hΨx
  have h2 : HasDerivAt (fun r : ℝ => -r) (-1) 0 := (hasDerivAt_id (0 : ℝ)).neg
  have h3 := h1.scomp_of_eq 0 h2 (by simp)
  have hf : ((fun r : ℝ => UnforcedLeray.B0223.dilN (E := SpaceC) (P := P)
      (Real.exp (-r / 2)) Ψ) ∘ fun r : ℝ => -r) =
      fun r => UnforcedLeray.B0223.dilN (E := SpaceC) (Real.exp (r / 2)) Ψ := by
    funext r
    simp
  rw [hf] at h3
  simpa using h3

/-- Heat factor along `θ(r) = h(e^r - 1)`: right derivative `hΨΔ` at `0`. -/
theorem heatDerivFwd (ψ : ℝ × Space → CVec3) (hψ : IsPhaseTest2 P ψ) (Ψ ΨΔ : XC P)
    (hΨ : (Ψ : PSpace P → SpaceC) =ᵐ[volume] cellFn ψ)
    (hΔ : (ΨΔ : PSpace P → SpaceC) =ᵐ[volume] cellFn (lapT ψ)) (h : ℝ) (hh : 0 ≤ h) :
    HasDerivWithinAt (fun r : ℝ => UnforcedLeray.B0223.heatC (E := SpaceC)
      (h * (Real.exp r - 1)) Ψ) ((h : ℂ) • ΨΔ) (Ici 0) 0 := by
  have hg := heatDeriv2 ψ hψ Ψ ΨΔ hΨ hΔ
  have hθ : HasDerivWithinAt (fun r : ℝ => h * (Real.exp r - 1)) (h * Real.exp 0) (Ici 0) 0 :=
    (((Real.hasDerivAt_exp 0).sub_const 1).const_mul h).hasDerivWithinAt
  have hmaps : MapsTo (fun r : ℝ => h * (Real.exp r - 1)) (Ici 0) (Ici 0) := by
    intro r hr
    exact mul_nonneg hh (sub_nonneg.2 (Real.one_le_exp hr))
  have key := hg.scomp_of_eq 0 hθ hmaps (by simp)
  refine key.congr_deriv ?_
  rw [Real.exp_zero, mul_one]
  exact RCLike.real_smul_eq_coe_smul (K := ℂ) h ΨΔ

/-- **Right derivative at `0` of the forward outer semigroup** on a `C²` phase test. -/
theorem sop_rightDeriv (ψ : ℝ × Space → CVec3) (hψ : IsPhaseTest2 P ψ) (Ψ Ψτ Ψx ΨΔ : XC P)
    (hΨ : (Ψ : PSpace P → SpaceC) =ᵐ[volume] cellFn ψ)
    (hΨτ : (Ψτ : PSpace P → SpaceC) =ᵐ[volume] cellFn (dτ ψ))
    (hΨx : (Ψx : PSpace P → SpaceC) =ᵐ[volume] cellFn (radialT ψ))
    (hΔ : (ΨΔ : PSpace P → SpaceC) =ᵐ[volume] cellFn (lapT ψ)) (h : ℝ) (hh : 0 ≤ h) :
    HasDerivWithinAt (fun r : ℝ => UnforcedLeray.B0223.Sop (E := SpaceC) h r Ψ)
      ((h : ℂ) • ΨΔ + ((1 / 2 : ℝ) : ℂ) • Ψx + ((1 / 2 : ℝ) : ℂ) • Ψ - Ψτ) (Ici 0) 0 := by
  have hθ0 : h * (Real.exp 0 - 1) = 0 := by simp
  -- strong continuity of the heat factor within `[0, ∞)` at `0`
  have hcontH : ∀ y : XC P,
      ContinuousWithinAt (fun r : ℝ => UnforcedLeray.B0223.heatC (E := SpaceC)
        (h * (Real.exp r - 1)) y) (Ici 0) 0 := by
    intro y
    have hg : ContinuousWithinAt (fun θ : ℝ => UnforcedLeray.B0223.heatC (E := SpaceC) θ y)
        (Ici 0) (h * (Real.exp 0 - 1)) :=
      UnforcedLeray.B0223.heatC_continuousOn y _ (by simp)
    have hf : Continuous (fun r : ℝ => h * (Real.exp r - 1)) := by fun_prop
    have hmaps : MapsTo (fun r : ℝ => h * (Real.exp r - 1)) (Ici 0) (Ici 0) := by
      intro r hr
      exact mul_nonneg hh (sub_nonneg.2 (Real.one_le_exp hr))
    exact ContinuousWithinAt.comp (x := (0 : ℝ)) (f := fun r : ℝ => h * (Real.exp r - 1))
      hg hf.continuousWithinAt hmaps
  -- strong continuity of the dilation factor
  have hcontD : ∀ y : XC P,
      ContinuousWithinAt (fun r : ℝ => UnforcedLeray.B0223.dilN (E := SpaceC)
        (Real.exp (r / 2)) y) (Ici 0) 0 := by
    intro y
    have ha : Tendsto (fun r : ℝ => Real.exp (r / 2)) (𝓝[Ici 0] (0 : ℝ)) (𝓝 1) := by
      have hc : Continuous (fun r : ℝ => Real.exp (r / 2)) := by fun_prop
      have := (hc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ici (0 : ℝ)))
      simpa using this
    have hpos : ∀ᶠ r in 𝓝[Ici 0] (0 : ℝ), 0 < Real.exp (r / 2) :=
      Eventually.of_forall fun r => Real.exp_pos _
    have key := UnforcedLeray.B0223.tendsto_dilN_at one_pos ha hpos y
    rw [UnforcedLeray.B0223.dilN_one] at key
    simp only [ContinuousWithinAt, zero_div, Real.exp_zero, UnforcedLeray.B0223.dilN_one]
    exact key
  -- Step A: `r ↦ heatC(θ r)(transC r Ψ)`
  have hHD : HasDerivWithinAt (fun r : ℝ => UnforcedLeray.B0223.heatC (E := SpaceC)
      (h * (Real.exp r - 1)) (UnforcedLeray.B0223.transC (E := SpaceC) 0 Ψ))
      ((h : ℂ) • ΨΔ) (Ici 0) 0 := by
    rw [UnforcedLeray.B0223.transC_zero]
    exact heatDerivFwd ψ hψ Ψ ΨΔ hΨ hΔ h hh
  have hA := odProdRule (Ici 0) 1
    (fun r : ℝ => UnforcedLeray.B0223.heatC (E := SpaceC) (P := P) (h * (Real.exp r - 1)))
    (fun r : ℝ => UnforcedLeray.B0223.transC (E := SpaceC) r Ψ)
    ((h : ℂ) • ΨΔ) (-Ψτ)
    (fun r _ => UnforcedLeray.B0223.norm_heatC_le _) hcontH hHD
    (transDerivFwd ψ hψ Ψ Ψτ hΨ hΨτ).hasDerivWithinAt
  simp only [Real.exp_zero, sub_self, mul_zero] at hA
  rw [UnforcedLeray.B0223.heatC_of_nonpos le_rfl] at hA
  -- Step B: the dilation in front
  have hx0 : UnforcedLeray.B0223.heatC (E := SpaceC) (h * (Real.exp 0 - 1))
      (UnforcedLeray.B0223.transC (E := SpaceC) 0 Ψ) = Ψ := by
    rw [hθ0, UnforcedLeray.B0223.heatC_of_nonpos le_rfl, UnforcedLeray.B0223.transC_zero]
  have hDD : HasDerivWithinAt (fun r : ℝ => UnforcedLeray.B0223.dilN (E := SpaceC)
      (Real.exp (r / 2)) (UnforcedLeray.B0223.heatC (E := SpaceC) (h * (Real.exp 0 - 1))
        (UnforcedLeray.B0223.transC (E := SpaceC) 0 Ψ)))
      (-(-(((3 / 4 : ℝ)) : ℂ) • Ψ - ((1 / 2 : ℝ) : ℂ) • Ψx)) (Ici 0) 0 := by
    rw [hx0]
    exact (dilDerivFwd ψ hψ Ψ Ψx hΨ hΨx).hasDerivWithinAt
  have hB := odProdRule (Ici 0) 1
    (fun r : ℝ => UnforcedLeray.B0223.dilN (E := SpaceC) (P := P) (Real.exp (r / 2)))
    (fun r : ℝ => UnforcedLeray.B0223.heatC (E := SpaceC) (h * (Real.exp r - 1))
      (UnforcedLeray.B0223.transC (E := SpaceC) r Ψ))
    (-(-(((3 / 4 : ℝ)) : ℂ) • Ψ - ((1 / 2 : ℝ) : ℂ) • Ψx)) ((h : ℂ) • ΨΔ + -Ψτ)
    (fun r _ => UnforcedLeray.B0223.norm_dilN_le _) hcontD hDD hA
  simp only [zero_div, Real.exp_zero, UnforcedLeray.B0223.dilN_one] at hB
  -- Step C: the scalar `e^{-r/4}`
  have hE : HasDerivAt (fun r : ℝ => Real.exp (-r / 4)) (-(1 / 4 : ℝ)) 0 := by
    have h1 : HasDerivAt (fun r : ℝ => -r / 4) (-(1 / 4 : ℝ)) 0 :=
      ((hasDerivAt_id (0 : ℝ)).neg.div_const 4).congr_deriv (by norm_num)
    simpa using h1.exp
  have hEc : HasDerivAt (fun r : ℝ => ((Real.exp (-r / 4) : ℝ) : ℂ))
      ((-(1 / 4 : ℝ) : ℝ) : ℂ) 0 :=
    hE.ofReal_comp
  have hS := HasDerivWithinAt.smul hEc.hasDerivWithinAt hB
  have hfun : (fun r : ℝ => UnforcedLeray.B0223.Sop (E := SpaceC) (P := P) h r Ψ) =
      fun y : ℝ => ((Real.exp (-y / 4) : ℝ) : ℂ) •
        UnforcedLeray.B0223.dilN (E := SpaceC) (Real.exp (y / 2))
          (UnforcedLeray.B0223.heatC (E := SpaceC) (h * (Real.exp y - 1))
            (UnforcedLeray.B0223.transC (E := SpaceC) y Ψ)) := by
    funext r
    rw [UnforcedLeray.B0223.Sop_apply]
  rw [hfun]
  refine HasDerivWithinAt.congr_deriv hS ?_
  have hf0 : UnforcedLeray.B0223.dilN (E := SpaceC) (P := P) (Real.exp (0 / 2))
      (UnforcedLeray.B0223.heatC (E := SpaceC) (h * (Real.exp 0 - 1))
        (UnforcedLeray.B0223.transC (E := SpaceC) 0 Ψ)) = Ψ := by
    rw [hx0, zero_div, Real.exp_zero, UnforcedLeray.B0223.dilN_one]
  simp only [hf0]
  simp only [neg_zero, zero_div, Real.exp_zero, Complex.ofReal_one, one_smul]
  push_cast
  module

/-- The derivative identity of the representatives. -/
theorem fwdGen_rep (ψ : ℝ × Space → CVec3) (h : ℝ) (Ψ Ψτ Ψx ΨΔ Ψ' : XC P)
    (hΨ : (Ψ : PSpace P → SpaceC) =ᵐ[volume] cellFn ψ)
    (hΨτ : (Ψτ : PSpace P → SpaceC) =ᵐ[volume] cellFn (dτ ψ))
    (hΨx : (Ψx : PSpace P → SpaceC) =ᵐ[volume] cellFn (radialT ψ))
    (hΔ : (ΨΔ : PSpace P → SpaceC) =ᵐ[volume] cellFn (lapT ψ))
    (hΨ' : (Ψ' : PSpace P → SpaceC) =ᵐ[volume] cellFn (fwdGen h ψ)) :
    Ψ' = (h : ℂ) • ΨΔ + ((1 / 2 : ℝ) : ℂ) • Ψx + ((1 / 2 : ℝ) : ℂ) • Ψ - Ψτ := by
  apply Lp.ext
  filter_upwards [hΨ', Lp.coeFn_sub ((h : ℂ) • ΨΔ + ((1 / 2 : ℝ) : ℂ) • Ψx +
      ((1 / 2 : ℝ) : ℂ) • Ψ) Ψτ,
    Lp.coeFn_add ((h : ℂ) • ΨΔ + ((1 / 2 : ℝ) : ℂ) • Ψx) (((1 / 2 : ℝ) : ℂ) • Ψ),
    Lp.coeFn_add ((h : ℂ) • ΨΔ) (((1 / 2 : ℝ) : ℂ) • Ψx),
    Lp.coeFn_smul (h : ℂ) ΨΔ, Lp.coeFn_smul ((1 / 2 : ℝ) : ℂ) Ψx,
    Lp.coeFn_smul ((1 / 2 : ℝ) : ℂ) Ψ, hΨ, hΨτ, hΨx, hΔ] with
    z e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10
  rw [e0, e1, Pi.sub_apply, e2, Pi.add_apply, e3, Pi.add_apply, e4, e5, e6, Pi.smul_apply,
    Pi.smul_apply, Pi.smul_apply, e7, e8, e9, e10]
  simp only [cellFn, fwdGen, Complex.coe_smul]

/-- **Generator pairs of the outer semigroup on `C²` phase tests**: `(ψ, fwdGen (νε²) ψ)`. -/
theorem isGenPair_phaseTest2 {ν : ℝ} (hν : 0 < ν) (ε : ℝ) (ψ : ℝ × Space → CVec3)
    (hψ : IsPhaseTest2 P ψ) (Ψ Ψ' : XC P)
    (hΨ : (Ψ : PSpace P → SpaceC) =ᵐ[volume] cellFn ψ)
    (hΨ' : (Ψ' : PSpace P → SpaceC) =ᵐ[volume] cellFn (fwdGen (ν * ε ^ 2) ψ)) :
    UnforcedLeray.B0223.IsGenPair (UnforcedLeray.B0223.outerS (E := SpaceC) (P := P) hν ε)
      Ψ Ψ' := by
  obtain ⟨Ψτ, hΨτ⟩ := exists_rep (P := P) (dτ ψ) hψ.continuous_dτ hψ.dτ_periodic hψ.dτ_support
  obtain ⟨Ψx, hΨx⟩ := exists_rep (P := P) (radialT ψ) hψ.continuous_radialT
    hψ.radialT_periodic hψ.radialT_support
  obtain ⟨ΨΔ, hΔ⟩ := exists_rep (P := P) (lapT ψ) hψ.continuous_lapT hψ.lapT_periodic
    hψ.lapT_support
  have hh : 0 ≤ ν * ε ^ 2 := by positivity
  rw [fwdGen_rep ψ (ν * ε ^ 2) Ψ Ψτ Ψx ΨΔ Ψ' hΨ hΨτ hΨx hΔ hΨ']
  refine isGenPair_of_rightDeriv _ (fun s hs => ?_) ?_
  · refine (UnforcedLeray.B0223.norm_S_le hν ε s).trans ?_
    exact Real.exp_le_one_iff.2 (by linarith)
  · exact sop_rightDeriv ψ hψ Ψ Ψτ Ψx ΨΔ hΨ hΨτ hΨx hΔ (ν * ε ^ 2) hh

end F

end UnforcedLeray.Short.PartIIa.OuterSGen
